---
import fs from 'node:fs';
import path from 'node:path';

const filePath = path.resolve('src/data/berber-siparis.html');
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const safeSiteKey = turnstileSiteKey.replace(/[^a-zA-Z0-9_-]/g, '');
const html = fs.readFileSync(filePath, 'utf-8').replace('__TURNSTILE_SITE_KEY__', safeSiteKey);

return new Response(html, {
  status: 200,
  headers: { 'Content-Type': 'text/html; charset=utf-8' },
});
---
