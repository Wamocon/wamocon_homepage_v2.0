---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SystemePage from '../../components/sections/SystemePage.astro';
import { systeme, systemeServiceSchema } from '../../data/systeme';

const lang = 'kk' as const;
const serviceSchema = systemeServiceSchema(lang, 'https://www.wamocon.com/kk/kasiporyn-juieleri/');
---

<BaseLayout
  title={systeme.seo.title[lang]}
  description={systeme.seo.description[lang]}
  lang={lang}
  schema={[serviceSchema]}
  breadcrumbs={[{ name: 'Кәсіпорын жүйелері', path: '/kk/kasiporyn-juieleri/' }]}>
  <SystemePage lang={lang} />
</BaseLayout>
