---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';

const lang = 'kk' as const;
---

<BaseLayout title="Рақмет | WAMOCON GmbH" description="Хабарыңыз үшін рақмет." lang={lang} noindex>
  <section class="section thanks">
    <div class="container thanks__inner">
      <span class="eyebrow" data-reveal="up">WAMOCON</span>
      <h1 data-reveal="up" data-reveal-delay="60">Рақмет!</h1>
      <p class="text-muted" data-reveal="up" data-reveal-delay="120">
        Хабарыңыз бізге жетті. Жақын арада, әдетте 48 сағат ішінде жауап қайтарамыз.
      </p>
      <div data-reveal="up" data-reveal-delay="180">
        <Button href="/kk/" variant="primary" size="lg">Басты бетке оралу</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks {
    min-height: 60vh;
    display: grid;
    place-items: center;
    text-align: center;
  }
  .thanks__inner {
    max-width: 640px;
  }
  .thanks h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    margin-bottom: 1.25rem;
  }
  .thanks p {
    margin-bottom: 2rem;
    font-size: 1.15rem;
  }
</style>
