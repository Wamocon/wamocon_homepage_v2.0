---
/**
 * Base layout used by every page.
 * Handles <head> (SEO, fonts, favicons), the header, footer, cookie banner
 * and the global scroll-reveal animation observer.
 *
 * Props:
 *  - title, description: per-page SEO
 *  - lang: 'de' | 'en' | 'tr' | 'kk'
 *  - image: optional OG image path
 */
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CookieBanner from '../components/layout/CookieBanner.astro';
import ChatWidget from '../components/ui/ChatWidget.astro';
import { getLangUrls, homeHref } from '../i18n/utils';
import { company, langCodes, type Lang } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  image?: string;
  noindex?: boolean;
  /** Extra JSON-LD nodes (e.g. Service, FAQPage) merged into the page @graph. */
  schema?: Record<string, unknown>[];
  /** Breadcrumb trail, excluding Home which is prepended automatically. */
  breadcrumbs?: { name: string; path: string }[];
}

const {
  title,
  description,
  lang,
  image = '/images/hero-render.png',
  noindex = false,
  schema = [],
  breadcrumbs = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

// The assistant only renders once a reachable model endpoint is configured.
// Without AI_BASE_URL the widget would appear and every question would fail, so
// it stays hidden until the deployment can actually reach the AI.
const chatEnabled = Boolean(import.meta.env.AI_BASE_URL || process.env.AI_BASE_URL);

/**
 * Validation / error copy for the shared lead-form script below. Keyed by the
 * `lang` hidden field each form submits, so a form always speaks its own page's
 * language regardless of which layout instance rendered it.
 */
const formMessages = {
  de: {
    contactRequired: 'Bitte geben Sie eine E-Mail-Adresse oder Telefonnummer an.',
    captcha: 'Bitte bestätigen Sie die Sicherheitsprüfung.',
    failed:
      'Ihre Anfrage konnte nicht gesendet werden. Bitte versuchen Sie es erneut oder kontaktieren Sie uns per E-Mail.',
    errorCode: 'Fehlercode',
    thankYou: '/danke/',
  },
  en: {
    contactRequired: 'Please provide an email address or phone number.',
    captcha: 'Please complete the security check.',
    failed:
      'Your inquiry could not be sent. Please try again or contact us by email.',
    errorCode: 'Error code',
    thankYou: '/en/thank-you/',
  },
  tr: {
    contactRequired: 'Lütfen bir e-posta adresi veya telefon numarası girin.',
    captcha: 'Lütfen güvenlik doğrulamasını tamamlayın.',
    failed:
      'Talebiniz gönderilemedi. Lütfen tekrar deneyin veya bize e-posta ile ulaşın.',
    errorCode: 'Hata kodu',
    thankYou: '/tr/tesekkurler/',
  },
  kk: {
    contactRequired: 'Электрондық пошта мекенжайын не телефон нөмірін жазыңыз.',
    captcha: 'Қауіпсіздік тексерісінен өтіңіз.',
    failed:
      'Сұрауыңыз жіберілмеді. Қайталап көріңіз немесе бізге электрондық поштамен жазыңыз.',
    errorCode: 'Қате коды',
    thankYou: '/kk/raqmet/',
  },
};

// Every language variant of the current page, for hreflang + og:locale:alternate.
const langUrls = getLangUrls(Astro.url.pathname, lang);
const ogLocales = { de: 'de_DE', en: 'en_GB', tr: 'tr_TR', kk: 'kk_KZ' } as const;
const htmlLocales = { de: 'de-DE', en: 'en-GB', tr: 'tr-TR', kk: 'kk-KZ' } as const;
const alternates = langCodes.map((code) => ({
  code,
  href: new URL(langUrls[code], Astro.site).href,
}));
// German is the default edition, so it carries x-default.
const xDefaultUrl = new URL(langUrls.de, Astro.site).href;
const locale = ogLocales[lang];
const alternateLocales = langCodes.filter((c) => c !== lang).map((c) => ogLocales[c]);
// Single source of truth for the visible byline and schema dateModified.
const lastReviewed = '2026-07-22';
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

/** Per-language strings used inside the JSON-LD graph and the skip link. */
const layoutCopy = {
  de: {
    skip: 'Zum Inhalt springen',
    home: 'Startseite',
    jobTitle: 'Geschäftsführer',
    personDescription:
      'Diplom-Ingenieur und Geschäftsführer der WAMOCON GmbH. Verantwortet seit 2015 Testmanagement- und Qualitätssicherungsprojekte für Konzerne in Deutschland und der EU.',
  },
  en: {
    skip: 'Skip to content',
    home: 'Home',
    jobTitle: 'Managing Director',
    personDescription:
      'Graduate engineer and managing director of WAMOCON GmbH. Has been responsible for enterprise test-management and quality-assurance projects across Germany and the EU since 2015.',
  },
  tr: {
    skip: 'İçeriğe geç',
    home: 'Ana Sayfa',
    jobTitle: 'Genel Müdür',
    personDescription:
      'Diplomalı mühendis ve WAMOCON GmbH’nin genel müdürü. 2015’ten bu yana Almanya ve AB genelinde büyük şirketler için test yönetimi ve kalite güvence projelerinden sorumludur.',
  },
  kk: {
    skip: 'Мазмұнға өту',
    home: 'Басты бет',
    jobTitle: 'Басқарушы директор',
    personDescription:
      'Дипломды инженер, WAMOCON GmbH компаниясының басқарушы директоры. 2015 жылдан бері Германия мен ЕО-дағы ірі компаниялар үшін тестілеуді басқару және сапаны қамтамасыз ету жобаларына жауап береді.',
  },
}[lang];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': 'https://www.wamocon.com/#organization',
      name: company.name,
      legalName: company.name,
      url: 'https://www.wamocon.com/',
      logo: 'https://www.wamocon.com/images/logo-wamocon.png',
      image: 'https://www.wamocon.com/images/contact-office.jpg',
      telephone: company.phone,
      email: company.email,
      vatID: 'DE303792072',
      identifier: 'Amtsgericht Frankfurt am Main, HRB 103893',
      address: {
        '@type': 'PostalAddress',
        streetAddress: company.street,
        postalCode: '65760',
        addressLocality: 'Eschborn',
        addressCountry: 'DE',
      },
      areaServed: ['Germany', 'European Union'],
      openingHoursSpecification: [
        { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '09:00', closes: '18:00' },
        { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '10:00', closes: '14:00' },
      ],
      subOrganization: {
        '@type': ['EducationalOrganization', 'Organization'],
        name: 'WAMOCON Academy GmbH',
        url: 'https://test-it-academy.com/',
      },
      knowsAbout: [
        'Software testing',
        'IT test management',
        'Quality assurance',
        'Test automation',
        'SAP testing',
        'Artificial intelligence in software quality',
      ],
      sameAs: [
        'https://www.youtube.com/@wamocon.testing',
        'https://www.facebook.com/WAMOCON/',
        'https://www.linkedin.com/company/wamocon-gmbh',
        'https://www.instagram.com/wmc_testmanagement/',
        'https://www.kununu.com/de/wamocon/kommentare',
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: company.phone,
        email: company.email,
        contactType: 'customer service',
        availableLanguage: ['German', 'English', 'Turkish'],
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://www.wamocon.com/#website',
      url: 'https://www.wamocon.com/',
      name: 'WAMOCON',
      inLanguage: ['de-DE', 'en-GB', 'tr-TR'],
      publisher: { '@id': 'https://www.wamocon.com/#organization' },
    },
    {
      '@type': 'Person',
      '@id': 'https://www.wamocon.com/#waleri-moretz',
      name: 'Waleri Moretz',
      honorificPrefix: 'Dipl.-Ing.',
      jobTitle: layoutCopy.jobTitle,
      description: layoutCopy.personDescription,
      worksFor: { '@id': 'https://www.wamocon.com/#organization' },
      knowsAbout: ['IT test management', 'Software quality assurance', 'SAP testing', 'Test automation'],
      knowsLanguage: ['de', 'en'],
      url: 'https://www.wamocon.com/',
      sameAs: ['https://test-it-academy.com/#waleri-moretz'],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { name: layoutCopy.home, path: homeHref(lang) },
        ...breadcrumbs,
        ...(!['/', '/en/', '/tr/'].includes(Astro.url.pathname) && breadcrumbs.length === 0
          ? [{ name: title.split('|')[0].trim(), path: Astro.url.pathname }]
          : []),
      ].map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: new URL(item.path, Astro.site).href,
      })),
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
      url: canonical,
      name: title,
      description,
      inLanguage: htmlLocales[lang],
      isPartOf: { '@id': 'https://www.wamocon.com/#website' },
      about: { '@id': 'https://www.wamocon.com/#organization' },
      datePublished: '2026-07-01',
      dateModified: lastReviewed,
      reviewedBy: { '@id': 'https://www.wamocon.com/#waleri-moretz' },
      publisher: { '@id': 'https://www.wamocon.com/#organization' },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: new URL(image, Astro.site).href,
      },
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', '.faq__item h3', '.faq__item > p'],
      },
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content="WAMOCON GmbH" />
    <meta name="theme-color" content="#101010" />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && (
      <>
        {alternates.map((alt) => (
          <link rel="alternate" hreflang={alt.code} href={alt.href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site).href} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="WAMOCON" />
    <meta property="og:locale" content={locale} />
    {alternateLocales.map((alt) => <meta property="og:locale:alternate" content={alt} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site).href} />

    <!-- Favicons (WAMOCON wordmark logo) -->
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>

  <body>
    <a class="skip-link" href="#main">{layoutCopy.skip}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieBanner lang={lang} />
    {chatEnabled && <ChatWidget lang={lang} />}

    <style>
      .skip-link {
        position: absolute;
        left: -999px;
        top: 0;
        z-index: var(--z-modal);
        background: var(--color-accent-surface);
        color: #fff;
        padding: 0.75rem 1.25rem;
        border-radius: 0 0 var(--radius-sm) 0;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>

    <script>
      // Global scroll-reveal: reveals [data-reveal] elements as they enter view.
      // Robust by design — content must never stay invisible if JS/IO misbehaves.
      const reveal = () => {
        const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
        const show = (el: HTMLElement) => {
          const delay = el.dataset.revealDelay;
          if (delay) el.style.transitionDelay = `${delay}ms`;
          el.classList.add('is-visible');
        };

        // Reveal anything already in (or near) the viewport right away.
        const inView = (el: HTMLElement) => {
          const r = el.getBoundingClientRect();
          return r.top < (window.innerHeight || 0) * 1.05 && r.bottom > 0;
        };
        els.forEach((el) => {
          if (inView(el)) show(el);
        });

        if (!('IntersectionObserver' in window)) {
          els.forEach(show);
          return;
        }

        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                show(entry.target as HTMLElement);
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -6% 0px' }
        );
        els.forEach((el) => {
          if (!el.classList.contains('is-visible')) io.observe(el);
        });

        // Failsafe: if anything is still hidden after a short delay
        // (e.g. IO never fires in some browsers), reveal it anyway.
        window.setTimeout(() => {
          els.forEach((el) => {
            if (!el.classList.contains('is-visible')) show(el);
          });
        }, 1200);
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', reveal);
      } else {
        reveal();
      }
    </script>

    <script>
      // Premium interactions: scroll-progress bar, cursor spotlight + subtle 3D
      // tilt on cards, and animated stat counters. All effects degrade
      // gracefully and respect prefers-reduced-motion / touch devices.
      const initPremium = () => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

        // 1) Scroll progress bar
        const bar = document.createElement('div');
        bar.className = 'scroll-progress';
        bar.setAttribute('aria-hidden', 'true');
        document.body.appendChild(bar);
        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            const h = document.documentElement;
            const max = h.scrollHeight - h.clientHeight;
            const p = max > 0 ? h.scrollTop / max : 0;
            bar.style.transform = `scaleX(${p})`;
            ticking = false;
          });
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        // 2) Cards: spotlight glow (+ tilt on precise pointers)
        const cards = Array.from(
          document.querySelectorAll<HTMLElement>(
            '.app-card, .service-card, .why-card, .feature-card'
          )
        );
        cards.forEach((card) => {
          card.classList.add('has-spotlight');
          const glow = document.createElement('span');
          glow.className = 'spotlight';
          glow.setAttribute('aria-hidden', 'true');
          card.appendChild(glow);

          if (!fine || reduce) return;
          card.setAttribute('data-tilt', '');
          const lift = card.classList.contains('app-card') ? -6 : -4;
          let raf = 0;
          const onMove = (e: PointerEvent) => {
            const r = card.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width;
            const py = (e.clientY - r.top) / r.height;
            glow.style.setProperty('--spot-x', `${px * 100}%`);
            glow.style.setProperty('--spot-y', `${py * 100}%`);
            const rx = (0.5 - py) * 6;
            const ry = (px - 0.5) * 6;
            if (raf) cancelAnimationFrame(raf);
            raf = requestAnimationFrame(() => {
              card.style.transform = `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg) translateY(${lift}px)`;
            });
          };
          const onLeave = () => {
            if (raf) cancelAnimationFrame(raf);
            card.style.transform = '';
          };
          card.addEventListener('pointermove', onMove);
          card.addEventListener('pointerleave', onLeave);
        });

        // 3) Animated stat counters (reads existing text — no markup change)
        const counters = Array.from(
          document.querySelectorAll<HTMLElement>('.hero__stat-value, [data-count]')
        );
        const animate = (el: HTMLElement) => {
          const txt = (el.textContent || '').trim();
          const m = txt.match(/^(\D*)(\d[\d.,]*)(.*)$/);
          if (!m) return;
          const target = parseFloat(m[2].replace(/[.,]/g, ''));
          if (!isFinite(target)) return;
          const prefix = m[1];
          const suffix = m[3];
          const dur = 1400;
          const start = performance.now();
          const step = (now: number) => {
            const t = Math.min((now - start) / dur, 1);
            const eased = 1 - Math.pow(1 - t, 3);
            el.textContent = prefix + String(Math.round(target * eased)) + suffix;
            if (t < 1) requestAnimationFrame(step);
            else el.textContent = txt;
          };
          requestAnimationFrame(step);
        };
        if (!reduce && counters.length && 'IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach((en) => {
                if (en.isIntersecting) {
                  animate(en.target as HTMLElement);
                  obs.unobserve(en.target);
                }
              });
            },
            { threshold: 0.4 }
          );
          counters.forEach((c) => io.observe(c));
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPremium);
      } else {
        initPremium();
      }
    </script>

    <script define:vars={{ turnstileSiteKey, formMessages }}>
      // @ts-nocheck
      const isLocalPreview = window.location.hostname === '127.0.0.1' || window.location.hostname === 'localhost';
      // The production key is domain-locked; on localhost use Cloudflare's always-pass
      // test key so the captcha still renders and can be tested.
      const ACTIVE_TURNSTILE_SITE_KEY = isLocalPreview ? '1x00000000000000000000AA' : turnstileSiteKey;
      let activeTurnstileLoader;

      const loadActiveTurnstile = () => {
        if (!ACTIVE_TURNSTILE_SITE_KEY || window.turnstile) return Promise.resolve();
        if (activeTurnstileLoader) return activeTurnstileLoader;
        activeTurnstileLoader = new Promise((resolve, reject) => {
          const script = document.createElement('script');
          script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
          script.async = true;
          script.defer = true;
          script.onload = resolve;
          script.onerror = reject;
          document.head.appendChild(script);
        });
        return activeTurnstileLoader;
      };

      const ensureActiveTurnstile = async (form) => {
        if (!ACTIVE_TURNSTILE_SITE_KEY || form.querySelector('.cf-turnstile')) return;
        await loadActiveTurnstile();
        if (!window.turnstile || form.querySelector('.cf-turnstile')) return;

        const container = document.createElement('div');
        container.className = 'cf-turnstile';
        const hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'cf-turnstile-response';
        const submit = form.querySelector('button[type="submit"]');
        if (submit) submit.before(container, hidden);
        else form.append(container, hidden);

        const widgetId = window.turnstile.render(container, {
          sitekey: ACTIVE_TURNSTILE_SITE_KEY,
          theme: 'dark',
          callback: (token) => { hidden.value = token; },
          'error-callback': () => { hidden.value = ''; },
          'expired-callback': () => { hidden.value = ''; },
        });
        // Kept so this form can reset its own widget; a bare reset() would hit
        // whichever widget on the page was rendered last.
        if (widgetId) container.dataset.widgetId = widgetId;
      };

      // A Turnstile token is single-use: after every attempt the form needs a
      // fresh one before it can be sent again.
      // Never throws: on the success path a hiccup in the Turnstile API must not
      // turn a delivered request into an error message (and a second send).
      const resetTurnstile = (form) => {
        try {
          const box = form.querySelector('.cf-turnstile');
          if (window.turnstile && box) window.turnstile.reset(box.dataset.widgetId || box);
        } catch {}
        const token = form.querySelector('input[name="cf-turnstile-response"]');
        if (token) token.value = '';
      };

      const readToken = (form) => form.querySelector('input[name="cf-turnstile-response"]')?.value || '';

      // The check only starts when the visitor reaches the form and needs a few
      // seconds, longer on a busy computer or when Cloudflare asks for a click.
      // Wait for its token instead of rejecting someone who pressed the button
      // right away (e.g. after a password manager filled in the address).
      const waitForToken = async (form, timeoutMs) => {
        const deadline = Date.now() + timeoutMs;
        while (!readToken(form) && Date.now() < deadline) {
          await new Promise((resolve) => setTimeout(resolve, 200));
        }
        return readToken(form);
      };

      const setupActiveLeadForms = () => {
        document.querySelectorAll('form.js-lead-form').forEach((form) => {
          const startProtection = () => ensureActiveTurnstile(form).catch(() => {});
          form.addEventListener('focusin', startProtection, { once: true });
          form.addEventListener('pointerenter', startProtection, { once: true });

          // Back from the thank-you page: the restored page must not keep the
          // button locked from the request that led there.
          window.addEventListener('pageshow', (event) => {
            if (!event.persisted) return;
            delete form.dataset.sending;
            const button = form.querySelector('button[type="submit"]');
            if (button) button.disabled = false;
          });

          form.addEventListener('submit', async (event) => {
            event.preventDefault();
            if (!form.reportValidity()) return;

            const fd = new FormData(form);
            const language = (fd.get('lang') || 'de').toString();
            const msg = formMessages[language] || formMessages.de;
            const phone = (fd.get('phone') || '').toString().trim();
            const email = (fd.get('email') || '').toString().trim();
            if (!phone && !email) {
              const target = form.querySelector('input[name="email"]') || form.querySelector('input[name="phone"]');
              if (target) {
                target.setCustomValidity(msg.contactRequired);
                target.reportValidity();
                target.addEventListener('input', () => target.setCustomValidity(''), { once: true });
              }
              return;
            }

            // One request at a time: while the form waits for the security check,
            // a second click or Enter must not start a second request.
            if (form.dataset.sending) return;
            form.dataset.sending = 'true';
            const submit = form.querySelector('button[type="submit"]');
            if (submit) submit.disabled = true;
            const release = () => {
              delete form.dataset.sending;
              if (submit) submit.disabled = false;
            };
            // Forms marked data-inline-success (the portfolio PDF popup) show
            // their own confirmation and keep the visitor on the page; they
            // listen for lead:success / lead:error instead.
            const inline = form.hasAttribute('data-inline-success');

            let turnstileToken = '';
            if (ACTIVE_TURNSTILE_SITE_KEY) {
              await ensureActiveTurnstile(form).catch(() => {});
              turnstileToken = await waitForToken(form, 20000);
              if (!turnstileToken) {
                release();
                // Inline forms show the hint in their own error box, no native dialog.
                if (inline) {
                  form.dispatchEvent(new CustomEvent('lead:error', { detail: { message: msg.captcha } }));
                } else {
                  alert(msg.captcha);
                }
                return;
              }
            }

            const payload = {
              type: (fd.get('type') || 'lead').toString(),
              lang: language,
              name: (fd.get('name') || '').toString(),
              phone,
              email,
              comment: (fd.get('comment') || '').toString(),
              source: (fd.get('source') || '').toString(),
              sourceOther: (fd.get('sourceOther') || '').toString(),
              testimonialConsent: fd.get('testimonialConsent') === 'on',
              pdfLang: (fd.get('pdfLang') || '').toString(),
              // Read after the wait above: the FormData snapshot predates the token.
              'cf-turnstile-response': turnstileToken,
            };

            try {
              const response = await fetch('/api/lead', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
              });
              if (!response.ok) {
                // Short code for the error message (e.g. 502-token, 403-invalid-input-secret),
                // so a screenshot of a failed attempt is enough to find the cause.
                let code = String(response.status);
                try {
                  const data = await response.json();
                  if (data && typeof data.code === 'string') code = data.code;
                } catch {}
                throw Object.assign(new Error('Request failed'), { code });
              }
              if (inline) {
                resetTurnstile(form);
                release();
                form.dispatchEvent(new CustomEvent('lead:success', { detail: { email } }));
                return;
              }
              window.location.assign(form.dataset.redirect || msg.thankYou);
            } catch (err) {
              const code = (err && err.code) || 'network';
              if (inline) form.dispatchEvent(new CustomEvent('lead:error', { detail: { code } }));
              else alert(`${msg.failed} (${msg.errorCode}: ${code})`);
              release();
              resetTurnstile(form);
            }
          });
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupActiveLeadForms);
      } else {
        setupActiveLeadForms();
      }
    </script>
  </body>
</html>
