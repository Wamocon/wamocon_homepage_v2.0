---
/**
 * Universum: the WAMOCON portfolio told as a universe.
 *
 * One page, seven scenes: a star field with a warp effect, the governance core
 * as the sun, three orbiting worlds (the business units), constellations for
 * the key figures, an interactive audit ring, a flight path for the first
 * steps, a draggable globe and a timeline. Everything is plain Astro + CSS +
 * a small vanilla script: no new dependencies.
 *
 * Motion respects prefers-reduced-motion (static scenes, no warp, no
 * scroll-linked parallax). Every visual has a text equivalent on the page.
 */
import ContactBlock from './ContactBlock.astro';
import type { Lang } from '../../i18n/config';
import { universeCopy, geo, worldShares, type WorldId } from '../../data/universe';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = universeCopy[lang];

const worldIds: WorldId[] = ['ki', 'sap', 'academy'];
const anchors = ['start', 'sternbilder', 'kern', 'welten', 'einstieg', 'reichweite', 'zeitachse'];

/** Percent in the local convention: "50 %" (de, kk), "50%" (en), "%50" (tr). */
const pct = (n: number) => (lang === 'tr' ? `%${n}` : lang === 'en' ? `${n}%` : `${n} %`);

/* ---------- Hero headline, split into characters for the fly-in ---------- */
let charIndex = 0;
const splitLine = (s: string) =>
  s.split(' ').map((w) => [...w].map((ch) => ({ ch, i: charIndex++ })));
const line1 = splitLine(c.hero.l1);
const line2 = splitLine(c.hero.l2);

/* ---------- Hero orbits ---------- */
const orbits: { id: WorldId; size: number; dur: number; start: number; sz: number }[] = [
  { id: 'ki', size: 54, dur: 26, start: 20, sz: 64 },
  { id: 'sap', size: 76, dur: 40, start: 150, sz: 50 },
  { id: 'academy', size: 97, dur: 58, start: 255, sz: 42 },
];

/* ---------- Geometry for the governance ring (SVG, viewBox centred on 0 0) ---------- */
const rad = (a: number) => (a * Math.PI) / 180;
const pt = (r: number, a: number): [number, number] => [
  Number((r * Math.sin(rad(a))).toFixed(2)),
  Number((-r * Math.cos(rad(a))).toFixed(2)),
];
const arcPath = (r0: number, r1: number, a0: number, a1: number) => {
  const [x1, y1] = pt(r1, a0);
  const [x2, y2] = pt(r1, a1);
  const [x3, y3] = pt(r0, a1);
  const [x4, y4] = pt(r0, a0);
  return `M${x1} ${y1}A${r1} ${r1} 0 0 1 ${x2} ${y2}L${x3} ${y3}A${r0} ${r0} 0 0 0 ${x4} ${y4}Z`;
};
const ring = c.core.segments.map((lines, i) => {
  const planned = i >= 6;
  const mid = i * 45 + 22.5;
  const [lx, ly] = pt(148, mid);
  const all: string[] = planned ? [...lines, `(${c.core.planned})`] : [...lines];
  return {
    i,
    planned,
    mid,
    d: arcPath(112, 184, i * 45 + 1.4, (i + 1) * 45 - 1.4),
    lx,
    ly0: Number((ly - ((all.length - 1) * 12.5) / 2 + 4).toFixed(2)),
    lines: all,
  };
});
const coreDots = Array.from({ length: 13 }, (_, i) => pt(95, (i * 360) / 13));
const agents = [0, 90, 180, 270].map((a) => ({ at: pt(184, a), from: pt(106, a) }));

const shieldPath = 'M0 -38L32 -27V2C32 22 17 33 0 41C-17 33 -32 22 -32 2V-27Z';
const checkPath = 'M-14 1L-4 12L16 -10';
const sealPath = (() => {
  const n = 18;
  let d = '';
  for (let k = 0; k < n * 2; k++) {
    const r = k % 2 ? 19.5 : 23;
    const a = (k * Math.PI) / n;
    d += `${k ? 'L' : 'M'}${(r * Math.sin(a)).toFixed(2)} ${(-r * Math.cos(a)).toFixed(2)}`;
  }
  return `${d}Z`;
})();

/* ---------- Constellations behind the key figures ---------- */
const constellations: [number, number][][] = [
  [[12, 62], [48, 30], [86, 48], [124, 18], [160, 40], [204, 26]],
  [[14, 30], [52, 58], [92, 36], [128, 66], [170, 30], [206, 52]],
  [[10, 50], [44, 20], [80, 58], [118, 34], [156, 64], [208, 22]],
  [[16, 22], [56, 46], [94, 20], [132, 54], [172, 28], [206, 62]],
];

/* ---------- Flight path ---------- */
const routePath = 'M0 120C60 120 100 60 166.7 60S400 100 500 100S760 60 833.3 60S960 110 1000 110';
const routeNodes = [
  { x: 16.67, y: 0.375 },
  { x: 50, y: 0.625 },
  { x: 83.33, y: 0.375 },
];
---

<div class="uni" data-uni>
  <!-- Star field: one sticky canvas behind every scene of the page. -->
  <div class="uni-sky" aria-hidden="true">
    <div class="uni-sky__sticky">
      <div class="uni-sky__nebula uni-sky__nebula--a"></div>
      <div class="uni-sky__nebula uni-sky__nebula--b"></div>
      <canvas class="uni-sky__canvas" data-sky></canvas>
    </div>
  </div>

  <nav class="u-map" aria-label={c.minimap.label} data-map>
    <ol>
      {anchors.map((id, i) => (
        <li>
          <a href={`#${id}`} data-map-link={id}>
            <span class="u-map__label">{c.minimap.items[i]}</span>
            <span class="u-map__dot" aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <!-- ============ 1. HERO: the sun and its worlds ============ -->
  <section class="u-hero" id="start" data-hero data-track>
    <div class="container u-hero__grid">
      <div class="u-hero__copy">
        <p class="u-hero__eyebrow">{c.hero.eyebrow}</p>
        <h1 class="u-hero__title" aria-label={`${c.hero.l1} ${c.hero.l2}`}>
          <span class="u-hero__line" aria-hidden="true">
            {line1.map((w) => (
              <span class="u-word">{w.map((x) => <span class="u-ch" style={`--i:${x.i}`}>{x.ch}</span>)}</span>
            ))}
          </span>
          <span class="u-hero__line u-hero__line--red" aria-hidden="true">
            {line2.map((w) => (
              <span class="u-word">{w.map((x) => <span class="u-ch" style={`--i:${x.i}`}>{x.ch}</span>)}</span>
            ))}
          </span>
        </h1>
        <p class="u-hero__lead">{c.hero.lead}</p>
        <div class="u-actions u-hero__actions">
          <a class="u-btn u-btn--primary" href="#kontakt">{c.hero.demo}</a>
          <a class="u-btn u-btn--ghost" href="#sternbilder">{c.hero.explore}</a>
        </div>
        <ul class="u-badges">
          {c.badges.map((b, i) => (
            <li class="u-badge" style={`--i:${i}`}>
              <span class="u-seal" aria-hidden="true">
                <svg viewBox="-26 -26 52 52">
                  <path class="u-seal__edge" d={sealPath} />
                  <path class="u-seal__check" d="M-8 0L-2 6L9 -6" />
                </svg>
              </span>
              <span>
                <strong>{b.t}</strong>
                <small>{b.s}</small>
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div class="u-hero__visual">
        <nav class="u-sys" aria-label={c.hero.orbitLabel} data-sys>
          <div class="u-sys__tilt">
            <div class="u-sys__plane">
              <div class="u-belt" aria-hidden="true"></div>
              {orbits.map((o) => (
                <div class="u-orbit" style={`--size:${o.size}%;--dur:${o.dur}s;--start:${o.start}deg`}>
                  <div class="u-orbit__arm">
                    <div class="u-orbit__body">
                      <a class="u-planet" href={`#welt-${o.id}`} style={`--sz:${o.sz}px`}>
                        <span class="orb-wrap" aria-hidden="true">
                          {o.id === 'academy' && <span class="orb__ring orb__ring--back"></span>}
                          <span class={`orb orb--${o.id}`}></span>
                          {o.id === 'academy' && <span class="orb__ring orb__ring--front"></span>}
                        </span>
                        <span class="u-planet__label">
                          <b>{pct(worldShares[o.id])}</b> {c.hero.planets[o.id]}
                        </span>
                      </a>
                    </div>
                  </div>
                </div>
              ))}
              <div class="u-sun" aria-hidden="true">
                <span class="u-sun__glow"></span>
                <svg viewBox="-50 -50 100 100">
                  <path class="u-sun__shield" d={shieldPath} />
                  <path class="u-sun__check" d={checkPath} />
                </svg>
                <span class="u-sun__label">{c.hero.core}</span>
              </div>
            </div>
          </div>
        </nav>
        <p class="u-sys__hint">{c.hero.orbitHint}</p>
      </div>
    </div>
    <span class="u-scroll" aria-hidden="true"><span></span>{c.hero.scroll}</span>
  </section>

  <!-- ============ 2. CONSTELLATIONS: key figures ============ -->
  <section class="u-sec" id="sternbilder" data-track>
    <div class="container">
      <header class="u-head" data-reveal>
        <span class="eyebrow">{c.stats.eyebrow}</span>
        <h2 class="u-h2">{c.stats.title}</h2>
      </header>
      <ul class="u-stats">
        {c.stats.items.map((s, i) => (
          <li class="u-stat" data-in style={`--i:${i}`}>
            <svg class="u-stat__sky" viewBox="0 0 220 84" aria-hidden="true">
              <polyline points={constellations[i].map((p) => p.join(',')).join(' ')} pathLength="1" />
              {constellations[i].map(([x, y], k) => (
                <circle cx={x} cy={y} r={k === 3 ? 3 : 1.9} style={`--k:${k}`} />
              ))}
            </svg>
            <span class="u-stat__v" data-count>{s.v}</span>
            <span class="u-stat__l">{s.l}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 3. THE CORE: built-in governance ============ -->
  <section class="u-sec u-core" id="kern" data-track data-core>
    <div class="container u-core__grid">
      <div class="u-core__copy">
        <span class="eyebrow" data-reveal>{c.core.eyebrow}</span>
        <h2 class="u-h2" data-reveal>{c.core.title}</h2>
        <p class="u-core__sub" data-reveal>{c.core.sub}</p>
        <p class="u-core__lead" data-reveal>{c.core.lead}</p>
        <dl class="u-facts">
          {c.core.facts.map((f, i) => (
            <div class:list={['u-fact', { 'u-fact--human': i === 3 }]} data-reveal data-reveal-delay={i * 80}>
              <dt>{f.v}</dt>
              <dd>{f.l}</dd>
            </div>
          ))}
        </dl>
        <div class="u-live" data-reveal>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" />
          </svg>
          <div>
            <strong>{c.core.liveTitle}</strong>
            <span>{c.core.liveText}</span>
          </div>
        </div>
      </div>

      <div class="u-core__visual">
        <div class="u-ring" data-ring data-state="idle">
          <svg class="u-ring__svg" viewBox="-215 -215 430 430" role="img" aria-label={c.core.ringLabel}>
            <defs>
              <radialGradient id="u-core-grad" cx="40%" cy="35%" r="75%">
                <stop offset="0%" stop-color="#262626" />
                <stop offset="70%" stop-color="#0b0b0b" />
                <stop offset="100%" stop-color="#050505" />
              </radialGradient>
            </defs>
            <circle class="u-ring__halo" r="204" />
            <g>
              {ring.map((s) => (
                <g class:list={['u-seg', { 'u-seg--planned': s.planned }]} data-seg={s.i} data-mid={s.mid} data-planned={s.planned ? '1' : undefined}>
                  <path d={s.d} />
                  <text x={s.lx} y={s.ly0}>
                    {s.lines.map((ln, k) => (
                      <tspan x={s.lx} dy={k === 0 ? 0 : 12.5} class={s.planned && k === s.lines.length - 1 ? 'u-seg__tag' : undefined}>{ln}</tspan>
                    ))}
                  </text>
                </g>
              ))}
            </g>
            <circle class="u-ring__inner" r="104" />
            <g>
              {coreDots.map(([x, y]) => <circle class="u-dot" cx={x} cy={y} r="3.2" />)}
            </g>
            <g data-agents>
              {agents.map((a) => (
                <g class="u-agent">
                  <line class="u-agent__beam" x1={a.from[0]} y1={a.from[1]} x2={a.at[0]} y2={a.at[1]} />
                  <circle cx={a.at[0]} cy={a.at[1]} r="17" />
                  <text x={a.at[0]} y={a.at[1] + 4.5} data-cx={a.at[0]} data-cy={a.at[1]}>{c.core.agent}</text>
                </g>
              ))}
            </g>
            <g transform="translate(0 -24)">
              <path class="u-ring__shield" d={shieldPath} />
              <path class="u-ring__check" d={checkPath} />
            </g>
            <text class="u-ring__score" y="50" data-score>0</text>
            <text class="u-ring__score-l" y="70">{c.core.score}</text>
            <g class="u-ring__stamp">
              <rect x="-80" y="-22" width="160" height="44" rx="8" />
              <text y="7">{c.core.stamp}</text>
            </g>
          </svg>
        </div>
        <div class="u-actions u-ring__controls">
          <button type="button" class="u-btn u-btn--ghost" data-core-start data-restart={c.core.restart}>{c.core.start}</button>
          <button type="button" class="u-btn u-btn--primary" data-core-approve disabled>{c.core.approve}</button>
        </div>
        <p
          class="u-ring__status"
          role="status"
          data-core-status
          data-idle={c.core.status.idle}
          data-scan={c.core.status.scan}
          data-ready={c.core.status.ready}
          data-done={c.core.status.done}
        >
          {c.core.status.idle}
        </p>
        <p class="u-caption">{c.core.caption}</p>
      </div>
    </div>

    <div class="container">
      <div class="u-protect" data-reveal>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17 10V8A5 5 0 0 0 7 8v2H5v12h14V10h-2Zm-8-2a3 3 0 0 1 6 0v2H9V8Zm4 9.7V19h-2v-1.3a2 2 0 1 1 2 0Z" />
        </svg>
        <strong>{c.core.protectTitle}:</strong>
        <ul>
          {c.core.protect.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ 4. THREE WORLDS: the portfolio ============ -->
  <section class="u-sec u-worlds" id="welten" data-track data-worlds>
    <div class="container">
      <header class="u-head" data-reveal>
        <span class="eyebrow">{c.worlds.eyebrow}</span>
        <h2 class="u-h2">{c.worlds.title}</h2>
        <p class="u-head__lead">{c.worlds.lead}</p>
      </header>

      <div class="u-cap" data-in>
        <div class="u-cap__groups" aria-hidden="true">
          <span style="--w:80"><b>WAMOCON GmbH</b>{pct(80)}</span>
          <span style="--w:20" class="is-red"><b>Academy</b>{pct(20)}</span>
        </div>
        <ol class="u-cap__bar" aria-label={c.worlds.capLabel}>
          {worldIds.map((id, i) => (
            <li class={`u-cap__seg u-cap__seg--${id}`} style={`--w:${worldShares[id]};--i:${i}`}>
              <a href={`#welt-${id}`}>
                <b>{pct(worldShares[id])}</b>
                <span>{c.worlds.items[id].title}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>

      <div class="u-worlds__body">
        <div class="u-stage" aria-hidden="true">
          <div class="u-stage__inner">
            {worldIds.map((id, i) => (
              <div class={`u-wp u-wp--${id}`} data-wp={i} style={`--d:${i};--ad:${Math.min(i, 1.6)}`}>
                <div class="u-wp__scene">
                  <div class="u-moons">
                    <div class="u-moons__spin">
                      {c.worlds.items[id].products.map((_, k, all) => (
                        <span class="u-moon" data-moon={k} style={`--a:${(k * 360) / all.length}deg`}>
                          <span class="u-moon__b"></span>
                        </span>
                      ))}
                    </div>
                  </div>
                  <span class="orb-wrap u-wp__orb">
                    {id === 'academy' && <span class="orb__ring orb__ring--back"></span>}
                    <span class={`orb orb--${id}`}></span>
                    {id === 'academy' && <span class="orb__ring orb__ring--front"></span>}
                  </span>
                </div>
              </div>
            ))}
            <ol class="u-stage__dots">
              {worldIds.map((id, i) => (
                <li data-wdot={i} class:list={[{ 'is-active': i === 0 }]}>
                  <span></span>{c.hero.planets[id]}
                </li>
              ))}
            </ol>
          </div>
        </div>

        <div class="u-panels">
          {worldIds.map((id, i) => {
            const w = c.worlds.items[id];
            return (
              <article class:list={['u-panel', { 'is-active': i === 0 }]} id={`welt-${id}`} data-panel={i} data-world={id}>
                <span class="orb-wrap u-panel__orb" aria-hidden="true">
                  {id === 'academy' && <span class="orb__ring orb__ring--back"></span>}
                  <span class={`orb orb--${id}`}></span>
                  {id === 'academy' && <span class="orb__ring orb__ring--front"></span>}
                </span>
                <p class="u-panel__company">{w.company}</p>
                <p class="u-panel__share"><span data-count>{pct(worldShares[id])}</span></p>
                <h3 class="u-panel__title">{w.title}</h3>
                <p class="u-panel__verbs">{w.verbs}</p>
                <ul class="u-chips">
                  {w.products.map((p, k) => <li data-chip={k}>{p}</li>)}
                </ul>
                <div class="u-ref">
                  <span>{c.worlds.refLabel}</span>
                  <p>{w.ref}</p>
                </div>
                {w.link.external ? (
                  <a class="u-link" href={w.link.href} target="_blank" rel="noopener">
                    {w.link.label} <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <a class="u-link" href={w.link.href}>
                    {w.link.label} <span aria-hidden="true">→</span>
                  </a>
                )}
              </article>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 5. FLIGHT PATH: getting started ============ -->
  <section class="u-sec u-route" id="einstieg" data-track data-route>
    <div class="container">
      <header class="u-head" data-reveal>
        <span class="eyebrow">{c.route.eyebrow}</span>
        <h2 class="u-h2">{c.route.title}</h2>
      </header>
      <div class="u-route__track">
        <svg class="u-route__svg" viewBox="0 0 1000 160" preserveAspectRatio="none" aria-hidden="true">
          <path class="u-route__base" d={routePath} pathLength="100" />
          <path class="u-route__fill" d={routePath} pathLength="1" data-route-path />
        </svg>
        <span class="u-route__comet" data-comet aria-hidden="true"></span>
        <span class="u-route__line" aria-hidden="true"><span></span></span>
        <ol class="u-route__steps">
          {c.route.steps.map((s, i) => (
            <li class="u-step" data-step={i} style={`--x:${routeNodes[i].x}%;--yy:${routeNodes[i].y}`}>
              <span class="u-step__node" aria-hidden="true">{i + 1}</span>
              <div class="u-step__card">
                <span class="u-step__k">{c.route.step} {i + 1}</span>
                <h3>{s.t}</h3>
                <p>{s.s}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ 6. REACH: the globe ============ -->
  <section class="u-sec u-globe" id="reichweite" data-track>
    <div class="container u-globe__grid">
      <div class="u-globe__copy">
        <header class="u-head u-head--tight" data-reveal>
          <span class="eyebrow">{c.globe.eyebrow}</span>
          <h2 class="u-h2">{c.globe.title}</h2>
          <p class="u-head__lead">{c.globe.lead}</p>
        </header>
        <ul class="u-countries">
          {c.globe.countries.map((k, i) => (
            <li>
              <button type="button" class="u-country" data-country={i} aria-pressed="false">
                <span class="u-country__code" aria-hidden="true">{geo[i].code}</span>
                <span>
                  <b>{k.n}</b>
                  {k.note && <small>{k.note}</small>}
                </span>
              </button>
            </li>
          ))}
        </ul>
        <p class="u-globe__hint">{c.globe.hint}</p>
      </div>
      <div class="u-globe__visual">
        <canvas
          class="u-globe__canvas"
          data-globe
          data-geo={JSON.stringify(geo)}
          data-map="/data/globe.json"
          role="img"
          aria-label={c.globe.canvasLabel}
        ></canvas>
      </div>
    </div>
  </section>

  <!-- ============ 7. TIMELINE ============ -->
  <section class="u-sec u-time" id="zeitachse" data-track>
    <div class="container">
      <header class="u-head" data-reveal>
        <span class="eyebrow">{c.timeline.eyebrow}</span>
        <h2 class="u-h2">{c.timeline.title}</h2>
      </header>
      <ol class="u-time__list" data-in>
        {c.timeline.items.map((t, i) => (
          <li class="u-time__item" style={`--i:${i}`}>
            <span class="u-time__node" aria-hidden="true"></span>
            <span class="u-time__y">{t.y}</span>
            <p>{t.t}</p>
          </li>
        ))}
      </ol>
      <ul class="u-time__facts">
        {c.timeline.facts.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </section>

  <!-- ============ CTA: the portal ============ -->
  <section class="u-sec u-cta">
    <div class="container">
      <div class="u-portal" data-in>
        <span class="u-portal__ring" aria-hidden="true"></span>
        <span class="u-portal__ring u-portal__ring--2" aria-hidden="true"></span>
        <h2 class="u-h2">{c.cta.title}</h2>
        <p>{c.cta.text}</p>
        <div class="u-actions u-cta__actions">
