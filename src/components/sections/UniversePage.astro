</style>

<script>
  type Frame = () => void;

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

  /* ------------------------------------------------------------------
     Star field: forward drift, mouse parallax, warp streaks that follow
     the scroll speed, and the occasional shooting star.
     ------------------------------------------------------------------ */
  function initSky(root: HTMLElement, reduce: boolean, frames: Frame[]) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-sky]');
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx) return;

    type Star = { x: number; y: number; z: number; tw: number };
    let w = 0;
    let h = 0;
    let white: Star[] = [];
    let red: Star[] = [];
    const spawn = (z = Math.random()): Star => ({
      x: Math.random() * 2 - 1,
      y: Math.random() * 2 - 1,
      z: 0.06 + z * 0.94,
      tw: Math.random() * Math.PI * 2,
    });

    let mx = 0;
    let my = 0;
    let pmx = 0;
    let pmy = 0;
    let warp = 0;
    let lastY = window.scrollY;
    let lastT = performance.now();
    let shoot: { x: number; y: number; vx: number; vy: number; life: number } | null = null;
    let nextShoot = performance.now() + 2500;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(Math.min(950, (w * h) / 1500));
      white = Array.from({ length: Math.round(n * 0.93) }, () => spawn());
      red = Array.from({ length: Math.round(n * 0.07) }, () => spawn());
    };

    const drawSet = (set: Star[], color: string, now: number, dt: number, speed: number, cx: number, cy: number) => {
      ctx.fillStyle = color;
      ctx.strokeStyle = color;
      for (const s of set) {
        s.z -= speed * dt;
        const px = cx + (s.x / s.z) * w * 0.5;
        const py = cy + (s.y / s.z) * h * 0.5;
        if (s.z <= 0.04 || px < -40 || px > w + 40 || py < -40 || py > h + 40) {
          Object.assign(s, spawn(1));
          continue;
        }
        const depth = 1 - s.z;
        const size = depth * 2.3 + 0.35;
        ctx.globalAlpha = Math.min(1, depth * 1.25 + 0.12) * (0.72 + 0.28 * Math.sin(now * 0.002 + s.tw));
        if (warp > 0.05) {
          const tz = s.z + warp * 0.07;
          const tx = cx + (s.x / tz) * w * 0.5;
          const ty = cy + (s.y / tz) * h * 0.5;
          ctx.lineWidth = size;
          ctx.beginPath();
          ctx.moveTo(tx, ty);
          ctx.lineTo(px, py);
          ctx.stroke();
        } else if (size > 1.7) {
          ctx.beginPath();
          ctx.arc(px, py, size * 0.6, 0, Math.PI * 2);
          ctx.fill();
        } else {
          ctx.fillRect(px, py, size, size);
        }
      }
    };

    const draw = (now: number) => {
      const dt = Math.min(now - lastT, 50) / 1000;
      lastT = now;
      const y = window.scrollY;
      const v = Math.abs(y - lastY) / Math.max(dt, 0.001);
      lastY = y;
      if (!reduce) {
        warp += (Math.min(v / 2600, 1.4) - warp) * Math.min(1, dt * 6);
        pmx += (mx - pmx) * Math.min(1, dt * 3);
        pmy += (my - pmy) * Math.min(1, dt * 3);
      }
      ctx.clearRect(0, 0, w, h);
      ctx.lineCap = 'round';
      const cx = w / 2 - pmx * 36;
      const cy = h / 2 - pmy * 36;
      const speed = reduce ? 0 : 0.02 + warp * 0.95;
      drawSet(white, '#ffffff', now, dt, speed, cx, cy);
      drawSet(red, '#ff5252', now, dt, speed, cx, cy);

      if (!reduce) {
        if (!shoot && now > nextShoot) {
          const fromLeft = Math.random() < 0.5;
          shoot = {
            x: fromLeft ? Math.random() * w * 0.4 : w * (0.6 + Math.random() * 0.4),
            y: Math.random() * h * 0.35,
            vx: (fromLeft ? 1 : -1) * (700 + Math.random() * 400),
            vy: 260 + Math.random() * 200,
            life: 1,
          };
          nextShoot = now + 4000 + Math.random() * 6000;
        }
        if (shoot) {
          shoot.x += shoot.vx * dt;
          shoot.y += shoot.vy * dt;
          shoot.life -= dt * 1.1;
          const len = 0.14;
          const g = ctx.createLinearGradient(shoot.x, shoot.y, shoot.x - shoot.vx * len, shoot.y - shoot.vy * len);
          g.addColorStop(0, 'rgba(255,255,255,0.95)');
          g.addColorStop(1, 'rgba(255,82,82,0)');
          ctx.globalAlpha = Math.max(0, shoot.life);
          ctx.strokeStyle = g;
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(shoot.x, shoot.y);
          ctx.lineTo(shoot.x - shoot.vx * len, shoot.y - shoot.vy * len);
          ctx.stroke();
          if (shoot.life <= 0) shoot = null;
        }
      }
      ctx.globalAlpha = 1;
    };

    let raf = 0;
    let visible = true;
    const loop = (now: number) => {
      draw(now);
      raf = requestAnimationFrame(loop);
    };
    const start = () => {
      if (reduce || raf || !visible || document.hidden) return;
      lastT = performance.now();
      raf = requestAnimationFrame(loop);
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };

    resize();
    draw(performance.now());
    new ResizeObserver(() => {
      resize();
      if (reduce) draw(performance.now());
    }).observe(canvas);

    if (!reduce) {
      window.addEventListener(
        'pointermove',
        (e) => {
          mx = (e.clientX / window.innerWidth - 0.5) * 2;
          my = (e.clientY / window.innerHeight - 0.5) * 2;
        },
        { passive: true }
      );
      new IntersectionObserver((entries) => {
        visible = entries[0].isIntersecting;
        if (visible) start();
        else stop();
      }).observe(root);
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
      start();

      frames.push(() => {
        const r = root.getBoundingClientRect();
        const p = clamp(-r.top / Math.max(1, r.height - window.innerHeight));
        root.style.setProperty('--sky-p', p.toFixed(4));
      });
    }
  }

  /* ------------------------------------------------------------------
     Hero: warp into the universe on scroll, parallax tilt on pointer.
     ------------------------------------------------------------------ */
  function initHero(root: HTMLElement, reduce: boolean, fine: boolean, frames: Frame[]) {
    const hero = root.querySelector<HTMLElement>('[data-hero]');
    if (!hero || reduce) return;
    frames.push(() => {
      // Starts once the hero's bottom edge rises above the viewport bottom.
      // On desktop that is the first pixel of scroll; on phones, where the
      // solar system sits below the copy, it waits until the system is seen.
      const r = hero.getBoundingClientRect();
      const p = clamp((window.innerHeight - r.bottom) / (window.innerHeight * 0.8));
      hero.style.setProperty('--hp', p.toFixed(3));
      hero.classList.toggle('is-warped', p > 0.3);
    });
    if (!fine) return;
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      hero.style.setProperty('--mx', (((e.clientX - r.left) / r.width - 0.5) * 2).toFixed(3));
      hero.style.setProperty('--my', (((e.clientY - r.top) / r.height - 0.5) * 2).toFixed(3));
    });
    hero.addEventListener('pointerleave', () => {
      hero.style.setProperty('--mx', '0');
      hero.style.setProperty('--my', '0');
    });
  }

  /* ------------------------------------------------------------------
     Core: four agents sweep the ring, the score climbs, a human approves.
     ------------------------------------------------------------------ */
  function initCore(root: HTMLElement, reduce: boolean) {
    const sec = root.querySelector<HTMLElement>('[data-core]');
    const ring = sec?.querySelector<HTMLElement>('[data-ring]');
    const agents = sec?.querySelector<SVGGElement>('[data-agents]');
    const scoreEl = sec?.querySelector<SVGTextElement>('[data-score]');
    const statusEl = sec?.querySelector<HTMLElement>('[data-core-status]');
    const startBtn = sec?.querySelector<HTMLButtonElement>('[data-core-start]');
    const approveBtn = sec?.querySelector<HTMLButtonElement>('[data-core-approve]');
    if (!sec || !ring || !agents || !scoreEl || !statusEl || !startBtn || !approveBtn) return;

    const segs = Array.from(sec.querySelectorAll<SVGGElement>('[data-seg]')).filter((s) => !s.dataset.planned);
    const dots = Array.from(sec.querySelectorAll<SVGCircleElement>('.u-dot'));
    const agentLabels = Array.from(agents.querySelectorAll<SVGTextElement>('text'));
    const TARGET = 94;
    const DURATION = 4200;
    let raf = 0;

    type State = 'idle' | 'scan' | 'ready' | 'done';
    const setState = (s: State) => {
      ring.dataset.state = s;
      statusEl.textContent = statusEl.dataset[s] || '';
    };
    const paint = (t: number) => {
      const e = 1 - Math.pow(1 - t, 3);
      const a = 90 * e;
      agents.setAttribute('transform', `rotate(${a.toFixed(2)})`);
      // Keep the agent labels upright while the group turns.
      agentLabels.forEach((tx) => {
        tx.setAttribute('transform', `rotate(${(-a).toFixed(2)} ${tx.dataset.cx} ${tx.dataset.cy})`);
      });
      segs.forEach((s) => s.classList.toggle('is-lit', t > 0 && Number(s.dataset.mid) % 90 <= a));
      const lit = Math.floor(13 * e + 1e-6);
      dots.forEach((d, i) => d.classList.toggle('is-lit', i < lit));
      scoreEl.textContent = String(Math.round(TARGET * e));
    };
    const finish = () => {
      setState('ready');
      approveBtn.disabled = false;
      startBtn.textContent = startBtn.dataset.restart || startBtn.textContent;
    };
    const run = () => {
      cancelAnimationFrame(raf);
      approveBtn.disabled = true;
      setState('scan');
      if (reduce) {
        paint(1);
        finish();
        return;
      }
      const t0 = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - t0) / DURATION, 1);
        paint(t);
        if (t < 1) raf = requestAnimationFrame(step);
        else finish();
      };
      raf = requestAnimationFrame(step);
    };

    startBtn.addEventListener('click', run);
    approveBtn.addEventListener('click', () => {
      if (ring.dataset.state !== 'ready') return;
      setState('done');
      approveBtn.disabled = true;
      startBtn.focus();
    });

    // Run once on its own the first time the ring is in view.
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) {
            io.disconnect();
            if (ring.dataset.state === 'idle') run();
          }
        },
        { threshold: 0.5 }
      );
      io.observe(ring);
    }
  }

  /* ------------------------------------------------------------------
     Worlds: the panel nearest the viewport centre decides which planet
     sits in the middle of the sticky stage.
     ------------------------------------------------------------------ */
  function initWorlds(root: HTMLElement, frames: Frame[]) {
    const sec = root.querySelector<HTMLElement>('[data-worlds]');
    if (!sec) return;
    const panels = Array.from(sec.querySelectorAll<HTMLElement>('[data-panel]'));
    const planets = Array.from(sec.querySelectorAll<HTMLElement>('[data-wp]'));
    const dots = Array.from(sec.querySelectorAll<HTMLElement>('[data-wdot]'));
    const narrow = window.matchMedia('(max-width: 959px)');
    let active = 0;

    frames.push(() => {
      if (narrow.matches) return;
      const sr = sec.getBoundingClientRect();
      if (sr.bottom < -200 || sr.top > window.innerHeight + 200) return;
      const vc = window.innerHeight * 0.5;
      const cs = panels.map((p) => {
        const r = p.getBoundingClientRect();
        return r.top + r.height / 2;
      });
      let p = 0;
      if (vc >= cs[cs.length - 1]) p = cs.length - 1;
      else if (vc > cs[0]) {
        for (let i = 0; i < cs.length - 1; i++) {
          if (vc >= cs[i] && vc <= cs[i + 1]) {
            p = i + (vc - cs[i]) / (cs[i + 1] - cs[i]);
            break;
          }
        }
      }
      planets.forEach((el, i) => {
        const d = i - p;
        el.style.setProperty('--d', d.toFixed(3));
        el.style.setProperty('--ad', Math.min(Math.abs(d), 1.6).toFixed(3));
      });
      const a = Math.round(p);
      if (a !== active) {
        active = a;
        panels.forEach((el, i) => el.classList.toggle('is-active', i === a));
        dots.forEach((el, i) => el.classList.toggle('is-active', i === a));
      }
    });

    // Hovering an offering lights up its moon.
    panels.forEach((panel, i) => {
      panel.querySelectorAll<HTMLElement>('[data-chip]').forEach((chip) => {
        const moon = planets[i]?.querySelector(`[data-moon="${chip.dataset.chip}"]`);
        if (!moon) return;
        chip.addEventListener('pointerenter', () => moon.classList.add('is-hot'));
        chip.addEventListener('pointerleave', () => moon.classList.remove('is-hot'));
      });
    });
  }

  /* ------------------------------------------------------------------
     Flight path: the line draws and the comet flies with the scroll.
     ------------------------------------------------------------------ */
  function initRoute(root: HTMLElement, reduce: boolean, frames: Frame[]) {
    const sec = root.querySelector<HTMLElement>('[data-route]');
    const path = sec?.querySelector<SVGPathElement>('[data-route-path]');
    const comet = sec?.querySelector<HTMLElement>('[data-comet]');
    const track = sec?.querySelector<HTMLElement>('.u-route__track');
    const svg = path?.ownerSVGElement;
    if (!sec || !path || !comet || !track || !svg) return;
    const steps = Array.from(sec.querySelectorAll<HTMLElement>('[data-step]'));
    const len = path.getTotalLength();
    const nodeX = [166.7, 500, 833.3];
    const at = nodeX.map((x) => {
      let lo = 0;
      let hi = len;
      for (let k = 0; k < 24; k++) {
        const mid = (lo + hi) / 2;
        if (path.getPointAtLength(mid).x < x) lo = mid;
        else hi = mid;
      }
      return lo / len;
    });

    frames.push(() => {
      const r = track.getBoundingClientRect();
      const vh = window.innerHeight;
      if (r.bottom < -vh || r.top > vh * 2) return;
      const p = reduce ? 1 : clamp((vh * 0.85 - r.top) / Math.max(vh * 0.55, r.height * 0.75));
      sec.style.setProperty('--route-p', p.toFixed(3));
      path.style.strokeDashoffset = String(1 - p);
      const box = svg.getBoundingClientRect();
      const sx = box.width / 1000;
      const sy = box.height / 160;
      const pt = path.getPointAtLength(len * p);
      const prev = path.getPointAtLength(Math.max(0, len * p - 6));
      comet.style.setProperty('--cx', `${(pt.x * sx).toFixed(1)}px`);
      comet.style.setProperty('--cy', `${(pt.y * sy).toFixed(1)}px`);
      const ang = (Math.atan2((pt.y - prev.y) * sy, (pt.x - prev.x) * sx) * 180) / Math.PI;
      comet.style.setProperty('--ang', `${ang.toFixed(1)}deg`);
      comet.style.opacity = p > 0.005 ? '1' : '0';
      steps.forEach((s, i) => s.classList.toggle('is-on', p >= at[i] - 0.02));
    });
  }

  /* ------------------------------------------------------------------
     Globe: dotted sphere, great-circle arcs from Eschborn, drag to
     rotate, country buttons turn it to the country.
     ------------------------------------------------------------------ */
  function initGlobe(root: HTMLElement, reduce: boolean) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-globe]');
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx) return;
    type Geo = { code: string; lat: number; lon: number; hub: boolean };
    type V3 = [number, number, number];
    const places = JSON.parse(canvas.dataset.geo || '[]') as Geo[];
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-country]'));
    const D = Math.PI / 180;
    const toV = (lat: number, lon: number): V3 => [
      Math.cos(lat * D) * Math.sin(lon * D),
      Math.sin(lat * D),
      Math.cos(lat * D) * Math.cos(lon * D),
    ];

    // Until the map data has loaded: an even Fibonacci lattice over the
    // whole sphere. Afterwards: dots on land only, plus country borders.
    const n = window.innerWidth < 700 ? 750 : 1400;
    let dotsV: V3[] = [];
    const ga = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < n; i++) {
      const y = 1 - (i / (n - 1)) * 2;
      const r = Math.sqrt(1 - y * y);
      dotsV.push([Math.cos(ga * i) * r, y, Math.sin(ga * i) * r]);
    }
    let borders: V3[][] = [];
    let countryRings = new Map<string, V3[][]>();
    let hasMap = false;

    /** Map data: Natural Earth 1:110m, degrees × 10 (see public/data/globe.json). */
    type MapData = { arcs: number[][]; hi: Record<string, number[][]>; dots: number[] };
    const unpack = (flat: number[]): V3[] => {
      const out: V3[] = [];
      for (let i = 0; i < flat.length; i += 2) out.push(toV(flat[i + 1] / 10, flat[i] / 10));
      return out;
    };
    let mapRequested = false;
    const loadMap = () => {
      if (mapRequested || !canvas.dataset.map) return;
      mapRequested = true;
      fetch(canvas.dataset.map)
        .then((r) => (r.ok ? (r.json() as Promise<MapData>) : Promise.reject(r.status)))
        .then((m) => {
          const keep = window.innerWidth < 700 ? 2 : 1; // thinner dot field on phones
          dotsV = unpack(m.dots).filter((_, i) => i % keep === 0);
          borders = m.arcs.map(unpack);
          countryRings = new Map(Object.entries(m.hi).map(([code, rings]) => [code, rings.map(unpack)]));
          hasMap = true;
          draw(performance.now());
        })
        .catch(() => {
          // Keep the lattice globe; the page works without the map.
        });
    };
    const placeV = places.map((p) => toV(p.lat, p.lon));
    const hubIndex = Math.max(0, places.findIndex((p) => p.hub));
    const hubV = placeV[hubIndex];

    // Great-circle arcs from the hub, lifted off the surface in the middle.
    const arcs = placeV
      .map((b, i) => ({ b, i }))
      .filter(({ i }) => i !== hubIndex)
      .map(({ b, i }) => {
        const dot = clamp(hubV[0] * b[0] + hubV[1] * b[1] + hubV[2] * b[2], -1, 1);
        const om = Math.acos(dot);
        const samples: [number, number, number, number][] = [];
        const steps = 56;
        for (let k = 0; k <= steps; k++) {
          const t = k / steps;
          const s0 = om < 1e-4 ? 1 - t : Math.sin((1 - t) * om) / Math.sin(om);
          const s1 = om < 1e-4 ? t : Math.sin(t * om) / Math.sin(om);
          const lift = 1 + Math.sin(Math.PI * t) * (0.06 + om * 0.16);
          samples.push([
            (s0 * hubV[0] + s1 * b[0]) * lift,
            (s0 * hubV[1] + s1 * b[1]) * lift,
            (s0 * hubV[2] + s1 * b[2]) * lift,
            t,
          ]);
        }
        return { i, samples };
      });

    let size = 0;
    let lon0 = 20 * D;
    let tilt = 0.42;
    let target: { lon: number; tilt: number } | null = null;
    let pauseUntil = 0;
    let selected = -1;
    let dragging = false;
    let lastX = 0;
    let lastY = 0;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      size = canvas.clientWidth;
      canvas.width = Math.round(size * dpr);
      canvas.height = Math.round(size * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const project = (v: V3 | [number, number, number, number], R: number, c: number) => {
      const cl = Math.cos(lon0);
      const sl = Math.sin(lon0);
      const x1 = v[0] * cl - v[2] * sl;
      const z1 = v[0] * sl + v[2] * cl;
      const ct = Math.cos(tilt);
      const st = Math.sin(tilt);
      const y2 = v[1] * ct - z1 * st;
      const z2 = v[1] * st + z1 * ct;
      return { x: c + x1 * R, y: c - y2 * R, z: z2, r2: x1 * x1 + y2 * y2 };
    };

    let lastT = performance.now();
    const draw = (now: number) => {
      const dt = Math.min(now - lastT, 50) / 1000;
      lastT = now;
      if (target) {
        let dl = target.lon - lon0;
        dl = Math.atan2(Math.sin(dl), Math.cos(dl));
        const k = Math.min(1, dt * 3.5);
        lon0 += dl * k;
        tilt += (target.tilt - tilt) * k;
        if (Math.abs(dl) < 0.002 && Math.abs(target.tilt - tilt) < 0.002) target = null;
      } else if (!dragging && !reduce && now > pauseUntil) {
        lon0 += dt * 0.16;
      }

      const c = size / 2;
      const R = size * 0.4;
      ctx.clearRect(0, 0, size, size);

      // Rim light
      const rim = ctx.createRadialGradient(c, c, R * 0.82, c, c, R * 1.18);
      rim.addColorStop(0, 'rgba(244,14,14,0)');
      rim.addColorStop(0.45, 'rgba(244,14,14,0.16)');
      rim.addColorStop(1, 'rgba(244,14,14,0)');
      ctx.fillStyle = rim;
      ctx.beginPath();
      ctx.arc(c, c, R * 1.18, 0, Math.PI * 2);
      ctx.fill();

      // Dots: land only once the map is in, the whole sphere before that.
      ctx.fillStyle = '#ffffff';
      for (let i = 0; i < dotsV.length; i++) {
        const p = project(dotsV[i], R, c);
        if (p.z < 0) {
          if (i % 3) continue;
          ctx.globalAlpha = hasMap ? 0.05 : 0.07;
          ctx.fillRect(p.x, p.y, 1, 1);
        } else {
          ctx.globalAlpha = hasMap ? 0.14 + p.z * 0.5 : 0.18 + p.z * 0.62;
          const s = hasMap ? 0.8 + p.z * 1.1 : 0.9 + p.z * 1.2;
          ctx.fillRect(p.x - s / 2, p.y - s / 2, s, s);
        }
      }

      if (hasMap) {
        // Project countries: tinted fill (only when the whole outline faces
        // the viewer, a half-hidden polygon cannot be filled correctly) and a
        // red outline on the visible part.
        places.forEach((pl, i) => {
          const rings = countryRings.get(pl.code);
          if (!rings) return;
          const hot = i === selected;
          rings.forEach((ringV) => {
            const pts = ringV.map((v) => project(v, R, c));
            if (pts.every((p) => p.z > 0.02)) {
              ctx.globalAlpha = hot ? 0.55 : 0.26;
              ctx.fillStyle = '#f40e0e';
              ctx.beginPath();
              pts.forEach((p, k) => (k ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y)));
              ctx.closePath();
              ctx.fill();
            }
          });
        });

        // Country borders: one path, broken wherever it turns away.
        ctx.lineJoin = 'round';
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = Math.max(0.6, size / 900);
        ctx.globalAlpha = 0.3;
        ctx.beginPath();
        for (const line of borders) {
          let pen = false;
          for (const v of line) {
            const p = project(v, R, c);
            if (p.z > 0) {
              if (pen) ctx.lineTo(p.x, p.y);
              else ctx.moveTo(p.x, p.y);
              pen = true;
            } else pen = false;
          }
        }
        ctx.stroke();

        places.forEach((pl, i) => {
          const rings = countryRings.get(pl.code);
          if (!rings) return;
          const hot = i === selected;
          ctx.strokeStyle = hot ? '#ffffff' : '#ff5252';
          ctx.lineWidth = hot ? 1.8 : 1.3;
          ctx.globalAlpha = hot ? 1 : 0.9;
          ctx.beginPath();
          rings.forEach((ringV) => {
            let pen = false;
            ringV.forEach((v) => {
              const p = project(v, R, c);
              if (p.z > 0) {
                if (pen) ctx.lineTo(p.x, p.y);
                else ctx.moveTo(p.x, p.y);
                pen = true;
              } else pen = false;
            });
          });
          ctx.stroke();
        });
      }

      // Arcs with a travelling pulse
      ctx.lineCap = 'round';
      arcs.forEach((arc, ai) => {
        const hot = selected === arc.i;
        ctx.strokeStyle = hot ? '#ffffff' : '#ff5252';
        ctx.lineWidth = hot ? 2 : 1.4;
        ctx.globalAlpha = hot ? 0.95 : 0.6;
        ctx.beginPath();
        let pen = false;
        const pts = arc.samples.map((s) => project(s, R, c));
        pts.forEach((p) => {
          const seen = p.z >= 0 || p.r2 > 1;
          if (seen && !pen) {
            ctx.moveTo(p.x, p.y);
            pen = true;
          } else if (seen) ctx.lineTo(p.x, p.y);
          else pen = false;
        });
        ctx.stroke();
        if (!reduce) {
          const t = (now / 2400 + ai * 0.21) % 1;
          const p = pts[Math.round(t * (pts.length - 1))];
          if (p.z >= 0 || p.r2 > 1) {
            ctx.globalAlpha = Math.sin(Math.PI * t);
            ctx.fillStyle = '#ffffff';
            ctx.beginPath();
            ctx.arc(p.x, p.y, 2.6, 0, Math.PI * 2);
            ctx.fill();
          }
        }
      });

      // Markers and labels
      ctx.font = `700 ${Math.max(11, size * 0.022)}px system-ui, -apple-system, 'Segoe UI', sans-serif`;
      ctx.textBaseline = 'middle';
      placeV.forEach((v, i) => {
        const p = project(v, R, c);
        if (p.z < 0) return;
        const hub = i === hubIndex;
        const hot = i === selected;
        const pulse = reduce ? 0.5 : (now / 1700 + i * 0.17) % 1;
        ctx.globalAlpha = (1 - pulse) * 0.8 * p.z;
        ctx.strokeStyle = '#ff5252';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(p.x, p.y, 4 + pulse * (hot ? 22 : 14), 0, Math.PI * 2);
        ctx.stroke();
        ctx.globalAlpha = 0.4 + p.z * 0.6;
        ctx.fillStyle = hub || hot ? '#ffffff' : '#ff3030';
        ctx.beginPath();
        ctx.arc(p.x, p.y, hub || hot ? 5.5 : 4, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.globalAlpha = 0.35 + p.z * 0.65;
        // Switzerland sits right next to the hub: label it below-left so the
        // two codes never overlap.
        if (places[i].code === 'CH') {
          ctx.textAlign = 'right';
          ctx.fillText(places[i].code, p.x - 9, p.y + 12);
          ctx.textAlign = 'left';
        } else {
          ctx.fillText(places[i].code, p.x + 10, p.y - 10);
        }
      });
      ctx.globalAlpha = 1;
    };

    let raf = 0;
    let visible = false;
    const loop = (now: number) => {
      draw(now);
      raf = requestAnimationFrame(loop);
    };
    const start = () => {
      if (raf || !visible || document.hidden) return;
      lastT = performance.now();
      raf = requestAnimationFrame(loop);
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };

    resize();
    draw(performance.now());
    new ResizeObserver(() => {
      resize();
      draw(performance.now());
    }).observe(canvas);
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (visible) start();
      else stop();
    }).observe(canvas);
    // Fetch the map a little before the globe scrolls into view.
    new IntersectionObserver(
      (entries, obs) => {
        if (!entries[0].isIntersecting) return;
        obs.disconnect();
        loadMap();
      },
      { rootMargin: '900px 0px' }
    ).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    canvas.addEventListener('pointerdown', (e) => {
      dragging = true;
      target = null;
      lastX = e.clientX;
      lastY = e.clientY;
      canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      lon0 -= (e.clientX - lastX) * 0.008;
      tilt = clamp(tilt + (e.clientY - lastY) * 0.006, -0.3, 1.1);
      lastX = e.clientX;
      lastY = e.clientY;
      pauseUntil = performance.now() + 3000;
    });
    const end = () => {
      dragging = false;
    };
    canvas.addEventListener('pointerup', end);
    canvas.addEventListener('pointercancel', end);

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const i = Number(btn.dataset.country);
        const p = places[i];
        if (!p) return;
        selected = i;
        target = { lon: p.lon * D, tilt: clamp(p.lat * D * 0.85, -0.3, 1.1) };
        pauseUntil = performance.now() + 6000;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        start();
      });
    });
  }

  /* ------------------------------------------------------------------
     Minimap: highlights the scene that crosses the middle of the screen.
     ------------------------------------------------------------------ */
  function initMap(root: HTMLElement) {
    const map = root.querySelector<HTMLElement>('[data-map]');
    if (!map || !('IntersectionObserver' in window)) return;
    const links = Array.from(map.querySelectorAll<HTMLAnchorElement>('[data-map-link]'));
    const secs = Array.from(root.querySelectorAll<HTMLElement>('[data-track]'));
    const seen = new Set<string>();
    const update = () => {
      const current = secs.find((s) => seen.has(s.id))?.id;
      map.classList.toggle('is-on', Boolean(current));
      links.forEach((a) => {
        if (a.dataset.mapLink === current) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const id = (e.target as HTMLElement).id;
          if (e.isIntersecting) seen.add(id);
          else seen.delete(id);
        });
        update();
      },
      { rootMargin: '-48% 0px -48% 0px' }
    );
    secs.forEach((s) => io.observe(s));
  }

  /* ------------------------------------------------------------------
     One-shot "in view" class for the drawn-in effects.
     ------------------------------------------------------------------ */
  function initInView(root: HTMLElement, reduce: boolean) {
    const els = Array.from(root.querySelectorAll<HTMLElement>('[data-in]'));
    if (reduce || !('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('is-in'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        });
      },
      { threshold: 0.2 }
    );
    els.forEach((el) => io.observe(el));
  }

  const root = document.querySelector<HTMLElement>('[data-uni]');
  if (root) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const frames: Frame[] = [];
    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        frames.forEach((f) => f());
      });
    };

    initSky(root, reduce, frames);
    initHero(root, reduce, fine, frames);
    initCore(root, reduce);
    initWorlds(root, frames);
    initRoute(root, reduce, frames);
    initGlobe(root, reduce);
    initMap(root);
    initInView(root, reduce);

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    schedule();
  }
</script>
