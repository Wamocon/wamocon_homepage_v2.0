---
/**
 * Contact details block — shown at the bottom of every page.
 * Company details on the left, office photo with Google rating on the right,
 * and a full-width CTA bar that opens a general contact popup (self-contained,
 * so it works on every page without page-level modal wiring).
 */
import { company, legalNav, type Lang } from '../../i18n/config';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const privacyHref = legalNav.privacy[lang].href;
const thankYouHref = { de: '/danke/', en: '/en/thank-you/', tr: '/tr/tesekkurler/' }[lang];

const social = [
  { name: 'YouTube', href: company.social.youtube, icon: '/images/icon-youtube.svg' },
  { name: 'LinkedIn', href: company.social.linkedin, icon: '/images/icon-linkedin.svg' },
  { name: 'Instagram', href: company.social.instagram, icon: '/images/icon-instagram.svg' },
  { name: 'Facebook', href: company.social.facebook, icon: '/images/icon-facebook.svg' },
];

const labels = {
  de: {
    phone: 'Telefon',
    contactPerson: 'Ansprechpartner',
    contactPersonName: 'Dipl.-Ing. Waleri Moretz, Geschäftsführer der WAMOCON GmbH',
    hours: 'Öffnungszeiten',
    location: 'Standort',
    follow: 'Folgen Sie uns auf sozialen Medien',
    imgAlt: 'WAMOCON Team im Büro',
    ratingLabel: 'Google Bewertung 5,0',
    ctaTitle: 'Lieber direkt schreiben?',
    ctaText: 'Senden Sie uns Ihre Nachricht. Wir melden uns zeitnah über den von Ihnen gewählten Kontaktweg.',
    ctaButton: 'Kontakt aufnehmen',
    modalTitle: 'Kontakt aufnehmen',
    modalSubtitle: 'Haben Sie eine Frage oder ein Anliegen? Schreiben Sie uns eine Nachricht. Wir melden uns zeitnah bei Ihnen.',
    name: 'Ihr Name',
    message: 'Ihre Nachricht',
    submit: 'Nachricht senden',
    close: 'Schließen',
    consentPre: 'Hiermit bestätige ich, dass ich die ',
    consentLink: 'Datenschutzerklärung',
    consentPost: ' gelesen habe. Bitte geben Sie E-Mail oder Telefon an.',
  },
  en: {
    phone: 'Phone',
    contactPerson: 'Contact person',
    contactPersonName: 'Dipl.-Ing. Waleri Moretz, Managing Director, WAMOCON GmbH',
    hours: 'Opening hours',
    location: 'Location',
    follow: 'Follow us on social media',
    imgAlt: 'WAMOCON team in the office',
    ratingLabel: 'Google rating 5.0',
    ctaTitle: 'Prefer to write directly?',
    ctaText: 'Send us your message and we will get back to you shortly via the contact channel you choose.',
    ctaButton: 'Contact us',
    modalTitle: 'Get in touch',
    modalSubtitle: 'Do you have a question or request? Send us a message and we will get back to you shortly.',
    name: 'Your name',
    message: 'Your message',
    submit: 'Send message',
    close: 'Close',
    consentPre: 'I hereby confirm that I have read the ',
    consentLink: 'privacy policy',
    consentPost: '. Please provide an email address or phone number.',
  },
  tr: {
    phone: 'Telefon',
    contactPerson: 'İlgili kişi',
    contactPersonName: 'Dipl.-Ing. Waleri Moretz, WAMOCON GmbH Genel Müdürü',
    hours: 'Çalışma saatleri',
    location: 'Konum',
    follow: 'Bizi sosyal medyada takip edin',
    imgAlt: 'Ofiste WAMOCON ekibi',
    ratingLabel: 'Google puanı 5,0',
    ctaTitle: 'Doğrudan yazmayı mı tercih edersiniz?',
    ctaText: 'Mesajınızı gönderin; seçtiğiniz iletişim kanalı üzerinden en kısa sürede size dönüş yapalım.',
    ctaButton: 'İletişime geçin',
    modalTitle: 'İletişime geçin',
    modalSubtitle: 'Bir sorunuz veya talebiniz mi var? Bize mesaj gönderin, en kısa sürede size dönüş yapalım.',
    name: 'Adınız',
    message: 'Mesajınız',
    submit: 'Mesajı gönder',
    close: 'Kapat',
    consentPre: 'İşbu formu göndererek ',
    consentLink: 'gizlilik politikasını',
    consentPost: ' okuduğumu onaylıyorum. Lütfen e-posta veya telefon bilgisi girin.',
  },
}[lang];
---

<section class="section contact" id="kontakt">
  <div class="container">
    <div class="contact__grid">
      <div class="contact__info" data-reveal="left">
        <h2 class="contact__name">{company.name}</h2>

        <div class="contact__row">
          <span class="contact__label">{labels.contactPerson}:</span>
          <span>{labels.contactPersonName}</span>
        </div>

        <div class="contact__row">
          <span class="contact__label">{labels.phone}:</span>
          <a href={company.phoneHref}>{company.phone}</a>
        </div>
        <div class="contact__row">
          <span class="contact__label">E-Mail:</span>
          <a href={company.emailHref}>{company.email}</a>
        </div>
        <div class="contact__row">
          <span class="contact__label">{labels.hours}:</span>
          <span>{company.hours[lang].map((h) => <>{h}<br /></>)}</span>
        </div>
        <div class="contact__row">
          <span class="contact__label">{labels.location}:</span>
          <span>{company.street}<br />{company.city}</span>
        </div>

        <div class="contact__social">
          <span class="contact__label">{labels.follow}</span>
          <ul>
            {
              social.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
                    <img src={s.icon} alt="" width="50" height="50" loading="lazy" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <figure class="contact__media" data-reveal="right">
        <img
          src="/images/contact-office.jpg"
          alt={labels.imgAlt}
          width="720"
          height="560"
          loading="lazy"
        />
        <figcaption class="contact__rating" aria-label={labels.ratingLabel}>
          <svg width="22" height="22" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          </svg>
          <span class="contact__rating-value">5,0</span>
          <span class="contact__stars" aria-hidden="true">★★★★★</span>
        </figcaption>
      </figure>
    </div>

    <!-- Full-width CTA bar that opens the general contact popup. -->
    <div class="contact__cta-bar" data-reveal="up">
      <div class="contact__cta-copy">
        <strong>{labels.ctaTitle}</strong>
        <span>{labels.ctaText}</span>
      </div>
      <button type="button" class="btn btn--primary contact__cta-btn" data-contact-open>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 5h16v14H4z" stroke-linejoin="round"/><path d="M4 6l8 6 8-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {labels.ctaButton}
      </button>
    </div>
  </div>

  <!-- General contact popup -->
  <div class="contact-modal" data-contact-modal hidden>
    <div class="contact-modal__overlay" data-contact-close></div>
    <div class="contact-modal__panel" role="dialog" aria-modal="true" aria-labelledby="contact-modal-title">
      <button type="button" class="contact-modal__close" data-contact-close aria-label={labels.close}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
      <h2 class="contact-modal__title" id="contact-modal-title">{labels.modalTitle}</h2>
      <p class="contact-modal__subtitle">{labels.modalSubtitle}</p>
      <form class="contact-modal__form js-lead-form" data-redirect={thankYouHref}>
        <input type="hidden" name="type" value="contact" />
        <input type="hidden" name="lang" value={lang} />
        <label class="contact-modal__field">
          <span>{labels.name}</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <div class="contact-modal__row">
          <label class="contact-modal__field">
            <span>{labels.phone}</span>
            <input type="tel" name="phone" autocomplete="tel" inputmode="tel" />
          </label>
          <label class="contact-modal__field">
            <span>E-Mail</span>
            <input type="email" name="email" autocomplete="email" />
          </label>
        </div>
        <label class="contact-modal__field">
          <span>{labels.message}</span>
          <textarea name="comment" rows="4"></textarea>
        </label>
        <p class="contact-modal__consent">{labels.consentPre}<a href={privacyHref}>{labels.consentLink}</a>{labels.consentPost}</p>
        <button type="submit" class="btn btn--primary contact-modal__submit">{labels.submit}</button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .contact__name {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 2.5rem;
  }
  .contact__row {
    margin-bottom: 1.75rem;
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .contact__label {
    display: block;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }
  .contact__row a:hover {
    color: var(--color-accent);
  }
  .contact__social {
    margin-top: 2.5rem;
  }
  .contact__social ul {
    display: flex;
    gap: 0.85rem;
    margin-top: 0.85rem;
  }
  .contact__social a {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .contact__social a:hover {
    transform: translateY(-3px);
  }
  .contact__social img {
    width: 100%;
    height: 100%;
  }

  .contact__media {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
  }
  .contact__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 5 / 4;
  }
  .contact__rating {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    background: #1a1a1a;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
  }
  .contact__rating-value {
    font-weight: var(--fw-semibold);
    color: #fff;
  }
  .contact__stars {
    color: var(--color-accent);
    letter-spacing: 1px;
    font-size: 0.95rem;
  }

  /* CTA bar */
  .contact__cta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.4rem, 3vw, 2rem);
    background: linear-gradient(120deg, rgba(244, 14, 14, 0.12), transparent 70%), var(--surface-card);
    border: 1px solid rgba(244, 14, 14, 0.3);
    border-radius: var(--radius-lg);
  }
  .contact__cta-copy { display: grid; gap: 0.25rem; }
  .contact__cta-copy strong { font-size: 1.2rem; color: var(--color-text); }
  .contact__cta-copy span { color: var(--color-text-muted); max-width: 60ch; }
  /* Explicit big red button — the .btn--primary styles are scoped to the Button
     component and do not reach a raw <button>, so we style it directly here. */
  .contact__cta-btn,
  .contact-modal__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    flex: 0 0 auto;
    padding: 1.05rem 2.4rem;
    font-size: 1.05rem;
    font-weight: var(--fw-semibold);
    line-height: 1;
    letter-spacing: 0.02em;
    color: #fff;
    background: var(--color-accent);
    border: none;
    border-radius: var(--radius-pill);
    cursor: pointer;
    box-shadow: var(--shadow-accent);
    transition: background var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .contact__cta-btn:hover,
  .contact-modal__submit:hover {
    background: var(--color-accent-hover, #c81111);
    transform: translateY(-2px);
  }

  /* Modal */
  .contact-modal {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-modal, 1000) + 5);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(0, 0, 0, 0.64);
    backdrop-filter: blur(2px);
  }
  .contact-modal[hidden] { display: none; }
  .contact-modal__overlay { position: absolute; inset: 0; }
  .contact-modal__panel {
    position: relative;
    width: min(640px, 100%);
    max-height: 90vh;
    overflow-y: auto;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    background: var(--surface-card, #161616);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55);
  }
  .contact-modal__close {
    position: absolute; top: 1rem; right: 1rem;
    display: grid; place-items: center;
    width: 40px; height: 40px; border-radius: 50%;
    color: var(--color-text); background: rgba(255, 255, 255, 0.06);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast);
  }
  .contact-modal__close:hover { background: var(--color-accent-surface); color: #fff; }
  .contact-modal__title { font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.15; margin: 0 2.5rem 0.6rem 0; }
  .contact-modal__subtitle { color: var(--color-text-muted); margin-bottom: 1.75rem; }
  .contact-modal__form { display: grid; gap: 1rem; }
  .contact-modal__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .contact-modal__field { display: grid; gap: 0.4rem; color: var(--color-text); font-size: 0.88rem; font-weight: var(--fw-semibold); }
  .contact-modal__form input, .contact-modal__form textarea {
    width: 100%; padding: 0.9rem 1.1rem; font: inherit;
    color: #1a1a1a; background: #fff; border: 1px solid transparent; border-radius: 10px; resize: vertical;
  }
  .contact-modal__consent { font-size: 0.82rem; color: var(--color-text-muted); line-height: 1.5; }
  .contact-modal__consent a { color: var(--color-accent); text-decoration: underline; }
  .contact-modal__submit { margin-top: 0.25rem; width: 100%; }

  @media (max-width: 860px) {
    .contact__grid { grid-template-columns: 1fr; }
    .contact__media { order: -1; }
  }
  @media (max-width: 480px) {
    .contact-modal__row { grid-template-columns: 1fr; }
    .contact-modal__submit { justify-self: stretch; text-align: center; }
  }
</style>

<script>
  // Self-contained open/close for the general contact popup. Runs on every page
  // that renders ContactBlock; submission + Turnstile are handled globally.
  document.querySelectorAll<HTMLElement>('[data-contact-modal]').forEach((modal) => {
    const open = () => { modal.hidden = false; document.body.style.overflow = 'hidden'; modal.querySelector<HTMLInputElement>('input[name="name"]')?.focus(); };
    const close = () => { modal.hidden = true; document.body.style.overflow = ''; };
    // A modal can be opened by any trigger inside the same ContactBlock section.
    const section = modal.closest('section');
    section?.querySelectorAll('[data-contact-open]').forEach((btn) => btn.addEventListener('click', open));
    modal.querySelectorAll('[data-contact-close]').forEach((btn) => btn.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) close(); });
  });
</script>
