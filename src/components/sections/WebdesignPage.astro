  }
</style>

<script>
  // Portfolio industry filter.
  const filters = document.querySelectorAll<HTMLButtonElement>('.wd-filter');
  const cards = document.querySelectorAll<HTMLElement>('.wd-card');
  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.filter;
      filters.forEach((f) => {
        const active = f === btn;
        f.classList.toggle('is-active', active);
        f.setAttribute('aria-pressed', String(active));
      });
      cards.forEach((card) => {
        const show = key === 'all' || card.dataset.category === key;
        card.classList.toggle('is-hidden', !show);
      });
    });
  });
</script>
