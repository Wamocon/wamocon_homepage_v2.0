    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }
  .wd-close__card--risk { border-color: rgba(244, 14, 14, 0.35); }
  .wd-close__card h2 { margin-bottom: 1.25rem; }
  .wd-close__card h3 { margin-bottom: 0.9rem; font-size: 1.4rem; }
