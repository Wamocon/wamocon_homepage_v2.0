  .wd-outcome svg { flex: 0 0 auto; margin-top: 0.2rem; color: var(--color-accent); }
  .wd-outcome h3 { margin-bottom: 0.4rem; font-size: 1.2rem; }

  /* ---------- close (Like / Share / Love) ---------- */
  .wd-close__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem; }
  .wd-close__card {
