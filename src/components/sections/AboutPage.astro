  { year: '2023', lines: ['Bir Alman eğitim merkezinde ISTQB® Certified Tester v.4.0 Foundation Level ürün test programının geliştirilmesi.', 'Avrupa’nın önde gelen mobil operatörlerinden biri için test yönetimi odaklı yeni bir S4 HANA sisteminin hayata geçirilmesi.', 'Önde gelen bir Alman otomobil üreticisinde bayiler için SAP BI devreye alımı.', 'Önde gelen bir Alman ulaşım şirketi için sefer planı sisteminin geliştirilmesi.', 'Bir Alman eğitim merkezinde yeni ISTQB® Certified Tester Foundation Level seminerinin başlatılması.'], fact: '2023 sonunda WAMOCON, kilit pozisyonlardaki ekibini 5’ten 10’a çıkararak ikiye katladı. Bu, tarihî bir büyümenin başlangıç işareti oldu.' },
  { year: '2024', lines: ['Önde gelen bir Alman ulaşım şirketi için test yönetimi odaklı konstrüksiyon sisteminin geliştirilmesi.', 'Önde gelen bir Alman ulaşım şirketi için test yönetimi odaklı yeni bir SAP S4 HANA sisteminin hayata geçirilmesi.', 'Ağustos 2024’ten itibaren şirket genelinde yapay zekânın kapsamlı biçimde devreye alınması.'] },
  { year: '2025', lines: ['Uygulama geliştirme bilişim uzmanlığı mesleki eğitimi için ilk kendi yapay zekâ sistemimiz yayına girdi.'] },
  { year: '2026', lines: ['En farklı sektörlerden müşteriler için 50’den fazla özel yapay zekâ ürün çözümü geliştirildi. Her biri LaaJ ile eğitildi, test edildi ve canlıya alındı.'] },
];

const timeline = { de: milestones, en: milestonesEn, tr: milestonesTr }[lang];
const magazinUrl = lang === 'de'
  ? 'https://wamocon-my.sharepoint.com/:b:/p/waleri_moretz/EZUMpxrfjYdPt7g1H7xkQhkBnuG6v-tWKLCPNZIN6Wejlw?e=bQVx7k&download=1'
  : 'https://wamocon-my.sharepoint.com/my?id=%2Fpersonal%2Fwaleri%5Fmoretz%5Fwamocon%5Fcom%2FDocuments%2F01%5FWMC%2F01%20Vertrieb%20und%20Marketing%2F01%2D01%20Marketing%2F01%2D01%2D14%20WMC%20Marketing%2F07%20WMC%20Magazin%2FFinal%20Magazin%20WAMOCON&viewid=6e86f4bd%2D8476%2D4fa5%2Dad74%2D5e1cf1eedc8b';
---

<!-- HERO -->
<section class="ab-hero">
  <div class="container">
    <h1 class="ab-hero__title"><span class="t-red">{c.heroTitleAccent}</span><span class="t-white">{c.heroTitleRest}</span></h1>
    <div class="ab-hero__grid">
      <div class="ab-hero__block" data-reveal="up">
        <strong>{c.heroBlocks[0].h}</strong>
        <p>{c.heroBlocks[0].p}</p>
      </div>
      <img class="ab-hero__img" src="/images/team-photo.jpg" alt={c.heroImgAlt} loading="lazy" />
      <div class="ab-hero__block" data-reveal="up" data-reveal-delay="80">
        <strong>{c.heroBlocks[1].h}</strong>
        <p>{c.heroBlocks[1].p}</p>
      </div>
      <div class="ab-hero__block" data-reveal="up" data-reveal-delay="160">
        <strong>{c.heroBlocks[2].h}</strong>
        <p>{c.heroBlocks[2].p}</p>
      </div>
    </div>
  </div>
</section>

<!-- SUCCESS FACTORS -->
<section class="section section--alt">
  <div class="container">
    <h2 class="ab-h2"><span class="t-red">{c.factorsLead}</span><span class="t-white">{c.factorsRest}</span></h2>
    <ul class="ab-factors">
      {c.factors.map((f, i) => (
        <li class="ab-factor" data-reveal="up" data-reveal-delay={i * 50}>
          <strong>{f.h}</strong>
          <span>{f.p}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- GUIDE -->
<section class="section">
  <div class="container">
    <h2 class="ab-h2"><span class="t-red">{c.guideLead}</span><span class="t-white">{c.guideRest}</span></h2>
    <div class="ab-guide">
      {c.guideCards.map((card, i) => (
        <article class="ab-guide__card" data-reveal="up" data-reveal-delay={i * 80}>
          <h3>{card.h}</h3>
          <ul>
            {card.items.map((it) => <li>{it}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- SOLUTION -->
<section class="section section--alt">
  <div class="container">
    <img
      class="ab-solution__hero"
      src="/images/IT-Innovation.jpg"
      alt={c.solutionImgAlt}
      loading="lazy"
      data-reveal="up"
    />
    <h2 class="ab-h2"><span class="t-white">{c.solutionLead}</span><span class="t-white">{c.solutionMid}</span><span class="t-red">{c.solutionAccent}</span></h2>
    <div class="ab-solution">
      {c.solutionParas.map((sp, i) => (
        <div class="ab-solution__col" data-reveal="up" data-reveal-delay={i * 80}>
          <strong>{sp.s}</strong>
          <p>{sp.p}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- VISION -->
<section class="section">
  <div class="container">
    <h2 class="ab-h2"><span class="t-white">{c.visionLead}</span><span class="t-red">{c.visionAccent}</span></h2>
    <div class="ab-vision">
      {c.visionItems.map((v, i) => (
        <article class="ab-vision__card" data-reveal="up" data-reveal-delay={i * 80}>
          <strong>{v.h}</strong>
          <p>{v.p}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- CLIENTS -->
<section class="section section--alt">
  <div class="container">
    <h2 class="ab-h2 ab-h2--center"><span class="t-white">{c.clientsTitle}</span></h2>
    <ul class="ab-clients">
      {clients.map((cl) => <li>{cl}</li>)}
    </ul>
  </div>
</section>

<!-- TEAM -->
<section class="section" id="team">
  <div class="container">
    <h2 class="ab-h2 ab-h2--center"><span class="t-white">{c.teamTitle}</span></h2>
    <div class="ab-team-intro">
      {c.teamParas.map((tp, i) => (
        <p data-reveal="up" data-reveal-delay={i * 60}>
          {tp.s && <strong>{tp.s} </strong>}{tp.p}
        </p>
      ))}
    </div>
    <div class="ab-team">
      {team.map((m, i) => (
        <article class="ab-team__card" data-reveal="up" data-reveal-delay={(i % 5) * 60}>
          <div class="ab-team__photo">
            <img src={m.img} alt={`${c.portraitAlt} ${m.name}, ${m.role}`} loading="lazy" />
          </div>
          <h3 class="ab-team__name">{m.name}</h3>
          <p class="ab-team__role">{m.role}</p>
          <button class="ab-team__more" type="button" data-bio={m.slug}>{c.more}</button>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- TEAM BIO MODALS -->
<div class="ab-modal" id="ab-bio-modal" hidden>
  <div class="ab-modal__backdrop" data-close></div>
  <div class="ab-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="ab-bio-name">
    <button class="ab-modal__close" type="button" data-close aria-label="Close">&times;</button>
    {team.map((m) => (
      <div class="ab-bio" data-bio-content={m.slug} hidden>
        <img class="ab-bio__photo" src={m.img} alt={`${c.portraitAlt} ${m.name}, ${m.role}`} loading="lazy" />
        <h3 class="ab-bio__name">{m.name}</h3>
        <p class="ab-bio__title">{m.bioTitle}</p>
        {m.bio.map((para) => <p class="ab-bio__para">{para}</p>)}
      </div>
    ))}
  </div>
</div>

<!-- MILESTONES -->
<section class="section section--alt">
  <div class="container">
    <h2 class="ab-h2 ab-h2--center"><span class="t-red">{c.milestonesTitle}</span></h2>
    <div class="ab-timeline">
      {timeline.map((m, i) => (
        <div class="ab-tl__row" data-reveal="up" data-reveal-delay={(i % 2) * 60}>
          <div class="ab-tl__year">{m.year}</div>
          <div class="ab-tl__body">
            <ul>
              {m.lines.map((l) => <li>{l}</li>)}
            </ul>
            {m.fact && (
              <p class="ab-tl__fact"><strong>{c.factLabel}</strong> {m.fact}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- MAGAZINE -->
<section class="section">
  <div class="container">
    <div class="ab-magazin">
      <img src="/images/magazin-cover.jpg" alt={c.magazinImgAlt} loading="lazy" />
      <div class="ab-magazin__body">
        <h2><span class="t-white">{c.magazinTitle}</span></h2>
        <p>{c.magazinText}</p>
        <a class="ab-btn" href={magazinUrl} download target="_blank" rel="noopener">{c.magazinBtn}</a>
      </div>
    </div>
  </div>
</section>

<ContactBlock lang={lang} />

<style>
  .t-red { color: var(--color-accent); }
  .t-white { color: var(--color-text); }

  .ab-hero { padding: clamp(3rem, 8vw, 6rem) 0 clamp(2rem, 5vw, 3.5rem); }
  /* No ch cap: at 16ch the title stacked into a narrow column hugging the left
     edge and left most of the screen empty. It now runs the container width. */
  .ab-hero__title {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: var(--fw-bold);
    line-height: 1.08;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .ab-hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.2rem, 3vw, 2rem);
    align-items: start;
  }
  .ab-hero__img {
    grid-row: span 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }
  .ab-hero__block strong { display: block; font-size: 1.15rem; margin-bottom: 0.5rem; }
  .ab-hero__block p { color: var(--color-text-muted); line-height: 1.6; }

  .ab-h2 {
    font-size: clamp(1.8rem, 4.5vw, 3rem);
    font-weight: var(--fw-bold);
    line-height: 1.1;
    margin-bottom: clamp(1.6rem, 4vw, 2.6rem);
  }
  /* Kept as a markup hook; the site aligns every heading left. */
  .ab-h2--center { text-align: left; }

  .ab-factors {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }
  .ab-factor {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .ab-factor strong { font-size: 1.1rem; color: var(--color-accent); }
  .ab-factor span { color: var(--color-text-muted); line-height: 1.55; }

  .ab-guide { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .ab-guide__card {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: clamp(1.6rem, 3vw, 2.4rem);
  }
  .ab-guide__card h3 { font-size: 1.4rem; margin-bottom: 1.2rem; }
  .ab-guide__card ul { list-style: none; display: flex; flex-direction: column; gap: 0.9rem; }
  .ab-guide__card li { position: relative; padding-left: 1.4rem; color: var(--color-text-muted); line-height: 1.55; }
  .ab-guide__card li::before { content: '–'; position: absolute; left: 0; color: var(--color-accent); font-weight: 700; }

  .ab-solution { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .ab-solution__hero { width: 100%; height: auto; max-height: 460px; object-fit: cover; border-radius: var(--radius-md); margin-bottom: clamp(1.5rem, 3vw, 2.5rem); display: block; }
  .ab-solution__col strong { display: block; color: var(--color-accent); font-size: 1.15rem; margin-bottom: 0.7rem; }
  .ab-solution__col p { color: var(--color-text-muted); line-height: 1.6; }

  .ab-vision { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .ab-vision__card {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: clamp(1.6rem, 3vw, 2.4rem);
  }
  .ab-vision__card strong { display: block; color: var(--color-accent); font-size: 1.2rem; margin-bottom: 0.8rem; }
  .ab-vision__card p { color: var(--color-text-muted); line-height: 1.6; }

  .ab-clients {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.7rem 2rem;
  }
  .ab-clients li { position: relative; padding-left: 1.3rem; color: var(--color-text-muted); }
  .ab-clients li::before { content: '•'; position: absolute; left: 0; color: var(--color-accent); }

  .ab-team-intro { max-width: 900px; margin: 0 0 clamp(2rem, 4vw, 3rem); }
  .ab-team-intro p { color: var(--color-text-muted); line-height: 1.65; margin-bottom: 1rem; }
  .ab-team-intro strong { color: var(--color-text); }

  .ab-team { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.2rem; }
  .ab-team__card {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    transition: transform var(--dur-med) var(--ease-out);
  }
  .ab-team__card:hover { transform: translateY(-6px); }
  .ab-team__photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-bottom: 1rem;
    border: 1px solid var(--border-subtle);
  }
  .ab-team__photo img { width: 100%; height: 100%; object-fit: cover; }
  .ab-team__name { font-size: 1.05rem; margin-bottom: 0.4rem; }
  .ab-team__role { font-size: 0.8rem; color: var(--color-text-muted); line-height: 1.4; margin-bottom: 1rem; }
  .ab-team__more {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: var(--fw-semibold);
    color: var(--color-accent);
    background: transparent;
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    padding: 0.5rem 1.2rem;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .ab-team__more:hover { background: var(--color-accent-surface); color: #fff; }

  /* Cards stretch instead of hugging their content, so the two boxes in a row
     always end at the same height rather than leaving a ragged bottom edge. */
  .ab-timeline { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; align-items: stretch; }
  .ab-tl__row {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 1.2rem;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }
  .ab-tl__year { font-size: 1.7rem; font-weight: var(--fw-bold); color: var(--color-accent); }
  .ab-tl__body ul { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
  .ab-tl__body li { position: relative; padding-left: 1.3rem; color: var(--color-text-muted); line-height: 1.55; }
  .ab-tl__body li::before { content: '–'; position: absolute; left: 0; color: var(--color-accent); }
  .ab-tl__fact { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-subtle); color: var(--color-text-muted); line-height: 1.55; }
  .ab-tl__fact strong { color: var(--color-accent); }

  .ab-magazin {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: clamp(1.6rem, 4vw, 3rem);
  }
  .ab-magazin img { width: 100%; border-radius: var(--radius-md); border: 1px solid var(--border-subtle); }
  .ab-magazin__body h2 { font-size: clamp(1.6rem, 3.5vw, 2.4rem); margin-bottom: 1rem; }
  .ab-magazin__body p { color: var(--color-text-muted); line-height: 1.6; margin-bottom: 1.5rem; }
  .ab-btn {
    display: inline-block;
    padding: 0.9rem 2rem;
    background: var(--color-accent-surface);
    color: #fff;
    font-weight: var(--fw-semibold);
    border-radius: var(--radius-sm);
    transition: background var(--dur-fast) var(--ease-out);
  }
  .ab-btn:hover { background: var(--color-accent-hover); }

  @media (max-width: 900px) {
    .ab-factors { grid-template-columns: 1fr 1fr; }
    .ab-team { grid-template-columns: repeat(3, 1fr); }
    .ab-clients { grid-template-columns: 1fr 1fr; }
    .ab-timeline { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .ab-hero__grid, .ab-guide, .ab-solution, .ab-vision, .ab-magazin { grid-template-columns: 1fr; }
    .ab-hero__img { grid-row: auto; max-height: 280px; }
    .ab-factors, .ab-team, .ab-clients { grid-template-columns: 1fr; }
    .ab-tl__row { grid-template-columns: 1fr; gap: 0.6rem; }
  }

  /* TEAM BIO MODAL */
  .ab-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }
  .ab-modal[hidden] { display: none; }
  .ab-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(4px);
  }
  .ab-modal__dialog {
    position: relative;
    z-index: 1;
    background: var(--color-bg-elev, #181818);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    max-width: 920px;
    width: 100%;
    max-height: 88vh;
    overflow-y: auto;
    padding: clamp(2rem, 4vw, 3.25rem);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  }
  .ab-modal__close {
    position: sticky;
    top: 0;
    float: right;
    margin: -0.5rem -0.5rem 0 0;
    width: 2.4rem;
    height: 2.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-subtle);
    border-radius: 50%;
    color: #fff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .ab-modal__close:hover { background: var(--color-accent-surface); border-color: var(--color-accent); }
  .ab-bio__photo {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-accent);
    margin-bottom: 1rem;
  }
  .ab-bio__name {
    color: #fff;
    font-size: 1.6rem;
    margin: 0 0 0.25rem;
  }
  .ab-bio__title {
    color: var(--color-accent);
    font-weight: var(--fw-semibold);
    margin: 0 0 1.5rem;
  }
  .ab-bio__para {
    color: var(--color-text-muted);
    line-height: 1.75;
    margin: 0 0 1.1rem;
  }
  .ab-bio__para:last-child { margin-bottom: 0; }
</style>

<script>
  function setupAboutBios() {
    const modal = document.getElementById("ab-bio-modal");
    if (!modal) return;
    const contents = modal.querySelectorAll<HTMLElement>("[data-bio-content]");

    function open(slug: string) {
      contents.forEach((el) => {
        el.hidden = el.dataset.bioContent !== slug;
      });
      modal!.hidden = false;
      document.body.style.overflow = "hidden";
    }
    function close() {
      modal!.hidden = true;
      document.body.style.overflow = "";
    }

    document.querySelectorAll<HTMLButtonElement>("[data-bio]").forEach((btn) => {
      btn.addEventListener("click", () => open(btn.dataset.bio!));
    });
    modal.querySelectorAll<HTMLElement>("[data-close]").forEach((el) => {
      el.addEventListener("click", close);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.hidden) close();
    });
  }

  setupAboutBios();
  document.addEventListener("astro:after-swap", setupAboutBios);
</script>
