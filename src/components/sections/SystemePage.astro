---
/**
 * Business-systems page. Shared by /unternehmenssysteme/, /en/business-systems/,
 * /tr/kurumsal-sistemler/ and /kk/kasiporyn-juieleri/.
 *
 * The order follows how somebody decides rather than how we like to present:
 * a scene they recognise, then self-selection (website or system?), then the
 * layers a system is made of, then proof they can click, then what it plugs
 * into, then the six phases of the work, then who we are, then what binds us,
 * then the objections, then one small first step.
 *
 * Two rules govern every picture on this page.
 *
 * 1. Nothing is a fake screenshot. The two systems further down carry client
 *    data behind a login, and a mocked-up "screenshot" of data that never
 *    existed would be the single dishonest element on a page whose entire
 *    argument is evidence. Every illustration here is therefore an obvious
 *    schematic, labelled as one, drawn in markup so it translates like copy.
 * 2. No figures. Not a conversion rate, not a saving, not a client's operating
 *    numbers. A number without a source invites the reader to hunt for the
 *    catch, and it is the one thing on a page like this that a competitor can
 *    attack under § 6 UWG. Where the web-design page shows counters, this page
 *    shows capability.
 *
 * Both pages must feel like the same house. The web-design page uses depth,
 * float and a warm glow; this one uses the same devices in the CI red only,
 * over a hairline data grid, because the department it sells is engineering.
 *
 * No prices. A system's price follows its scope, and the six phases are what
 * a price is made of — the FAQ says exactly that when somebody asks.
 */
import Button from '../ui/Button.astro';
import ContactBlock from './ContactBlock.astro';
import FaqSection from '../ui/FaqSection.astro';
import { systeme as s, systems, domains, modules, systemeFaq } from '../../data/systeme';
import type { Lang } from '../../i18n/config';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const domainLabel = (key: string) =>
  domains.find((d) => d.key === key)?.label[lang] ?? key;

/** Where the sibling department lives, per language. */
const webdesignHref = { de: '/webdesign/', en: '/en/webdesign/', tr: '/tr/webdesign/', kk: '/kk/veb-dizain/' }[lang];

const screenshotAlt = (name: string, client: string) =>
  lang === 'en'
    ? `Screenshot of the ${name} system, built for ${client}`
    : lang === 'tr'
      ? `${client} için geliştirilen ${name} sisteminin ekran görüntüsü`
      : lang === 'kk'
        ? `${client} үшін жасалған ${name} жүйесінің скриншоты`
        : `Screenshot des Systems ${name}, gebaut für ${client}`;

/** The keyword strip runs twice so the loop has no seam. */
const marquee = [...s.marquee, ...s.marquee];

/**
 * The workspace schematic beside the headline. Five rows, four states, one
 * row per state plus a repeat — enough to read as a list of work without
 * pretending to be a list of anything real. `w` is the width of the skeleton
 * bar, varied so the rows do not look generated.
 */
const consoleRows = [
  { state: s.hero.console.states.open, tone: 'open', w: [78, 54] },
  { state: s.hero.console.states.review, tone: 'review', w: [62, 70] },
  { state: s.hero.console.states.approved, tone: 'approved', w: [88, 46] },
  { state: s.hero.console.states.billed, tone: 'billed', w: [70, 62] },
  { state: s.hero.console.states.open, tone: 'open', w: [56, 74] },
];

const faq = systemeFaq[lang];
---

<!-- ============ HERO ============ -->
<section class="sy-hero">
  <div class="sy-hero__grid" aria-hidden="true"></div>
  <div class="sy-hero__glow" aria-hidden="true"></div>
  <div class="container sy-hero__inner">
    <div class="sy-hero__copy" data-reveal="up">
      <span class="sy-hero__badge">{s.hero.eyebrow[lang]}</span>
      <h1 class="sy-hero__title">
        <span class="sy-hero__title-a">{s.hero.title[lang]}</span>
        <span class="sy-hero__title-b">{s.hero.titleAccent[lang]}</span>
      </h1>
      <p class="sy-hero__lead">{s.hero.lead[lang]}</p>
      <div class="sy-hero__actions">
        <Button href="#kontakt" variant="primary" size="lg">{s.hero.ctaPrimary[lang]}</Button>
        <!-- "How we work" is the six phases, not the module explorer. The
             explorer is reached from the self-selection block below, where
             somebody who has just decided they need a system is standing. -->
        <Button href="#ablauf" variant="outline" size="lg">{s.hero.ctaSecondary[lang]}</Button>
      </div>
      <ul class="sy-hero__chips">
        {s.hero.chips.map((c) => (
          <li>
            <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span>{c[lang]}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Schematic workspace. Decorative: everything it says is said in words
         beside it, so it is hidden from assistive technology rather than
         narrated as a table that does not exist. -->
    <div class="sy-hero__stage" data-reveal="zoom" aria-hidden="true">
      <!-- The frame is exactly the size of the workspace, so the two callout
           cards can be anchored to its edges instead of to a stage whose
           height changes with the copy column beside it. -->
      <div class="sy-hero__frame">
      <figure class="sy-console">
        <span class="sy-console__bar">
          <i></i><i></i><i></i>
          <span class="sy-console__name">{s.hero.console.window[lang]}</span>
          <span class="sy-console__role">{s.hero.console.role[lang]}</span>
        </span>
        <div class="sy-console__body">
          <nav class="sy-console__nav">
            {s.hero.console.nav.map((n, i) => (
              <span class:list={['sy-console__navitem', { 'is-active': i === 1 }]}>
                <i></i>{n[lang]}
              </span>
            ))}
          </nav>
          <div class="sy-console__main">
            <div class="sy-console__head">
              <span>{s.hero.console.columns.case[lang]}</span>
              <span>{s.hero.console.columns.owner[lang]}</span>
              <span>{s.hero.console.columns.state[lang]}</span>
            </div>
            {consoleRows.map((r, i) => (
              <div class="sy-console__row" style={`--row: ${i}`}>
                <span class="sy-bar" style={`--w: ${r.w[0]}%`}></span>
                <span class="sy-bar sy-bar--dim" style={`--w: ${r.w[1]}%`}></span>
                <span class:list={['sy-state', `sy-state--${r.tone}`]}>{r.state[lang]}</span>
              </div>
            ))}
            <span class="sy-console__scan"></span>
          </div>
        </div>
      </figure>

      <figure class="sy-float sy-float--audit">
        <span class="sy-float__label">{s.hero.console.auditTitle[lang]}</span>
        <span class="sy-float__text">{s.hero.console.auditLine[lang]}</span>
      </figure>

      <figure class="sy-float sy-float--rights">
        <span class="sy-float__label">{s.hero.console.rightsTitle[lang]}</span>
        <span class="sy-float__text">{s.hero.console.rightsLine[lang]}</span>
      </figure>
      </div>
    </div>
  </div>

  <!-- The web-design page scrolls client sites past the reader because it
       sells appearance. This page sells substance, so it scrolls the
       vocabulary of the trade — every term of which a section below earns. -->
  <div class="sy-marquee" aria-hidden="true">
    <div class="sy-marquee__track">
      {marquee.map((t) => <span class="sy-marquee__item">{t[lang]}</span>)}
    </div>
  </div>
</section>

<!-- ============ WIEDERERKENNUNG ============ -->
<section class="section sy-symptoms">
  <div class="container">
    <div class="sy-head" data-reveal="up">
      <h2>{s.symptoms.heading[lang]}</h2>
      <p class="text-muted">{s.symptoms.intro[lang]}</p>
    </div>
    <ul class="sy-symptoms__list">
      {s.symptoms.items.map((item, i) => (
        <li data-reveal="up" data-reveal-delay={(i % 3) * 70}>
          <span class="sy-symptoms__source">{item.source[lang]}</span>
          <span class="sy-symptoms__text">{item.text[lang]}</span>
        </li>
      ))}
    </ul>
    <p class="sy-symptoms__close" data-reveal="up">{s.symptoms.close[lang]}</p>
  </div>
</section>

<!-- ============ WEBSITE ODER SYSTEM ============ -->
<section class="section section--alt sy-split">
  <div class="container">
    <div class="sy-head" data-reveal="up">
      <h2>{s.split.heading[lang]}</h2>
      <p class="text-muted">{s.split.intro[lang]}</p>
    </div>

    <div class="sy-split__grid">
      <article class="sy-choice" data-reveal="up">
        <!-- One page, many identical visitors. -->
        <svg class="sy-choice__fig" viewBox="0 0 200 88" aria-hidden="true">
          <rect x="70" y="14" width="60" height="60" rx="6" class="sy-fig-plate" />
          <line x1="78" y1="26" x2="122" y2="26" class="sy-fig-line" />
          <line x1="78" y1="36" x2="110" y2="36" class="sy-fig-line" />
          <line x1="78" y1="46" x2="118" y2="46" class="sy-fig-line" />
          <circle cx="24" cy="26" r="7" class="sy-fig-dot" />
          <circle cx="24" cy="44" r="7" class="sy-fig-dot" />
          <circle cx="24" cy="62" r="7" class="sy-fig-dot" />
          <path d="M33 26H66M33 44H66M33 62H66" class="sy-fig-arrow" />
        </svg>
        <h3 class="sy-choice__title">{s.split.website.title[lang]}</h3>
        <ul class="sy-choice__list">
          {s.split.website.points.map((p) => <li>{p[lang]}</li>)}
        </ul>
        <a class="sy-choice__link" href={webdesignHref}>
          {s.split.website.cta[lang]} <span aria-hidden="true">→</span>
        </a>
      </article>

      <article class="sy-choice sy-choice--accent" data-reveal="up" data-reveal-delay="80">
        <!-- Several roles, one record, a chain of states. -->
        <svg class="sy-choice__fig" viewBox="0 0 200 88" aria-hidden="true">
          <circle cx="20" cy="22" r="7" class="sy-fig-dot sy-fig-dot--a" />
          <circle cx="20" cy="44" r="7" class="sy-fig-dot sy-fig-dot--b" />
          <circle cx="20" cy="66" r="7" class="sy-fig-dot sy-fig-dot--c" />
          <path d="M29 22H60M29 44H60M29 66H60" class="sy-fig-arrow" />
          <rect x="64" y="30" width="34" height="28" rx="5" class="sy-fig-plate sy-fig-plate--hot" />
          <path d="M100 44h16" class="sy-fig-arrow" />
          <rect x="118" y="34" width="18" height="20" rx="4" class="sy-fig-step" />
          <path d="M138 44h8" class="sy-fig-arrow" />
          <rect x="148" y="34" width="18" height="20" rx="4" class="sy-fig-step" />
          <path d="M168 44h6" class="sy-fig-arrow" />
          <rect x="176" y="34" width="18" height="20" rx="4" class="sy-fig-step sy-fig-step--hot" />
        </svg>
        <h3 class="sy-choice__title">{s.split.system.title[lang]}</h3>
        <ul class="sy-choice__list">
          {s.split.system.points.map((p) => <li>{p[lang]}</li>)}
        </ul>
        <a class="sy-choice__link" href="#module">
          {s.split.system.cta[lang]} <span aria-hidden="true">↓</span>
        </a>
      </article>
    </div>

    <p class="sy-split__both text-muted" data-reveal="up">{s.split.both[lang]}</p>
  </div>
</section>

<!-- ============ MODUL-EXPLORER ============ -->
<section class="section sy-explorer" id="module">
  <div class="container">
    <div class="sy-head" data-reveal="up">
      <h2>{s.explorer.heading[lang]}</h2>
      <p class="text-muted">{s.explorer.intro[lang]}</p>
    </div>

    <div class="sy-explorer__shell" data-reveal="up">
      <div class="sy-tabs" role="tablist" aria-label={s.explorer.heading[lang]}>
        {modules.map((m, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${m.key}`}
            class:list={['sy-tab', { 'is-active': i === 0 }]}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${m.key}`}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="sy-tab__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span>{m.label[lang]}</span>
          </button>
        ))}
      </div>

      {modules.map((m, i) => (
        <div
          class="sy-panel"
          role="tabpanel"
          id={`panel-${m.key}`}
          aria-labelledby={`tab-${m.key}`}
          tabindex="0"
          hidden={i !== 0}
        >
          <div class="sy-panel__copy">
            <h3>{m.headline[lang]}</h3>
            <p class="text-muted">{m.text[lang]}</p>
            <ul class="sy-panel__points">
              {m.points.map((p) => (
                <li>
                  <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  <span>{p[lang]}</span>
                </li>
              ))}
            </ul>
          </div>

          <figure class="sy-diagram" aria-hidden="true">
            <figcaption class="sy-diagram__hint">{s.explorer.hint[lang]}</figcaption>

            {m.diagram === 'records' && (
              <div class="sy-dg sy-dg--records">
                <div class="sy-dg__head">
                  <span>{m.labels[0][lang]}</span><span>{m.labels[1][lang]}</span><span>{m.labels[2][lang]}</span>
                </div>
                <div class="sy-dg__row is-hot">
                  <span class="sy-bar" style="--w: 76%"></span>
                  <span class="sy-bar sy-bar--dim" style="--w: 58%"></span>
                  <span class="sy-tagpill">{m.labels[3][lang]}</span>
                </div>
                <div class="sy-dg__row"><span class="sy-bar" style="--w: 62%"></span><span class="sy-bar sy-bar--dim" style="--w: 70%"></span><span class="sy-bar sy-bar--dim" style="--w: 40%"></span></div>
                <div class="sy-dg__row"><span class="sy-bar" style="--w: 84%"></span><span class="sy-bar sy-bar--dim" style="--w: 48%"></span><span class="sy-bar sy-bar--dim" style="--w: 52%"></span></div>
                <div class="sy-dg__ghost">
                  <span class="sy-bar sy-bar--ghost" style="--w: 76%"></span>
                  <span class="sy-dg__reject">
                    <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 4l8 8M12 4l-8 8" /></svg>
                  </span>
                </div>
              </div>
            )}

            {m.diagram === 'workflow' && (
              <div class="sy-dg sy-dg--workflow">
                <ol class="sy-flow">
                  {m.labels.map((l, li) => (
                    <li class:list={['sy-flow__step', { 'is-hot': li === 2 }]}>
                      <span class="sy-flow__dot"></span>
                      <span class="sy-flow__label">{l[lang]}</span>
                    </li>
                  ))}
                </ol>
                <svg class="sy-flow__skip" viewBox="0 0 240 44" aria-hidden="true">
                  <path d="M28 34C70 4 170 4 212 34" class="sy-fig-arc" />
                  <path d="M112 12l16 16M128 12l-16 16" class="sy-fig-cross" />
                </svg>
              </div>
            )}

            {m.diagram === 'rights' && (
              <div class="sy-dg sy-dg--rights">
                <div class="sy-matrix">
                  <span></span>
                  <span class="sy-matrix__col">{m.labels[3][lang]}</span>
                  <span class="sy-matrix__col">{m.labels[4][lang]}</span>
                  <span class="sy-matrix__col">{m.labels[5][lang]}</span>

                  <span class="sy-matrix__row">{m.labels[0][lang]}</span>
                  <span class="sy-cell is-yes"></span><span class="sy-cell is-yes"></span><span class="sy-cell is-no"></span>

                  <span class="sy-matrix__row">{m.labels[1][lang]}</span>
                  <span class="sy-cell is-yes"></span><span class="sy-cell is-yes"></span><span class="sy-cell is-yes"></span>

                  <span class="sy-matrix__row">{m.labels[2][lang]}</span>
                  <span class="sy-cell is-yes"></span><span class="sy-cell is-no"></span><span class="sy-cell is-no"></span>
                </div>
              </div>
            )}

            {m.diagram === 'documents' && (
              <div class="sy-dg sy-dg--documents">
                <ol class="sy-trail">
                  {m.labels.map((l) => (
                    <li>
                      <span class="sy-trail__dot"></span>
                      <span class="sy-trail__doc">
                        <span class="sy-bar" style="--w: 68%"></span>
                        <span class="sy-bar sy-bar--dim" style="--w: 44%"></span>
                      </span>
                      <span class="sy-trail__label">{l[lang]}</span>
                      <span class="sy-bar sy-bar--dim" style="--w: 52%"></span>
                    </li>
                  ))}
                </ol>
              </div>
            )}

            {m.diagram === 'finance' && (
              <div class="sy-dg sy-dg--finance">
                <div class="sy-ledger">
                  <div class="sy-ledger__row"><span class="sy-ledger__key">{m.labels[0][lang]}</span><span class="sy-bar" style="--w: 82%"></span></div>
                  <div class="sy-ledger__row"><span class="sy-ledger__key">{m.labels[1][lang]}</span><span class="sy-bar sy-bar--dim" style="--w: 58%"></span></div>
                  <div class="sy-ledger__row is-hot"><span class="sy-ledger__key">{m.labels[2][lang]}</span><span class="sy-bar sy-bar--hot" style="--w: 24%"></span></div>
                </div>
                <p class="sy-dg__note">{m.labels[3][lang]}</p>
              </div>
            )}

            {m.diagram === 'api' && (
              <div class="sy-dg sy-dg--api">
                <div class="sy-endpoint"><span class="sy-verb">GET</span><span>{m.labels[0][lang]}</span></div>
                <div class="sy-endpoint"><span class="sy-verb">POST</span><span>{m.labels[1][lang]}</span></div>
                <div class="sy-endpoint"><span class="sy-verb sy-verb--event">EVENT</span><span>{m.labels[2][lang]}</span></div>
                <div class="sy-endpoint sy-endpoint--key">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="12" r="4" /><path d="M12 12h9M18 12v4" /></svg>
                  <span>{m.labels[3][lang]}</span>
                </div>
              </div>
            )}

            {m.diagram === 'insights' && (
              <div class="sy-dg sy-dg--insights">
                <div class="sy-tile">
                  <span class="sy-spark"><i style="--h: 42%"></i><i style="--h: 66%"></i><i style="--h: 50%"></i><i style="--h: 84%"></i><i style="--h: 72%"></i></span>
                  <span class="sy-tile__label">{m.labels[0][lang]}</span>
                </div>
                <div class="sy-tile sy-tile--empty">
                  <span class="sy-tile__dash">—</span>
                  <span class="sy-tile__label">{m.labels[1][lang]}</span>
                </div>
                <div class="sy-tile sy-tile--wide">
                  <span class="sy-bar" style="--w: 70%"></span>
                  <span class="sy-bar sy-bar--dim" style="--w: 52%"></span>
                  <span class="sy-tile__label">{m.labels[2][lang]}</span>
                </div>
              </div>
            )}
          </figure>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ============ SYSTEME IM EINSATZ ============ -->
<section class="section section--alt sy-portfolio" id="systeme">
  <div class="container">
    <div class="sy-head" data-reveal="up">
      <h2>{s.portfolio.heading[lang]}</h2>
      <p class="text-muted">{s.portfolio.intro[lang]}</p>
    </div>

    <div class="sy-grid">
      {systems.map((sys, i) => (
        <article class:list={['sy-card', { 'sy-card--featured': sys.featured }]} data-reveal="up" data-reveal-delay={i * 80}>
          <a class="sy-card__media" href={sys.url} target="_blank" rel="noopener noreferrer">
            <span class="sy-card__chrome" aria-hidden="true"><i></i><i></i><i></i></span>
            <img src={sys.image} alt={screenshotAlt(sys.name, sys.client[lang])} loading="lazy" width="1440" height="900" />
            {sys.featured && <span class="sy-card__badge">{s.portfolio.featuredLabel[lang]}</span>}
            <span class="sy-card__open" aria-hidden="true">{s.portfolio.live[lang]} ↗</span>
          </a>
          <div class="sy-card__body">
            <div class="sy-card__meta">
              <span class="sy-card__domain">{domainLabel(sys.domain)}</span>
              <span class="sy-card__client">{s.portfolio.clientLabel[lang]}: {sys.client[lang]}</span>
            </div>
            <h3 class="sy-card__name">{sys.name}</h3>
            <p class="sy-card__tagline">{sys.tagline[lang]}</p>
            <p class="sy-card__desc text-muted">{sys.description[lang]}</p>
            <ul class="sy-card__caps">
              {sys.capabilities.map((c) => <li>{c[lang]}</li>)}
            </ul>
            <a class="sy-card__link" href={sys.url} target="_blank" rel="noopener noreferrer">
              {s.portfolio.live[lang]} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============ SCHNITTSTELLEN ============ -->
<section class="section sy-orbit-sec">
  <div class="container sy-orbit-sec__inner">
    <div class="sy-orbit-sec__copy" data-reveal="up">
      <h2>{s.integrations.heading[lang]}</h2>
      <p class="text-muted">{s.integrations.intro[lang]}</p>
      <p class="sy-orbit-sec__note">{s.integrations.note[lang]}</p>
    </div>

    <div class="sy-orbit" data-reveal="zoom">
      <svg class="sy-orbit__rings" viewBox="0 0 400 400" aria-hidden="true">
        <circle cx="200" cy="200" r="118" class="sy-orbit__ring" />
        <circle cx="200" cy="200" r="168" class="sy-orbit__ring sy-orbit__ring--outer" />
        {[0, 1, 2, 3, 4, 5, 6, 7].map((n) => (
          <line
            x1="200"
            y1="200"
            x2={200 + 150 * Math.cos((n * 45 - 90) * Math.PI / 180)}
            y2={200 + 150 * Math.sin((n * 45 - 90) * Math.PI / 180)}
            class="sy-orbit__spoke"
            style={`--d: ${n * 0.35}s`}
          />
        ))}
      </svg>
      <span class="sy-orbit__core">{s.integrations.coreLabel[lang]}</span>
      <ul class="sy-orbit__list">
        {s.integrations.nodes.map((n, i) => (
          <li style={`--i: ${i}`}>{n[lang]}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- ============ ABLAUF ============ -->
<section class="section section--alt sy-process" id="ablauf">
  <div class="container">
    <div class="sy-head" data-reveal="up">
      <h2>{s.process.heading[lang]}</h2>
      <p class="text-muted">{s.process.intro[lang]}</p>
    </div>
    <ol class="sy-steps">
      <span class="sy-steps__rail" aria-hidden="true"><span class="sy-steps__fill"></span></span>
      {s.process.steps.map((step, i) => (
        <li class="sy-step" data-reveal="up" data-reveal-delay={(i % 3) * 70}>
          <span class="sy-step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="sy-step__body">
            <h3 class="sy-step__title">{step.title[lang]}</h3>
            <p class="sy-step__disciplines">{step.disciplines[lang]}</p>
            <p class="sy-step__text text-muted">{step.text[lang]}</p>
            <p class="sy-step__result">
              <span class="sy-step__result-label">{s.process.resultLabel[lang]}</span>
              {step.result[lang]}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

