<section class="section sy-orbit-sec">
  <div class="container sy-orbit-sec__inner">
    <div class="sy-orbit-sec__copy" data-reveal="up">
      <h2>{s.integrations.heading[lang]}</h2>
      <p class="text-muted">{s.integrations.intro[lang]}</p>
      <p class="sy-orbit-sec__note">{s.integrations.note[lang]}</p>
    </div>

    <!-- The docking sequence. Each area flies in along its spoke and the
         connection draws itself behind it; after all eight have docked the
         picture holds, then starts over. Ten seconds a cycle, begun when the
         diagram comes into view and stopped again when it leaves.

         WCAG 2.2.2 asks that motion which starts by itself and runs longer
         than five seconds can be stopped, so there is a real control for it —
         on a page that sells accessibility, an unstoppable loop would be an
         awkward thing to ship. -->
    <div class="sy-orbit" data-reveal="zoom">
      <svg class="sy-orbit__rings" viewBox="0 0 400 400" aria-hidden="true">
        <circle cx="200" cy="200" r="118" class="sy-orbit__ring" />
        <circle cx="200" cy="200" r="168" class="sy-orbit__ring sy-orbit__ring--outer" />
        {[0, 1, 2, 3, 4, 5, 6, 7].map((n) => (
          <line
            x1="200"
            y1="200"
            x2={200 + 150 * Math.cos((n * 45 - 90) * Math.PI / 180)}
            y2={200 + 150 * Math.sin((n * 45 - 90) * Math.PI / 180)}
            class="sy-orbit__spoke"
            style={`--i: ${n}`}
          />
        ))}
      </svg>
      <span class="sy-orbit__core">{s.integrations.coreLabel[lang]}</span>
      <ul class="sy-orbit__list">
        {s.integrations.nodes.map((n, i) => (
          <li style={`--i: ${i}`}>{n[lang]}</li>
        ))}
      </ul>
      <button
        type="button"
        class="sy-orbit__toggle"
        data-orbit-toggle
        data-play-label={s.hero.console.play[lang]}
        aria-pressed="false"
      >
        <svg class="sy-orbit__icon-pause" viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true"><rect x="3" y="2.5" width="3.6" height="11" rx="1" /><rect x="9.4" y="2.5" width="3.6" height="11" rx="1" /></svg>
        <svg class="sy-orbit__icon-play" viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M4 2.6l9 5.4-9 5.4z" /></svg>
        <span data-orbit-label>{s.hero.console.pause[lang]}</span>
      </button>
    </div>
  </div>
</section>

