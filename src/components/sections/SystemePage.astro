<style>
  /* ---------- shared ---------- */
  /* 760px, matching the web-design page — `ch` here would resolve against the
     body font and wrap the far larger headings after a handful of words. */
  .sy-head { max-width: 760px; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .sy-head h2 { font-size: var(--fs-h2); font-weight: var(--fw-bold); line-height: var(--lh-tight); margin-bottom: 1rem; text-wrap: balance; }
  .sy-head p { font-size: var(--fs-body); line-height: var(--lh-body); max-width: 62ch; }

  /* Skeleton bar used by every schematic. A width variable rather than a
     class per size, so a diagram row reads as data in the markup. */
  .sy-bar { display: block; height: 7px; width: var(--w, 60%); border-radius: 4px; background: rgba(255, 255, 255, 0.34); }
  .sy-bar--dim { background: rgba(255, 255, 255, 0.16); }
  .sy-bar--hot { background: var(--color-accent); }
  .sy-bar--ghost { background: rgba(255, 255, 255, 0.09); }
  .sy-constellation .sy-bar { height: 1.1cqi; border-radius: 0.6cqi; }

  /* ---------- hero ---------- */
  .sy-hero { position: relative; padding: clamp(3rem, 8vw, 6rem) 0 0; overflow: hidden; }
  /* Hairline data grid. The web-design hero uses a warm gradient because it
     sells appearance; this one uses a measured grid because it sells
     engineering, and both stay inside the single CI red. */
  .sy-hero__grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 68px 68px;
    -webkit-mask-image: radial-gradient(80% 70% at 60% 25%, #000 0%, transparent 78%);
    mask-image: radial-gradient(80% 70% at 60% 25%, #000 0%, transparent 78%);
    pointer-events: none;
  }
  .sy-hero__glow {
    position: absolute; inset: -25% -10% auto -15%; height: 135%;
    background:
      radial-gradient(48% 58% at 74% 22%, rgba(244, 14, 14, 0.3), transparent 70%),
      radial-gradient(42% 48% at 96% 52%, rgba(244, 14, 14, 0.16), transparent 72%),
      radial-gradient(58% 52% at 8% 6%, rgba(244, 14, 14, 0.12), transparent 70%);
    pointer-events: none;
  }
  .sy-hero__inner {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 1.02fr 0.98fr;
    gap: clamp(2rem, 5vw, 4.5rem); align-items: center;
    min-height: clamp(420px, 50vw, 620px);
  }
  .sy-hero__copy { max-width: 640px; }
  .sy-hero__badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: var(--fs-label); font-weight: var(--fw-semibold);
    letter-spacing: 0.12em; text-transform: uppercase; color: #fff;
    border: 1px solid rgba(244, 14, 14, 0.5); background: rgba(244, 14, 14, 0.1);
    border-radius: var(--radius-pill); padding: 0.4rem 0.95rem; margin-bottom: 1.25rem;
  }
  .sy-hero__badge::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--color-accent); box-shadow: 0 0 10px 2px rgba(244, 14, 14, 0.7); }
  .sy-hero__title {
    font-size: clamp(2.125rem, 1.543rem + 2.912vw, 4.6rem); font-weight: var(--fw-bold);
    line-height: 1.02; letter-spacing: -0.02em; margin-bottom: 1.2rem; text-wrap: balance;
  }
  .sy-hero__title-a { display: block; }

  /* --- the rotating line ---------------------------------------------
     All four words share one grid cell, so the box is as wide and as tall as
     the longest of them and nothing below shifts when they swap. Anything
     absolute here would collapse the line height; anything inline would make
     the paragraph jump on every change. */
  /* A block-level grid, so each line wraps inside its own cell instead of
     being an atomic inline box that gets pushed to the next line whole. */
  .sy-hero__rotator { display: grid; color: var(--color-accent); }
  .sy-hero__word {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(0.36em);
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
  }
  .sy-hero__word.is-current { opacity: 1; transform: none; }
  /* Leaving upwards, arriving from below: the line reads as a list being
     worked through rather than a crossfade. */
  .sy-hero__word.is-leaving { opacity: 0; transform: translateY(-0.36em); }
  .sy-hero__lead { font-size: clamp(1rem, 0.95rem + 0.257vw, 1.22rem); line-height: var(--lh-body); color: var(--color-text-muted); max-width: 56ch; }
  .sy-hero__actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2rem; }
  .sy-hero__chips { display: flex; flex-wrap: wrap; gap: 0.5rem 0.7rem; margin-top: clamp(1.6rem, 3vw, 2.4rem); list-style: none; }
  .sy-hero__chips li {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.4rem 0.85rem; font-size: var(--fs-label);
    color: var(--color-text-muted);
    border: 1px solid var(--border-subtle); border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.03);
  }
  .sy-hero__chips svg { color: var(--color-accent); flex: 0 0 auto; }

  /* ---------- hero constellation ----------
     One system and its other faces, which the reader connects themselves.

     Everything inside is sized in `cqi` — one percent of the constellation's
     own width — so the whole picture scales with the space it gets instead of
     being hidden on a phone, which is what used to happen. Text is the one
     exception: proportional scaling would take a 12px caption down to 6px at
     phone width, so type is clamped and the secondary line drops out below
     620px rather than becoming unreadable. A picture you cannot read is not a
     smaller picture, it is a worse one. */
  .sy-hero__stage { position: relative; }
  .sy-constellation {
    position: relative;
    /* Matches the wires' viewBox, so their scaling stays uniform. */
    aspect-ratio: 100 / 92;
    container-type: inline-size;
    /* Written by the pointer-parallax handler; 0 until then. */
    --px: 0; --py: 0;
  }
  /* Four boxes on one grid. The wires are drawn to these centres, so any
     change here needs the matching path moved too. */
  .sy-hero__frame {
    position: absolute; left: 0; top: 10%; width: 58%; z-index: 2;
    transform: translate3d(calc(var(--px) * -10px), calc(var(--py) * -8px), 0);
    transition: transform 0.5s var(--ease-out);
  }

  /* --- the connections ---
     `pathLength="100"` normalises every path, so one dash rule draws all three
     no matter how long each really is. They start fully undrawn and are filled
     in when their surface is connected. */
  .sy-wires { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 0; }
  .sy-wires path { fill: none; }
  .sy-wires__base path {
    stroke: rgba(244, 14, 14, 0.5); stroke-width: 0.4; stroke-linecap: round;
    stroke-dasharray: 100; stroke-dashoffset: 100;
    transition: stroke-dashoffset 0.75s var(--ease-out), stroke 0.4s;
  }
  .sy-wires__base path.is-on { stroke-dashoffset: 0; }
  /* A short dash travelling the drawn line: data moving, not a static wire. */
  .sy-wires__pulse path {
    stroke: var(--color-accent); stroke-width: 0.6; stroke-linecap: round;
    stroke-dasharray: 4 96; stroke-dashoffset: 0;
    opacity: 0; transition: opacity 0.4s 0.5s;
    filter: drop-shadow(0 0 0.6cqi rgba(244, 14, 14, 0.8));
  }
  .sy-wires__pulse path.is-on { opacity: 1; animation: sy-pulse 3.2s linear infinite; animation-delay: var(--d); }
  @keyframes sy-pulse { to { stroke-dashoffset: -100; } }

  /* --- the surfaces --- */
  .sy-sat {
    position: absolute; margin: 0; z-index: 1;
    display: flex; flex-direction: column; gap: 1.1cqi;
    padding: 1.7cqi;
    border-radius: 2cqi;
    background: rgba(18, 18, 18, 0.94);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 4cqi 9cqi rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(6px);
    font: inherit; text-align: left; cursor: pointer;
    /* Unconnected: present but inert. */
    filter: grayscale(1); opacity: 0.48;
    transition:
      opacity 0.45s var(--ease-out), filter 0.45s var(--ease-out),
      border-color 0.45s var(--ease-out), box-shadow 0.45s var(--ease-out),
      transform 0.5s var(--ease-out);
  }
  .sy-sat[aria-pressed='true'] {
    filter: none; opacity: 1;
    border-color: rgba(244, 14, 14, 0.5);
    box-shadow: 0 4cqi 9cqi rgba(0, 0, 0, 0.6), 0 0 6cqi -2cqi rgba(244, 14, 14, 0.6);
  }
  .sy-sat:hover { opacity: 0.75; }
  .sy-sat[aria-pressed='true']:hover { opacity: 1; }
  .sy-sat:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  /* Wraps the mini interface so its parts keep their spacing now that the
     surface is a button rather than a figure. */
  .sy-sat__ui { display: grid; gap: 1cqi; }
  .sy-sat__label { display: flex; flex-direction: column; gap: 0.3cqi; }
  .sy-sat__label b {
    font-size: clamp(0.7rem, 1.85cqi, 0.8rem);
    font-weight: var(--fw-semibold); color: #fff; line-height: 1.25;
  }
  .sy-sat__line {
    font-size: clamp(0.6rem, 1.65cqi, 0.74rem);
    color: var(--color-text-subtle); line-height: 1.3;
  }
  /* The socket, on the edge that faces the workspace. */
  .sy-sat__plug {
    position: absolute; width: 2.2cqi; height: 2.2cqi; border-radius: 50%;
    border: 1px solid var(--border-strong); background: #0d0d0d;
    transition: background 0.4s, border-color 0.4s, box-shadow 0.4s;
  }
  .sy-sat[aria-pressed='true'] .sy-sat__plug {
    background: var(--color-accent); border-color: var(--color-accent);
    box-shadow: 0 0 0 1cqi rgba(244, 14, 14, 0.18);
  }

  .sy-sat--portal {
    left: 71%; top: 3%; width: 29%;
    /* Lighter, because this is the surface that faces outwards. */
    background: rgba(38, 38, 38, 0.95);
    transform: translate3d(calc(var(--px) * 16px), calc(var(--py) * 14px), 0);
    animation: sy-float 8.5s ease-in-out infinite;
  }
  .sy-sat--portal .sy-sat__plug { left: -1.1cqi; bottom: 22%; }
  .sy-sat__bar { display: flex; gap: 0.7cqi; }
  .sy-sat__bar i { width: 1cqi; height: 1cqi; border-radius: 50%; background: rgba(255, 255, 255, 0.28); }
  .sy-sat__body { display: grid; gap: 1cqi; padding: 0.6cqi 0 0.2cqi; }

  .sy-sat--field {
    left: 10%; top: 70%; width: 26%;
    transform: translate3d(calc(var(--px) * 22px), calc(var(--py) * 18px), 0);
    animation: sy-float 7s ease-in-out infinite reverse;
  }
  .sy-sat--field .sy-sat__plug { right: -1.1cqi; top: 12%; }
  .sy-phone {
    display: grid; gap: 1cqi; justify-items: stretch;
    padding: 0.9cqi 0.8cqi 1.1cqi;
    border-radius: 1.6cqi; border: 1px solid rgba(255, 255, 255, 0.18);
    background: #0d0d0d;
  }
  .sy-phone__notch { justify-self: center; width: 26%; height: 0.5cqi; border-radius: 1cqi; background: rgba(255, 255, 255, 0.25); margin-bottom: 0.3cqi; }
  /* Stands for the photo a field job carries as its evidence. */
  .sy-phone__shot {
    height: 5.5cqi; border-radius: 0.8cqi;
    background: linear-gradient(140deg, rgba(244, 14, 14, 0.3), rgba(255, 255, 255, 0.07));
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .sy-sat--board {
    left: 68%; top: 63%; width: 30%;
    transform: translate3d(calc(var(--px) * 13px), calc(var(--py) * -12px), 0);
    animation: sy-float 9.5s ease-in-out infinite;
  }
  .sy-sat--board .sy-sat__plug { left: -1.1cqi; top: 18%; }
  .sy-sat__spark { display: flex; align-items: flex-end; gap: 0.7cqi; height: 5.8cqi; }
  .sy-sat__spark i { flex: 1; height: var(--h); border-radius: 0.4cqi 0.4cqi 0 0; background: linear-gradient(180deg, var(--color-accent), rgba(244, 14, 14, 0.2)); }

  .sy-constellation__hint {
    margin-top: 1rem; text-align: center;
    font-size: var(--fs-label); color: var(--color-text-subtle);
    transition: color var(--dur-med);
  }
  .sy-constellation__hint.is-done { color: var(--color-accent-text); }

  .sy-console {
    position: relative; margin: 0; border-radius: 2.2cqi; overflow: hidden;
    background: linear-gradient(165deg, #191919, #101010);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 7cqi 15cqi rgba(0, 0, 0, 0.65), 0 5cqi 12cqi -6cqi rgba(244, 14, 14, 0.35);
    animation: sy-float 9s ease-in-out infinite;
  }
  .sy-console__bar {
    display: flex; align-items: center; gap: 1cqi;
    height: 5.2cqi; padding: 0 1.9cqi;
    background: #151515; border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .sy-console__bar i { width: 1.3cqi; height: 1.3cqi; border-radius: 50%; background: rgba(255, 255, 255, 0.2); flex: 0 0 auto; }
  .sy-console__bar i:first-child { background: var(--color-accent); }
  .sy-console__name { margin-left: 0.9cqi; font-size: clamp(0.62rem, 1.85cqi, 0.8rem); color: rgba(255, 255, 255, 0.6); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sy-console__role {
    margin-left: auto; font-size: clamp(0.6rem, 1.75cqi, 0.76rem); letter-spacing: 0.05em;
    padding: 0.35cqi 1cqi; border-radius: var(--radius-pill); white-space: nowrap;
    color: var(--color-accent-text); border: 1px solid rgba(244, 14, 14, 0.4); background: rgba(244, 14, 14, 0.1);
  }
  .sy-console__body { display: grid; grid-template-columns: minmax(0, 0.32fr) 1fr; min-height: 32cqi; }
  .sy-console__nav { display: flex; flex-direction: column; gap: 0.25cqi; padding: 1.3cqi 0.8cqi; border-right: 1px solid rgba(255, 255, 255, 0.07); background: rgba(255, 255, 255, 0.015); }
  .sy-console__navitem {
    display: flex; align-items: center; gap: 0.8cqi;
    padding: 0.7cqi 0.9cqi; border-radius: 1.1cqi;
    font-size: clamp(0.6rem, 1.8cqi, 0.78rem); color: rgba(255, 255, 255, 0.45); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .sy-console__navitem i { width: 0.8cqi; height: 0.8cqi; border-radius: 50%; background: currentColor; flex: 0 0 auto; }
  .sy-console__navitem.is-active { color: #fff; background: rgba(244, 14, 14, 0.14); box-shadow: inset 0.35cqi 0 0 var(--color-accent); }
  .sy-console__main { position: relative; padding: 1.3cqi 1.6cqi 1.6cqi; overflow: hidden; }
  .sy-console__head, .sy-console__row {
    display: grid; grid-template-columns: 1fr 0.72fr 0.62fr; gap: 1.1cqi; align-items: center;
  }
  .sy-console__head { padding-bottom: 0.9cqi; border-bottom: 1px solid rgba(255, 255, 255, 0.08); font-size: clamp(0.58rem, 1.7cqi, 0.74rem); letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255, 255, 255, 0.35); }
  .sy-console__row { padding: 0.9cqi 0; border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
  .sy-state {
    justify-self: start; font-size: clamp(0.58rem, 1.7cqi, 0.74rem); letter-spacing: 0.03em;
    padding: 0.35cqi 0.9cqi; border-radius: var(--radius-pill);
    border: 1px solid currentColor; opacity: 0.9; white-space: nowrap;
  }
  .sy-state--open { color: rgba(255, 255, 255, 0.5); }
  .sy-state--review { color: rgba(255, 255, 255, 0.72); }
  .sy-state--approved { color: var(--color-accent-text); background: rgba(244, 14, 14, 0.12); }
  .sy-state--billed { color: rgba(255, 255, 255, 0.4); }
  /* A single band travelling down the rows: enough motion to read as "live"
     without animating anything that looks like changing data. */
  .sy-console__scan {
    position: absolute; left: 0; right: 0; top: 0; height: 7cqi;
    background: linear-gradient(180deg, transparent, rgba(244, 14, 14, 0.09), transparent);
    animation: sy-scan 5.5s ease-in-out infinite;
    pointer-events: none;
  }

  /* The drift is a share of the picture, not a fixed 12px — at phone size that
     was enough to push the portal out through the top edge. */
  @keyframes sy-float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -1.7cqi; } }

  /* --- the schematic gets simpler rather than smaller ---
     Below roughly a phone's worth of width, the workspace cannot show a
     sidebar, three column headings and four word-long state pills without
     dropping its type to 8px. So it stops trying: the sidebar goes, the
     headings go, and each state becomes the coloured dot it always was. The
     picture still says "rows of work, each in a state" — it just says it
     without asking anyone to read 8px. */
  @container (max-width: 460px) {
    .sy-console__nav { display: none; }
    .sy-console__body { grid-template-columns: 1fr; }
    .sy-console__head { display: none; }
    .sy-console__role { display: none; }
    .sy-console__row { grid-template-columns: 1fr 0.55fr auto; padding: 1.2cqi 0; }
    .sy-state {
      font-size: 0; padding: 0; border: 0;
      width: 2.2cqi; height: 2.2cqi; border-radius: 50%;
      background: currentColor; opacity: 1;
    }
    .sy-state--open { color: rgba(255, 255, 255, 0.38); }
    .sy-state--approved { color: var(--color-accent); }
    .sy-console__main { padding: 1.8cqi; }
  }
  @keyframes sy-scan { 0% { transform: translateY(-9cqi); } 55%, 100% { transform: translateY(36cqi); } }

  /* ---------- keyword marquee ---------- */
  .sy-marquee {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-block: 0.9rem;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    overflow: hidden;
  }
  .sy-marquee__track { display: flex; align-items: center; gap: 2.4rem; width: max-content; animation: sy-scroll 46s linear infinite; }
  .sy-marquee:hover .sy-marquee__track { animation-play-state: paused; }
  .sy-marquee__item {
    display: inline-flex; align-items: center; gap: 0.7rem;
    font-size: var(--fs-small); letter-spacing: 0.04em; color: var(--color-text-muted); white-space: nowrap;
  }
  .sy-marquee__item::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--color-accent); }
  @keyframes sy-scroll { from { transform: translateX(0); } to { transform: translateX(calc(-50% - 1.2rem)); } }

  /* ---------- wiedererkennung ---------- */
  .sy-symptoms__list { list-style: none; display: grid; gap: 0.85rem; max-width: 64rem; }
  .sy-symptoms__list li {
    display: grid; grid-template-columns: minmax(8.5rem, auto) 1fr; gap: 1.2rem; align-items: center;
    padding: clamp(1rem, 2vw, 1.35rem) clamp(1.1rem, 2.5vw, 1.6rem);
    border: 1px solid var(--border-subtle); border-radius: var(--radius-md);
    background: var(--surface-card);
    font-size: var(--fs-body); line-height: var(--lh-body);
    transition: border-color var(--dur-med) var(--ease-out), transform var(--dur-med) var(--ease-out);
  }
  .sy-symptoms__list li:hover { border-color: rgba(244, 14, 14, 0.4); transform: translateX(4px); }
  /* Where the knowledge actually lives today. Naming the place turns an
     abstract complaint into something the reader can picture. */
  .sy-symptoms__source {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: var(--fs-label); letter-spacing: 0.09em; text-transform: uppercase;
    color: var(--color-accent-text); font-weight: var(--fw-semibold);
  }
  .sy-symptoms__source::before { content: ''; width: 1.4rem; height: 2px; background: currentColor; flex: 0 0 auto; }
  .sy-symptoms__close { margin-top: 1.6rem; max-width: 60ch; color: var(--color-text-muted); font-size: var(--fs-body); }

  .sy-eyebrow {
    display: inline-block; margin-bottom: 0.8rem;
    font-size: var(--fs-label); font-weight: var(--fw-semibold);
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-accent-text);
  }

  /* ---------- ohne system / mit system ---------- */
  .sy-vs__table { display: grid; gap: 0.7rem; }
  .sy-vs__head, .sy-vs__row {
    display: grid; grid-template-columns: minmax(9rem, 0.7fr) 1fr 1fr; gap: 1rem;
    align-items: stretch;
  }
  .sy-vs__head { padding: 0 clamp(1rem, 2vw, 1.4rem); }
  .sy-vs__label {
    font-size: var(--fs-label); font-weight: var(--fw-semibold);
    letter-spacing: 0.1em; text-transform: uppercase;
    padding-bottom: 0.5rem;
  }
  .sy-vs__label--without { color: var(--color-text-subtle); }
  .sy-vs__label--with { color: var(--color-accent-text); }
  .sy-vs__row {
    padding: clamp(1rem, 2vw, 1.35rem) clamp(1rem, 2vw, 1.4rem);
    border: 1px solid var(--border-subtle); border-radius: var(--radius-md);
    background: var(--surface-card);
    transition: border-color var(--dur-med) var(--ease-out);
  }
  .sy-vs__row:hover { border-color: rgba(244, 14, 14, 0.35); }
  .sy-vs__topic { font-weight: var(--fw-semibold); color: #fff; line-height: var(--lh-snug); align-self: center; }
  .sy-vs__cell {
    display: grid; grid-template-columns: auto 1fr; gap: 0.7rem;
    align-items: start; line-height: var(--lh-body); font-size: var(--fs-body);
  }
  /* The left column is the state being left behind, so it is written in the
     muted voice; the right one carries the accent. */
  .sy-vs__cell--without { color: var(--color-text-muted); }
  .sy-vs__cell--with { color: var(--color-text); }
  .sy-vs__mark {
    display: grid; place-items: center; width: 20px; height: 20px;
    border-radius: 50%; margin-top: 0.1em;
  }
  .sy-vs__mark--without { color: var(--color-text-subtle); border: 1px solid var(--border-strong); }
  .sy-vs__mark--with { color: var(--color-accent-text); border: 1px solid rgba(244, 14, 14, 0.5); background: rgba(244, 14, 14, 0.12); }
  /* Both the label and the text live in the second column, so the mark keeps
     the first one to itself and nothing wraps underneath it. */
  .sy-vs__text { grid-column: 2; }
  /* Shown only once the row stacks, where the column headings are out of
     sight and each half has to say which side it is. */
  .sy-vs__mobile-label { display: none; }
  .sy-vs__honest {
    margin-top: 1.75rem; max-width: 68ch;
    padding: clamp(1.1rem, 2vw, 1.5rem) clamp(1.2rem, 2.5vw, 1.7rem);
    border: 1px dashed var(--border-strong); border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.02);
  }
  .sy-vs__honest h3 { font-size: var(--fs-body); font-weight: var(--fw-bold); margin-bottom: 0.5rem; }
  .sy-vs__honest p { color: var(--color-text-muted); line-height: var(--lh-body); font-size: var(--fs-body); }

  /* ---------- website oder system ---------- */
  .sy-split__grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); }
  .sy-choice {
    display: flex; flex-direction: column; gap: 1.1rem;
    padding: clamp(1.5rem, 3vw, 2.1rem);
    background: var(--surface-card); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }
  /* Only the system side is lifted — this page is about systems, and one
     accented card reads as an answer while two read as a menu. */
  .sy-choice--accent { border-color: var(--color-accent); box-shadow: var(--shadow-accent); }
  .sy-choice__fig { width: 100%; max-width: 20rem; height: auto; }
  .sy-fig-plate { fill: rgba(255, 255, 255, 0.05); stroke: rgba(255, 255, 255, 0.28); stroke-width: 1.4; }
  .sy-fig-plate--hot { fill: rgba(244, 14, 14, 0.12); stroke: var(--color-accent); }
  .sy-fig-line { stroke: rgba(255, 255, 255, 0.22); stroke-width: 3; stroke-linecap: round; }
  .sy-fig-dot { fill: rgba(255, 255, 255, 0.16); stroke: rgba(255, 255, 255, 0.4); stroke-width: 1.2; }
  .sy-fig-dot--a { fill: rgba(244, 14, 14, 0.35); stroke: var(--color-accent); }
  .sy-fig-dot--b { fill: rgba(244, 14, 14, 0.2); stroke: var(--color-accent); }
  .sy-fig-dot--c { fill: rgba(244, 14, 14, 0.08); stroke: var(--color-accent); }
  .sy-fig-arrow { stroke: rgba(255, 255, 255, 0.3); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .sy-fig-step { fill: rgba(255, 255, 255, 0.05); stroke: rgba(255, 255, 255, 0.28); stroke-width: 1.3; }
  .sy-fig-step--hot { fill: rgba(244, 14, 14, 0.16); stroke: var(--color-accent); }
  .sy-choice__title { font-size: var(--fs-h4); font-weight: var(--fw-bold); line-height: var(--lh-snug); }
  .sy-choice__list { list-style: none; display: flex; flex-direction: column; gap: 0.7rem; margin-top: auto; }
  .sy-choice__list li { position: relative; padding-left: 1.6rem; color: var(--color-text-muted); line-height: var(--lh-body); }
  .sy-choice__list li::before {
    content: ''; position: absolute; left: 0; top: 0.55em;
    width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--color-accent);
  }
  .sy-choice__link {
    align-self: flex-start; font-weight: var(--fw-semibold); color: var(--color-accent-text);
    text-decoration: none; border-bottom: 1px solid transparent; transition: border-color var(--dur-fast) var(--ease-out);
  }
  .sy-choice__link:hover, .sy-choice__link:focus-visible { border-bottom-color: currentColor; }
  .sy-split__both { margin-top: 1.75rem; max-width: 66ch; }

  /* ---------- modul-explorer ---------- */
  .sy-explorer__shell {
    border: 1px solid var(--border-subtle); border-radius: var(--radius-lg);
    background: var(--surface-card); overflow: hidden;
  }
  .sy-tabs {
    display: flex; gap: 0.35rem; padding: 0.6rem;
    border-bottom: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.015);
    overflow-x: auto; scroll-snap-type: x proximity;
  }
  .sy-tab {
    display: inline-flex; align-items: center; gap: 0.55rem;
    flex: 0 0 auto; scroll-snap-align: start;
    padding: 0.7rem 1.05rem; border-radius: var(--radius-pill);
    border: 1px solid transparent; background: transparent;
    color: var(--color-text-muted); font: inherit; font-size: var(--fs-small); font-weight: var(--fw-semibold);
    cursor: pointer; white-space: nowrap;
    transition: color var(--dur-fast), background var(--dur-fast), border-color var(--dur-fast);
  }
  .sy-tab__num { font-size: var(--fs-label); letter-spacing: 0.06em; color: var(--color-accent-text); font-variant-numeric: tabular-nums; }
  .sy-tab:hover { color: var(--color-text); border-color: var(--border-subtle); }
  .sy-tab.is-active { color: #fff; background: rgba(244, 14, 14, 0.14); border-color: rgba(244, 14, 14, 0.5); }
  .sy-tab.is-active .sy-tab__num { color: #fff; }

  .sy-panel {
    display: grid; grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(1.5rem, 4vw, 3rem); align-items: center;
    padding: clamp(1.6rem, 4vw, 3rem);
  }
  /* A class selector outranks the user-agent rule for [hidden], so without
     this line every panel stays on screen and the tablist does nothing. */
  .sy-panel[hidden] { display: none; }
  .sy-panel:focus-visible { outline-offset: -4px; }
  .sy-panel__copy h3 { font-size: var(--fs-h3); font-weight: var(--fw-bold); line-height: var(--lh-snug); margin-bottom: 0.9rem; text-wrap: balance; }
  .sy-panel__copy p { line-height: var(--lh-body); max-width: 52ch; }
  .sy-panel__points { list-style: none; display: grid; gap: 0.7rem; margin-top: 1.5rem; }
  .sy-panel__points li { display: flex; gap: 0.7rem; align-items: flex-start; line-height: 1.5; font-size: var(--fs-body); }
  .sy-panel__points svg { flex: 0 0 auto; margin-top: 0.15rem; color: var(--color-accent); }

  /* ---------- szenario je schicht ---------- */
  .sy-case { margin-top: 1.6rem; padding-top: 1.3rem; border-top: 1px solid var(--border-subtle); }
  .sy-case__beats { list-style: none; display: grid; gap: 0.9rem; counter-reset: none; }
  .sy-case__beat { display: grid; grid-template-columns: auto 1fr; gap: 0.9rem; align-items: start; }
  .sy-case__beat::before {
    content: ''; width: 3px; border-radius: 2px; align-self: stretch;
    background: var(--border-strong);
  }
  .sy-case__beat--bad::before { background: rgba(255, 255, 255, 0.14); }
  .sy-case__beat--good::before { background: var(--color-accent); }
  .sy-case__label {
    grid-column: 2; display: block; margin-bottom: 0.2rem;
    font-size: var(--fs-label); font-weight: var(--fw-semibold);
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-text-subtle);
  }
  .sy-case__beat--good .sy-case__label { color: var(--color-accent-text); }
  .sy-case__beat p { grid-column: 2; font-size: var(--fs-body); line-height: var(--lh-body); color: var(--color-text-muted); }
  .sy-case__beat--good p { color: var(--color-text); }

  /* ---------- stimmen ---------- */
  .sy-voices__grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); }
  .sy-voice {
    display: flex; flex-direction: column; gap: 1rem; margin: 0;
    padding: clamp(1.4rem, 2.5vw, 1.9rem);
    border: 1px solid var(--border-subtle); border-radius: var(--radius-md);
    background: var(--surface-card);
  }
  .sy-voice__system {
    align-self: flex-start; font-size: var(--fs-label); font-weight: var(--fw-semibold);
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent-text);
    padding: 0.25rem 0.6rem; border: 1px solid rgba(244, 14, 14, 0.4);
    border-radius: var(--radius-pill); background: rgba(244, 14, 14, 0.1);
  }
  .sy-voice blockquote { display: grid; gap: 0.85rem; margin: 0; }
  .sy-voice__tag {
    display: block; margin-bottom: 0.2rem;
    font-size: var(--fs-label); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-text-subtle);
  }
  .sy-voice__before { color: var(--color-text-muted); line-height: var(--lh-body); font-size: var(--fs-body); }
  .sy-voice__after {
    color: var(--color-text); line-height: var(--lh-body); font-size: var(--fs-body);
    padding-left: 0.9rem; border-left: 2px solid var(--color-accent);
  }
  .sy-voice figcaption { margin-top: auto; display: flex; flex-direction: column; gap: 0.15rem; padding-top: 0.4rem; }
  .sy-voice figcaption b { font-size: var(--fs-body); }
  .sy-voice figcaption span { font-size: var(--fs-small); color: var(--color-text-subtle); }

  /* ---------- schematics ---------- */
  .sy-diagram {
    position: relative; margin: 0; padding: clamp(1.2rem, 2.5vw, 1.9rem);
    border: 1px solid var(--border-subtle); border-radius: var(--radius-md);
    background: linear-gradient(165deg, #151515, #0e0e0e);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    min-height: 15rem; display: flex; flex-direction: column; justify-content: center;
  }
  /* Says out loud what the picture is. A page that argues from evidence
     cannot afford an illustration somebody could mistake for a screenshot. */
  .sy-diagram__hint {
    position: absolute; top: 0.75rem; right: 0.9rem;
    font-size: var(--fs-micro); letter-spacing: 0.09em; text-transform: uppercase;
    color: var(--color-text-subtle);
    padding: 0.2rem 0.55rem; border: 1px dashed var(--border-strong); border-radius: var(--radius-pill);
  }
  .sy-dg { display: grid; gap: 0.55rem; margin-top: 1.4rem; }
  .sy-dg__head, .sy-dg__row { display: grid; grid-template-columns: 1fr 0.8fr 0.8fr; gap: 0.8rem; align-items: center; }
  .sy-dg__head { font-size: var(--fs-micro); letter-spacing: 0.09em; text-transform: uppercase; color: var(--color-text-subtle); padding-bottom: 0.5rem; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .sy-dg__row { padding: 0.6rem 0.5rem; border-radius: 8px; }
  .sy-dg__row.is-hot { background: rgba(244, 14, 14, 0.09); box-shadow: inset 2px 0 0 var(--color-accent); }
  .sy-tagpill { justify-self: start; font-size: var(--fs-micro); padding: 0.2rem 0.55rem; border-radius: var(--radius-pill); color: var(--color-accent-text); border: 1px solid rgba(244, 14, 14, 0.45); background: rgba(244, 14, 14, 0.1); white-space: nowrap; }
  /* The rejected duplicate. A strike-through over a 7px bar just repainted
     part of it; a cross beside a dimmed row says "caught and refused" at a
     glance. */
  .sy-dg__ghost { display: grid; grid-template-columns: 1fr auto; gap: 0.8rem; align-items: center; padding: 0.6rem 0.5rem; opacity: 0.75; }
  .sy-dg__reject {
    display: grid; place-items: center; width: 20px; height: 20px;
    border-radius: 50%; color: var(--color-accent-text);
    border: 1px solid rgba(244, 14, 14, 0.5); background: rgba(244, 14, 14, 0.12);
  }
  .sy-dg__note { margin-top: 0.9rem; font-size: var(--fs-micro); color: var(--color-text-subtle); }

  .sy-flow { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.4rem; }
  .sy-flow__step { display: flex; flex-direction: column; align-items: center; gap: 0.55rem; position: relative; }
  .sy-flow__step:not(:last-child)::after {
    content: ''; position: absolute; top: 6px; left: calc(50% + 12px); right: calc(-50% + 12px);
    height: 1px; background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.3) 0 4px, transparent 4px 8px);
  }
  .sy-flow__dot { width: 13px; height: 13px; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.35); background: #101010; }
  .sy-flow__step.is-hot .sy-flow__dot { border-color: var(--color-accent); background: var(--color-accent); box-shadow: 0 0 0 5px rgba(244, 14, 14, 0.16); }
  .sy-flow__label { font-size: var(--fs-micro); color: var(--color-text-muted); text-align: center; line-height: 1.3; }
  .sy-flow__step.is-hot .sy-flow__label { color: #fff; }
  .sy-flow__skip { width: 100%; height: auto; margin-top: 0.1rem; }
  .sy-fig-arc { fill: none; stroke: rgba(255, 255, 255, 0.2); stroke-width: 1.4; stroke-dasharray: 5 5; }
  .sy-fig-cross { stroke: var(--color-accent); stroke-width: 2.2; stroke-linecap: round; }

  .sy-matrix { display: grid; grid-template-columns: minmax(6.5rem, 1.2fr) repeat(3, 1fr); gap: 0.55rem 0.8rem; align-items: center; }
  .sy-matrix__col { font-size: var(--fs-micro); letter-spacing: 0.07em; text-transform: uppercase; color: var(--color-text-subtle); text-align: center; }
  .sy-matrix__row { font-size: var(--fs-micro); color: var(--color-text-muted); }
  .sy-cell { justify-self: center; width: 20px; height: 20px; border-radius: 6px; border: 1px solid rgba(255, 255, 255, 0.16); position: relative; }
  .sy-cell.is-yes { border-color: rgba(244, 14, 14, 0.6); background: rgba(244, 14, 14, 0.16); }
  /* A wider-than-tall corner rotated 45° reads as a tick; a square one reads
     as a downward chevron, which is not the same symbol. */
  .sy-cell.is-yes::after {
    content: ''; position: absolute; left: 50%; top: 45%;
    width: 9px; height: 5px;
    border-left: 2px solid var(--color-accent-text);
    border-bottom: 2px solid var(--color-accent-text);
    transform: translate(-50%, -50%) rotate(-45deg);
  }
  .sy-cell.is-no::after { content: ''; position: absolute; left: 4px; right: 4px; top: 50%; height: 1px; background: rgba(255, 255, 255, 0.22); }

  .sy-trail { list-style: none; display: grid; gap: 0.9rem; }
  /* The trailing bar stands for the person and timestamp every entry carries;
     it also stops the row from ending in dead space halfway across the panel. */
  .sy-trail li { display: grid; grid-template-columns: auto auto auto 1fr; gap: 0.9rem; align-items: center; position: relative; }
  .sy-trail li:not(:last-child)::before { content: ''; position: absolute; left: 5px; top: 18px; bottom: -16px; width: 1px; background: repeating-linear-gradient(180deg, rgba(244, 14, 14, 0.5) 0 4px, transparent 4px 8px); }
  .sy-trail__dot { width: 11px; height: 11px; border-radius: 50%; border: 2px solid var(--color-accent); background: #101010; }
  .sy-trail__doc { display: grid; gap: 5px; width: 54px; padding: 8px 7px; border-radius: 5px; border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.03); }
  .sy-trail__label { font-size: var(--fs-micro); color: var(--color-text-muted); }

  .sy-ledger { display: grid; gap: 0.75rem; }
  .sy-ledger__row { display: grid; grid-template-columns: minmax(6rem, 0.55fr) 1fr; gap: 1rem; align-items: center; padding: 0.55rem 0.6rem; border-radius: 8px; }
  .sy-ledger__row.is-hot { background: rgba(244, 14, 14, 0.09); box-shadow: inset 2px 0 0 var(--color-accent); }
  .sy-ledger__key { font-size: var(--fs-micro); color: var(--color-text-muted); }
  .sy-ledger__row.is-hot .sy-ledger__key { color: #fff; }

  .sy-dg--api { gap: 0.5rem; }
  .sy-endpoint { display: flex; align-items: center; gap: 0.8rem; padding: 0.65rem 0.8rem; border: 1px solid var(--border-subtle); border-radius: 9px; font-size: var(--fs-micro); color: var(--color-text-muted); background: rgba(255, 255, 255, 0.02); }
  .sy-verb { font-size: var(--fs-micro); font-weight: var(--fw-bold); letter-spacing: 0.08em; padding: 0.2rem 0.5rem; border-radius: 5px; color: var(--color-accent-text); background: rgba(244, 14, 14, 0.12); border: 1px solid rgba(244, 14, 14, 0.4); min-width: 3.4rem; text-align: center; }
  .sy-verb--event { color: #fff; background: var(--color-accent-surface); border-color: var(--color-accent-surface); }
  .sy-endpoint--key { border-style: dashed; color: var(--color-accent-text); }

  .sy-dg--insights { grid-template-columns: 1fr 1fr; }
  .sy-tile { display: flex; flex-direction: column; justify-content: flex-end; gap: 0.6rem; min-height: 6.2rem; padding: 0.9rem; border: 1px solid var(--border-subtle); border-radius: 10px; background: rgba(255, 255, 255, 0.02); }
  .sy-tile--wide { grid-column: 1 / -1; }
  .sy-tile--empty { border-style: dashed; }
  .sy-tile__label { font-size: var(--fs-micro); color: var(--color-text-subtle); line-height: 1.35; }
  .sy-tile__dash { font-size: 1.6rem; color: var(--color-text-subtle); line-height: 1; }
  .sy-spark { display: flex; align-items: flex-end; gap: 5px; height: 46px; }
  .sy-spark i { width: 9px; height: var(--h); border-radius: 3px 3px 0 0; background: linear-gradient(180deg, var(--color-accent), rgba(244, 14, 14, 0.25)); }

  /* ---------- systeme ---------- */
  .sy-grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(21rem, 1fr)); }
  .sy-card {
    display: flex; flex-direction: column;
    background: var(--surface-card); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md); overflow: hidden;
    transition: border-color var(--dur-med) var(--ease-out), transform var(--dur-med) var(--ease-out), box-shadow var(--dur-med) var(--ease-out);
  }
  .sy-card:hover { border-color: rgba(244, 14, 14, 0.45); transform: translateY(-6px); box-shadow: 0 30px 70px -34px rgba(0, 0, 0, 0.9), 0 20px 60px -36px rgba(244, 14, 14, 0.5); }
  .sy-card:focus-within { border-color: var(--color-accent); }
  .sy-card--featured { border-color: var(--color-accent); }
  .sy-card__media { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--color-bg-elevated); }
  /* Application chrome rather than browser chrome: the systems are software
     somebody logs into, and the frame should say so before the copy does. */
  .sy-card__chrome { position: absolute; inset: 0 0 auto 0; z-index: 2; display: flex; align-items: center; gap: 5px; height: 24px; padding: 0 10px; background: rgba(10, 10, 10, 0.92); border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .sy-card__chrome i { width: 7px; height: 7px; border-radius: 50%; background: rgba(255, 255, 255, 0.2); }
  .sy-card__chrome i:first-child { background: var(--color-accent); }
  .sy-card__media img { width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform var(--dur-med) var(--ease-out); }
  .sy-card:hover .sy-card__media img { transform: scale(1.04); }
  .sy-card__badge {
    position: absolute; top: 2.2rem; left: 0.9rem; z-index: 2;
    font-size: var(--fs-label); font-weight: var(--fw-semibold); letter-spacing: 0.1em; text-transform: uppercase;
    padding: 0.3rem 0.7rem; border-radius: var(--radius-pill);
    background: var(--color-accent-surface); color: #fff;
  }
  .sy-card__open {
    position: absolute; right: 0.9rem; bottom: 0.9rem; z-index: 2;
    padding: 0.4rem 0.8rem; font-size: var(--fs-label); font-weight: var(--fw-semibold);
    color: #fff; background: rgba(0, 0, 0, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.25); border-radius: var(--radius-pill);
    opacity: 0; transform: translateY(6px);
    transition: opacity var(--dur-fast), transform var(--dur-fast);
  }
  .sy-card__media:hover .sy-card__open, .sy-card__media:focus-visible .sy-card__open { opacity: 1; transform: none; }
  .sy-card__body { display: flex; flex-direction: column; gap: 0.75rem; padding: clamp(1.3rem, 2.5vw, 1.8rem); }
  .sy-card__meta { display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; font-size: var(--fs-label); letter-spacing: 0.06em; text-transform: uppercase; }
  .sy-card__domain { color: var(--color-accent-text); font-weight: var(--fw-semibold); }
  .sy-card__client { color: var(--color-text-subtle); }
  .sy-card__name { font-size: var(--fs-h4); font-weight: var(--fw-bold); line-height: var(--lh-snug); }
  .sy-card__tagline { font-weight: var(--fw-semibold); color: var(--color-text); }
  .sy-card__desc { line-height: var(--lh-body); }
  .sy-card__caps { list-style: none; display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.2rem; }
  .sy-card__caps li {
    font-size: var(--fs-label); padding: 0.28rem 0.65rem;
    border: 1px solid var(--border-strong); border-radius: var(--radius-pill);
    color: var(--color-text-muted);
  }
  .sy-card__link {
    align-self: flex-start; margin-top: auto; padding-top: 0.4rem; font-weight: var(--fw-semibold);
    color: var(--color-accent-text); text-decoration: none;
    border-bottom: 1px solid transparent; transition: border-color var(--dur-fast) var(--ease-out);
  }
  .sy-card__link:hover, .sy-card__link:focus-visible { border-bottom-color: currentColor; }

  /* ---------- schnittstellen ---------- */
  .sy-orbit-sec__inner { display: grid; grid-template-columns: 1fr 0.95fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .sy-orbit-sec__copy h2 { font-size: var(--fs-h2); font-weight: var(--fw-bold); line-height: var(--lh-tight); margin-bottom: 1rem; text-wrap: balance; }
  .sy-orbit-sec__copy p { line-height: var(--lh-body); max-width: 56ch; }
  .sy-orbit-sec__note { margin-top: 1.2rem; padding-left: 1rem; border-left: 2px solid var(--color-accent); font-size: var(--fs-body); color: var(--color-text-muted); }

  /* A container so the ring radius can be expressed as a share of the circle
     (`cqi`). A percentage in `translate` would resolve against the label's own
     box instead and pile all eight nodes on the centre. */
  .sy-orbit { position: relative; aspect-ratio: 1; width: 100%; max-width: 30rem; margin-inline: auto; container-type: inline-size; }
  .sy-orbit__rings { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sy-orbit__ring { fill: none; stroke: rgba(255, 255, 255, 0.09); stroke-width: 1; }
  .sy-orbit__ring--outer { stroke-dasharray: 3 7; stroke: rgba(244, 14, 14, 0.22); }

  /* --- docking sequence -------------------------------------------------
     Ten seconds a cycle: eight areas dock one after another, roughly one a
     second, then the finished picture holds for a moment and it starts over.
     The stepping is done in script rather than with eight animation delays,
     because delayed infinite animations drift apart — each node would loop on
     its own clock and the ring would never be whole again.

     `--fly` is added to the ring radius, so a node travels along its own spoke
     instead of across the diagram. Registering the property is what lets the
     browser interpolate it; on an engine that does not, the node arrives
     without the travel, which is a smaller loss than a broken picture.

     Everything rests in the docked state by default. A reader without
     JavaScript, or with reduced motion, sees the complete diagram — never an
     empty ring waiting for something that will not come. */
  @property --fly {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  .sy-orbit__spoke {
    stroke: rgba(244, 14, 14, 0.4); stroke-width: 1.2;
    /* 152 is slightly over the longest spoke, so the dash hides all of it. */
    stroke-dasharray: 152; stroke-dashoffset: 0;
  }

  /* The undocked state exists only once script has taken charge. */
  html.sy-js-orbit .sy-orbit__spoke { stroke-dashoffset: 152; transition: stroke-dashoffset 0.85s var(--ease-out); }
  html.sy-js-orbit .sy-orbit__spoke.is-docked { stroke-dashoffset: 0; }
  html.sy-js-orbit .sy-orbit__list li {
    --fly: 4.5rem; opacity: 0;
    transition: --fly 0.9s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s var(--ease-out);
  }
  html.sy-js-orbit .sy-orbit__list li.is-docked { --fly: 0rem; opacity: 1; }

  .sy-orbit__toggle {
    position: absolute; right: 0; bottom: 0;
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.4rem 0.8rem; border-radius: var(--radius-pill);
    border: 1px solid var(--border-subtle); background: rgba(16, 16, 16, 0.95);
    color: var(--color-text-muted); font: inherit; font-size: var(--fs-label);
    cursor: pointer; transition: color var(--dur-fast), border-color var(--dur-fast);
  }
  .sy-orbit__toggle:hover { color: var(--color-text); border-color: var(--color-accent); }
  .sy-orbit__icon-play { display: none; }
  .sy-orbit__toggle[aria-pressed='true'] .sy-orbit__icon-play { display: block; }
  .sy-orbit__toggle[aria-pressed='true'] .sy-orbit__icon-pause { display: none; }
  .sy-orbit__core {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    display: grid; place-items: center; text-align: center;
    width: 42%; aspect-ratio: 1; border-radius: 50%;
    padding: 1rem;
    font-size: var(--fs-small); font-weight: var(--fw-bold); line-height: 1.25;
    color: #fff;
    background: radial-gradient(circle at 50% 35%, rgba(244, 14, 14, 0.3), rgba(20, 20, 20, 0.95) 70%);
    border: 1px solid rgba(244, 14, 14, 0.55);
    box-shadow: 0 0 60px -10px rgba(244, 14, 14, 0.5);
  }
  .sy-orbit__list { list-style: none; position: absolute; inset: 0; margin: 0; }
  .sy-orbit__list li {
    /* Fallback radius for engines without container query units; the ring is
       37.5% of the circle, matching where the spokes in the SVG end. */
    --r: 10rem;
    position: absolute; left: 50%; top: 50%;
    /* Origin at the circle's centre, so the rotation swings the label out to
       the ring: turn, step outwards, turn back upright, then centre the chip
       on the point it landed on. */
    transform-origin: 0 0;
    /* `--fly` is the distance still to travel; it is 0 unless the docking
       sequence has a node out beyond the ring. */
    --fly: 0rem;
    transform:
      rotate(calc(var(--i) * 45deg))
      translate(0, calc((var(--r) + var(--fly)) * -1))
      rotate(calc(var(--i) * -45deg))
      translate(-50%, -50%);
    padding: 0.4rem 0.75rem;
    font-size: var(--fs-label); white-space: nowrap;
    color: var(--color-text-muted);
    background: rgba(16, 16, 16, 0.95);
    border: 1px solid var(--border-subtle); border-radius: var(--radius-pill);
  }
  @supports (width: 1cqi) {
    .sy-orbit__list li { --r: 37.5cqi; }
  }

  /* ---------- ablauf ---------- */
  .sy-steps { list-style: none; display: grid; gap: 1.1rem; position: relative; padding-left: 2.6rem; }
  /* A rail that fills as the section scrolls past. Six phases read as a
     sequence rather than six cards once the line joins them. */
  .sy-steps__rail { position: absolute; left: 0.95rem; top: 0.5rem; bottom: 0.5rem; width: 2px; background: rgba(255, 255, 255, 0.1); border-radius: 2px; }
  .sy-steps__fill { display: block; width: 100%; height: var(--progress, 0%); background: linear-gradient(180deg, var(--color-accent), rgba(244, 14, 14, 0.35)); border-radius: 2px; box-shadow: 0 0 14px rgba(244, 14, 14, 0.5); transition: height 0.15s linear; }
  .sy-step {
    display: grid; grid-template-columns: auto 1fr; gap: 1.3rem;
    padding: clamp(1.3rem, 2.5vw, 1.8rem);
    border: 1px solid var(--border-subtle); border-radius: var(--radius-md);
    background: var(--surface-card);
    position: relative;
    transition: border-color var(--dur-med) var(--ease-out);
  }
  /* Tied to the scroll position rather than triggered once, so the phases
     travel back out to the right when the reader scrolls up again. `--slide`
     runs 1 (off to the right) to 0 (in place) and is written by script; the
     class on <html> means a reader without JavaScript gets them in place. */
  html.sy-js-slide .sy-step[data-step-slide] {
    --slide: 1;
    transform: translate3d(calc(var(--slide) * 14%), 0, 0);
    opacity: calc(1 - var(--slide) * 0.85);
    will-change: transform, opacity;
  }
  .sy-step::before {
    content: ''; position: absolute; left: -1.72rem; top: 1.9rem;
    width: 11px; height: 11px; border-radius: 50%;
    background: #101010; border: 2px solid rgba(255, 255, 255, 0.28);
  }
  .sy-step:hover { border-color: rgba(244, 14, 14, 0.4); }
  .sy-step:hover::before { border-color: var(--color-accent); background: var(--color-accent); }
  .sy-step__num {
    font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: var(--fw-bold); color: var(--color-accent);
    line-height: 1; font-variant-numeric: tabular-nums; opacity: 0.85;
  }
  .sy-step__body { display: flex; flex-direction: column; gap: 0.5rem; }
  .sy-step__title { font-size: var(--fs-h4); font-weight: var(--fw-bold); line-height: var(--lh-snug); }
  .sy-step__disciplines {
    font-size: var(--fs-label); letter-spacing: 0.05em; text-transform: uppercase;
    color: var(--color-accent-text); font-weight: var(--fw-semibold);
  }
  .sy-step__text { line-height: var(--lh-body); max-width: 68ch; }
  .sy-step__result {
    margin-top: 0.3rem; padding-top: 0.75rem;
    border-top: 1px dashed var(--border-strong);
    font-size: var(--fs-body); color: var(--color-text);
  }
  .sy-step__result-label {
    display: inline-block; margin-right: 0.55rem;
    font-size: var(--fs-label); letter-spacing: 0.09em; text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  /* ---------- bausteine ---------- */
  .sy-caps__grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); }
  /* Six items across a 1680px container land as 4 + 2, which reads as a row
     that ran out. Three columns give two full rows instead. */
  @media (min-width: 1100px) { .sy-caps__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .sy-cap {
    position: relative; overflow: hidden;
    padding: clamp(1.3rem, 2.5vw, 1.7rem);
    border: 1px solid var(--border-subtle); border-radius: var(--radius-md);
    background: var(--surface-card);
    transition: border-color var(--dur-med) var(--ease-out), transform var(--dur-med) var(--ease-out);
  }
  .sy-cap:hover { border-color: rgba(244, 14, 14, 0.4); transform: translateY(-4px); }
  .sy-cap__mark { position: absolute; inset: 0 auto 0 0; width: 3px; background: linear-gradient(180deg, var(--color-accent), transparent); }
  .sy-cap h3 { font-size: var(--fs-body); font-weight: var(--fw-bold); margin-bottom: 0.5rem; line-height: var(--lh-snug); }
  .sy-cap p { line-height: var(--lh-body); font-size: var(--fs-body); }

  /* ---------- sicherheit ---------- */
  .sy-sec__grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); }
  .sy-sec__item {
    padding: clamp(1.3rem, 2.5vw, 1.8rem);
    border: 1px solid var(--border-subtle); border-radius: var(--radius-md);
    background: var(--surface-card);
    transition: border-color var(--dur-med) var(--ease-out), transform var(--dur-med) var(--ease-out);
  }
  .sy-sec__item:hover { border-color: rgba(244, 14, 14, 0.4); transform: translateY(-4px); }
  .sy-sec__ring {
    display: inline-grid; place-items: center; width: 34px; height: 34px;
    margin-bottom: 0.9rem; border-radius: 10px;
    color: var(--color-accent); background: rgba(244, 14, 14, 0.12); border: 1px solid rgba(244, 14, 14, 0.35);
  }
  .sy-sec__item h3 { font-size: var(--fs-body); font-weight: var(--fw-bold); margin-bottom: 0.5rem; line-height: var(--lh-snug); }
  .sy-sec__item p { line-height: var(--lh-body); font-size: var(--fs-body); }

  /* ---------- warum wir ---------- */
  .sy-why__layout { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: clamp(1.5rem, 3.5vw, 2.5rem); align-items: start; }
  .sy-why__grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); }
  .sy-why__item {
    padding: clamp(1.4rem, 2.5vw, 1.9rem);
    border: 1px solid var(--border-subtle); border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md); background: var(--surface-card);
  }
  .sy-why__item h3 { font-size: var(--fs-body); font-weight: var(--fw-bold); margin-bottom: 0.55rem; line-height: var(--lh-snug); }
  .sy-why__item p { line-height: var(--lh-body); font-size: var(--fs-body); }
  .sy-why__media { margin: 0; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border-subtle); position: relative; }
  .sy-why__media img { width: 100%; height: 100%; min-height: 18rem; object-fit: cover; }
  .sy-why__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(244, 14, 14, 0.12), transparent 45%, rgba(0, 0, 0, 0.35)); pointer-events: none; }

  /* ---------- verbindlichkeit ---------- */
  .sy-commit__list { list-style: none; display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fit, minmax(21rem, 1fr)); }
  .sy-commit__list li {
    display: grid; grid-template-columns: auto 1fr; gap: 0.8rem; align-items: start;
    padding: clamp(1.1rem, 2vw, 1.4rem);
    border: 1px solid var(--border-subtle); border-radius: var(--radius-md);
    background: var(--surface-card); line-height: var(--lh-body);
  }
  .sy-commit__list svg { color: var(--color-accent); margin-top: 0.2em; }

  /* ---------- erster schritt + querverweis ---------- */
  .sy-first__inner, .sy-cross__inner {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    border: 1px solid var(--border-subtle); border-radius: var(--radius-lg);
    background: var(--surface-card);
  }
  .sy-first__inner {
    border-color: rgba(244, 14, 14, 0.45);
    background: linear-gradient(120deg, rgba(244, 14, 14, 0.14), transparent 68%), var(--surface-card);
    box-shadow: var(--shadow-accent);
  }
  .sy-first__inner > div, .sy-cross__inner > div { max-width: 46rem; }
  .sy-first__heading, .sy-cross__heading {
    font-size: var(--fs-h3); font-weight: var(--fw-bold); line-height: var(--lh-snug);
    margin-bottom: 0.6rem; text-wrap: balance;
  }

  /* ---------- responsive ---------- */
  @media (max-width: 1080px) {
    .sy-panel { grid-template-columns: 1fr; }
    .sy-why__layout { grid-template-columns: 1fr; }
    .sy-why__media img { min-height: 14rem; }
  }
  @media (max-width: 980px) {
    .sy-hero__inner { grid-template-columns: 1fr; min-height: 0; }
    .sy-hero__stage { margin-top: 1.5rem; }
    .sy-orbit-sec__inner { grid-template-columns: 1fr; }
    .sy-vs__head { display: none; }
    .sy-vs__row { grid-template-columns: 1fr; gap: 0.85rem; }
    .sy-vs__topic { font-size: var(--fs-body); }
    .sy-vs__mobile-label {
      display: block; grid-column: 2; text-align: left; align-self: center;
      font-size: var(--fs-label); letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--color-text-subtle);
    }
    /* Label on the mark's line, text on the next one, both indented past it. */
    .sy-vs__cell { row-gap: 0.35rem; }
  }
  @media (max-width: 720px) {
    /* The constellation stays — it scales with the container rather than
       being dropped. Only the secondary caption line goes, because below this
       width it would have to shrink past reading size. */
    .sy-sat__line { display: none; }
    .sy-dg--insights { grid-template-columns: 1fr; }
    .sy-flow { grid-template-columns: repeat(2, 1fr); gap: 1rem 0.4rem; }
    .sy-flow__step:not(:last-child)::after { display: none; }
    .sy-flow__skip { display: none; }

    /* --- the integrations, unrolled ----------------------------------
       Eight labels on a ring inside an 18rem circle can only be made to fit
       by shrinking them, and that ended at 9.6px. A phone gets the same
       statement laid out flat: the system on top, the eight areas as chips
       below it. The docking sequence still runs — the chips arrive one after
       another in the same order, they just arrive from below instead of from
       out on a spoke. */
    .sy-orbit { aspect-ratio: auto; max-width: none; container-type: normal; display: grid; justify-items: center; gap: 1.1rem; }
    .sy-orbit__rings { display: none; }
    .sy-orbit__core {
      position: static; transform: none;
      width: auto; aspect-ratio: auto; border-radius: var(--radius-pill);
      padding: 0.75rem 1.6rem; font-size: var(--fs-body);
    }
    .sy-orbit__list { position: static; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; }
    .sy-orbit__list li { position: static; transform: none; font-size: var(--fs-label); }
    html.sy-js-orbit .sy-orbit__list li { --fly: 0rem; transform: translateY(0.7rem); transition: transform 0.6s var(--ease-out), opacity 0.5s var(--ease-out); }
    html.sy-js-orbit .sy-orbit__list li.is-docked { transform: none; }
    .sy-orbit__toggle { position: static; }
  }
  @media (max-width: 640px) {
    .sy-step { grid-template-columns: 1fr; gap: 0.7rem; }
    .sy-steps { padding-left: 1.9rem; }
    .sy-steps__rail { left: 0.6rem; }
    .sy-step::before { left: -1.36rem; top: 1.6rem; }
    .sy-symptoms__list li { grid-template-columns: 1fr; gap: 0.5rem; align-items: start; }
    .sy-matrix { grid-template-columns: minmax(5rem, 1fr) repeat(3, auto); gap: 0.5rem; }

    /* --- tighter rhythm on a phone ------------------------------------
       Thirty-odd cards each carrying desktop padding is most of a screen
       spent on air. The copy keeps its size — it just stops being framed
       so generously. */
    .sy-head { margin-bottom: 1.5rem; }
    .sy-step,
    .sy-vs__row,
    .sy-sec__item,
    .sy-cap,
    .sy-why__item,
    .sy-choice,
    .sy-voice { padding: 1.05rem 1.1rem; }
    .sy-symptoms__list li,
    .sy-commit__list li { padding: 0.85rem 1rem; }
    .sy-card__body { padding: 1.1rem; gap: 0.55rem; }
    .sy-panel { padding: 1.2rem 1.1rem; }
    .sy-vs__table { gap: 0.55rem; }
    .sy-symptoms__list { gap: 0.6rem; }
    .sy-case { margin-top: 1.1rem; padding-top: 1rem; }
    .sy-case__beats { gap: 0.7rem; }
  }

  /* --- text in motion ---------------------------------------------------
     Additive: it hangs off the `is-visible` the shared observer already sets,
     so nothing about the existing reveal has to be overridden. The headings
     are wiped upwards rather than faded, which reads as type being set rather
     than as a slide deck; the hero's parts arrive one after another so the
     eye is led from the badge down to the buttons. */
  @keyframes sy-wipe {
    from { clip-path: inset(0 0 108% 0); }
    to { clip-path: inset(0 0 -20% 0); }
  }
  @keyframes sy-rise {
    from { opacity: 0; transform: translateY(0.9rem); }
    to { opacity: 1; transform: none; }
  }
  .sy-head.is-visible h2,
  .sy-orbit-sec__copy.is-visible h2 { animation: sy-wipe 0.85s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .sy-hero__copy.is-visible > * { animation: sy-rise 0.65s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .sy-hero__copy.is-visible > :nth-child(1) { animation-delay: 0.02s; }
  .sy-hero__copy.is-visible > :nth-child(2) { animation-delay: 0.1s; }
  .sy-hero__copy.is-visible > :nth-child(3) { animation-delay: 0.2s; }
  .sy-hero__copy.is-visible > :nth-child(4) { animation-delay: 0.3s; }
  .sy-hero__copy.is-visible > :nth-child(5) { animation-delay: 0.4s; }

  /* Touch: the text links here were 22px tall, under half the comfortable
     target. Padding rather than min-height, so the surrounding rhythm holds. */
  @media (pointer: coarse) {
    .sy-choice__link,
    .sy-card__link { padding-block: 0.6rem; }
    .sy-orbit__toggle { padding-block: 0.7rem; }
    .sy-tab { padding-block: 0.85rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sy-head.is-visible h2,
    .sy-orbit-sec__copy.is-visible h2,
    .sy-hero__copy.is-visible > * { animation: none !important; }
    .sy-hero__word { transition: none; }
    .sy-console, .sy-sat, .sy-marquee__track, .sy-console__scan, .sy-wires__pulse path { animation: none !important; }
    .sy-console__scan, .sy-wires__pulse { display: none; }
    .sy-hero__frame, .sy-sat { transition: none; }
    .sy-steps__fill { transition: none; }
    /* The phases sit where they belong; nothing slides. */
    html.sy-js-slide .sy-step[data-step-slide] { transform: none; opacity: 1; }
  }
</style>

<script>
  // ---- Module explorer -------------------------------------------------
  // A tablist rather than a set of links: the panels are alternative views of
  // one subject, so arrow keys move between tabs and only the selected tab
  // stays in the tab order (WAI-ARIA authoring practice).
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.sy-tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.sy-panel'));

  function selectTab(index: number, focus = true) {
    tabs.forEach((tab, i) => {
      const active = i === index;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      if (active && focus) tab.focus();
    });
    panels.forEach((panel, i) => {
      panel.hidden = i !== index;
    });
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => selectTab(i, false));
    tab.addEventListener('keydown', (event) => {
      const keys: Record<string, number> = {
        ArrowRight: i + 1,
        ArrowLeft: i - 1,
        Home: 0,
        End: tabs.length - 1,
      };
      const next = keys[event.key];
      if (next === undefined) return;
      event.preventDefault();
      selectTab((next + tabs.length) % tabs.length);
    });
  });

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  // ---- Hook: the rotating line -----------------------------------------
  // Works through the four places the knowledge sits and then stops on the
  // last one, which is the sharpest. It deliberately finishes inside five
  // seconds: past that, auto-updating text needs a pause control under WCAG
  // 2.2.2, and a headline with a pause button beside it is not a headline.
  // Stopping also lets the hook land instead of cycling past its best line.
  const rotator = document.querySelector<HTMLElement>('[data-rotator]');
  if (rotator) {
    const words = Array.from(rotator.querySelectorAll<HTMLElement>('.sy-hero__word'));
    if (words.length > 1) {
      if (reduced.matches) {
        words.forEach((w, i) => w.classList.toggle('is-current', i === words.length - 1));
      } else {
        const STEP = 1500;
        let i = 0;
        const advance = () => {
          const current = words[i];
          const next = words[i + 1];
          if (!next) return;
          current.classList.remove('is-current');
          current.classList.add('is-leaving');
          next.classList.add('is-current');
          i += 1;
          if (i < words.length - 1) window.setTimeout(advance, STEP);
        };
        // A beat before the first swap, so the opening line is read first.
        window.setTimeout(advance, STEP);
      }
    }
  }

  // ---- Process rail and phase slide-in ---------------------------------
  // One scroll pass drives both: the rail fills as the phase list travels
  // through the viewport, and each phase is placed on its own little track
  // according to where it sits relative to the fold. Position-linked rather
  // than triggered once, so scrolling back up sends the phases out to the
  // right again. Purely decorative: without JavaScript, or with reduced
  // motion, everything is simply in its final place.
  const steps = document.querySelector<HTMLElement>('.sy-steps');
  const fill = document.querySelector<HTMLElement>('.sy-steps__fill');
  const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-step-slide]'));

  if (steps && fill) {
    if (reduced.matches) {
      fill.style.setProperty('--progress', '100%');
      slides.forEach((el) => el.style.setProperty('--slide', '0'));
    } else {
      document.documentElement.classList.add('sy-js-slide');
      let ticking = false;
      const update = () => {
        ticking = false;
        const vh = window.innerHeight;

        const rect = steps.getBoundingClientRect();
        // 0 when the list's top reaches the middle of the viewport,
        // 1 when its bottom does.
        const mid = vh * 0.55;
        const travelled = mid - rect.top;
        const ratio = Math.min(1, Math.max(0, travelled / Math.max(rect.height, 1)));
        fill.style.setProperty('--progress', `${(ratio * 100).toFixed(1)}%`);

        // Each phase travels in over the last 32% of the viewport height before
        // its top crosses the 78% line, and travels back out the same way.
        for (const el of slides) {
          const r = el.getBoundingClientRect();
          const start = vh * 0.94;
          const end = vh * 0.62;
          const p = Math.min(1, Math.max(0, (start - r.top) / (start - end)));
          // 1 = fully off to the right, 0 = in place.
          el.style.setProperty('--slide', (1 - p).toFixed(3));
        }
      };
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
  }

  // ---- Integration docking loop ----------------------------------------
  // Runs only while the diagram is on screen, and can be stopped outright.
  // WCAG 2.2.2: motion that starts on its own and lasts longer than five
  // seconds needs a way to pause it, and a ten-second loop is exactly that.
  const orbit = document.querySelector<HTMLElement>('.sy-orbit');
  const toggle = document.querySelector<HTMLButtonElement>('[data-orbit-toggle]');
  const toggleLabel = document.querySelector<HTMLElement>('[data-orbit-label]');

  if (orbit && toggle && toggleLabel) {
    if (reduced.matches) {
      // The docked picture is already the default. Offer no control for motion
      // that is never going to happen.
      toggle.hidden = true;
    } else {
      const nodes = Array.from(orbit.querySelectorAll<HTMLElement>('.sy-orbit__list li'));
      const spokes = Array.from(orbit.querySelectorAll<SVGLineElement>('.sy-orbit__spoke'));
      // Eight slots of 1.05s plus a 1.6s hold on the finished picture is ten
      // seconds, which is the cadence this section was asked for.
      const SLOT = 1050;
      const HOLD = 1600;

      const pauseText = toggleLabel.textContent ?? '';
      const playText = toggle.dataset.playLabel ?? pauseText;
      let stoppedByUser = false;
      let inView = false;
      let timers: number[] = [];

      // Taking charge: until this class exists the diagram renders complete,
      // so a reader without JavaScript never sees an empty ring.
      document.documentElement.classList.add('sy-js-orbit');

      const clearTimers = () => {
        timers.forEach(clearTimeout);
        timers = [];
      };
      const setDocked = (docked: boolean) => {
        nodes.forEach((n) => n.classList.toggle('is-docked', docked));
        spokes.forEach((sp) => sp.classList.toggle('is-docked', docked));
      };

      const cycle = () => {
        setDocked(false);
        nodes.forEach((node, i) => {
          timers.push(
            window.setTimeout(() => {
              node.classList.add('is-docked');
              spokes[i]?.classList.add('is-docked');
            }, i * SLOT),
          );
        });
        timers.push(window.setTimeout(cycle, nodes.length * SLOT + HOLD));
      };

      const start = () => {
        clearTimers();
        cycle();
      };
      const stop = (leaveDocked: boolean) => {
        clearTimers();
        if (leaveDocked) setDocked(true);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            inView = entry.isIntersecting;
            // Begin at the beginning each time the reader arrives here, and
            // stop entirely once it is off screen — an animation nobody is
            // looking at is only a drain on the battery.
            if (inView && !stoppedByUser) start();
            else if (!inView) stop(true);
          }
        },
        { threshold: 0.35 },
      );
      observer.observe(orbit);

      toggle.addEventListener('click', () => {
        stoppedByUser = !stoppedByUser;
        toggle.setAttribute('aria-pressed', String(stoppedByUser));
        toggleLabel.textContent = stoppedByUser ? playText : pauseText;
        // Stopping leaves the diagram whole rather than mid-sequence.
        if (stoppedByUser) stop(true);
        else if (inView) start();
      });
    }
  }

  // ---- Hero constellation: connect the surfaces -------------------------
  // The markup renders connected, so a reader without JavaScript gets the
  // finished picture rather than a grey one that never lights up. Script then
  // disconnects all three and hands the reader the job of joining them: a
  // system you assembled yourself reads differently from one you were shown,
  // and three taps is a cheaper way to understand "one record set, several
  // surfaces" than a paragraph about it.
  const constellation = document.querySelector<HTMLElement>('[data-constellation]');
  const hint = document.querySelector<HTMLElement>('[data-hint]');

  if (constellation) {
    const sats = Array.from(constellation.querySelectorAll<HTMLButtonElement>('[data-sat]'));
    const wires = Array.from(constellation.querySelectorAll<SVGPathElement>('[data-wire]'));
    const connectAction = constellation.dataset.action ?? '';
    const connectedState = constellation.dataset.state ?? '';
    const hintText = hint?.textContent ?? '';
    const doneText = hint?.dataset.done ?? hintText;

    const wiresFor = (key: string) => wires.filter((w) => w.dataset.wire === key);

    const setConnected = (sat: HTMLButtonElement, on: boolean) => {
      sat.setAttribute('aria-pressed', String(on));
      wiresFor(sat.dataset.sat ?? '').forEach((w) => w.classList.toggle('is-on', on));
      // The button's name carries the state, so a screen reader hears what
      // pressing it will do rather than just a noun.
      const name = sat.querySelector('b')?.textContent?.trim() ?? '';
      sat.setAttribute('aria-label', `${name} — ${on ? connectedState : connectAction}`);
    };

    const refreshHint = () => {
      if (!hint) return;
      const all = sats.every((sat) => sat.getAttribute('aria-pressed') === 'true');
      hint.textContent = all ? doneText : hintText;
      hint.classList.toggle('is-done', all);
    };

    // Start disconnected. Everything below this line only happens with script.
    sats.forEach((sat) => setConnected(sat, false));
    refreshHint();

    sats.forEach((sat) => {
      sat.addEventListener('click', () => {
        setConnected(sat, sat.getAttribute('aria-pressed') !== 'true');
        refreshHint();
      });
    });
  }

  // ---- Hero constellation parallax --------------------------------------
  // A few pixels of depth on pointer move. Skipped on touch, where there is no
  // pointer to follow, and under reduced motion.
  const stage = document.querySelector<HTMLElement>('.sy-constellation');
  if (stage && !reduced.matches && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let raf = 0;
    stage.closest('.sy-hero')?.addEventListener('pointermove', (event) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const r = stage.getBoundingClientRect();
        const x = ((event as PointerEvent).clientX - r.left) / r.width - 0.5;
        const y = ((event as PointerEvent).clientY - r.top) / r.height - 0.5;
        stage.style.setProperty('--px', x.toFixed(3));
        stage.style.setProperty('--py', y.toFixed(3));
      });
    }, { passive: true });
  }
</script>
