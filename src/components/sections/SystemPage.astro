---
/** Unser System / Our System — the 360° Booster System. Faithful reproduction. */
import ContactBlock from './ContactBlock.astro';
import type { Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const c = {
  de: {
      heroEyebrowLead: 'Ihr Erfolgsweg zum ',
      heroEyebrowAccent: 'Experten im IT-Bereich',
      heroParas: [
        'WAMOCON hat einen umfassenden Ansatz entwickelt, der alle Aspekte des IT-Testens abdeckt. Dieses 360-Grad-System zum Aufbau einer erfolgreichen Karriere umfasst eine Reihe von Schritten und befähigt Sie, Herausforderungen zu meistern, indem es Ihnen den Weg zum Erfolg auf die effektivste Weise zeigt.',
        'Das WAMOCON-Team nutzt dieses System, um die Arbeitsqualität jedes einzelnen Mitarbeiters, erfolgreiche Tests und den Abschluss von IT-Projekten zu verbessern.',
      ],
      heroTitleLead: 'Das ',
      heroTitleAccent: '360° Booster System',
      stepsLead: 'Erfolgreich im IT-Projekt: Das 360°-System',
      stepsRest: ' für alle Karrierestufen',
      steps: [
        { h: 'Der erste Schritt zu Ihrem Traumprojekt', p: 'Überzeugen Sie potenzielle Auftraggeber mit zielgerichteten Inhalten. Unsere bewährte Blueprint-Strategie zeigt Ihnen, wie Sie den Weg zu Ihrem Wunschprojekt ebnen.' },
        { h: 'Erfolgreiches Onboarding leicht gemacht', p: 'Starten Sie optimal mit Ihrem Projektteam. Effektive Kommunikation und klare Prozesse sorgen für einen reibungslosen Ablauf, wir zeigen Ihnen, wie es geht.' },
        { h: 'Effiziente Planung für Ihren Erfolg', p: 'Gestalten Sie Ihre Projektarbeit stressfrei und strukturiert. Mit gezielten Kontrollfragen behalten Sie jedes Detail im Blick und sichern sich eine optimale Planung.' },
        { h: 'Erfolgreich starten: Ihre erste Aufgabe', p: 'Lernen Sie, wie Sie effizient die richtigen Projektinformationen sammeln. Mit klaren Methoden meistern Sie jede Aufgabe problemlos.' },
        { h: 'Ausführung mit Präzision', p: 'Stellen Sie sicher, dass Sie jeden Testfall im Detail verstehen. Unsere bewährten Methoden helfen Ihnen, sich abzuheben und jede Herausforderung souverän zu meistern.' },
        { h: 'Sicherer Projektabschluss', p: 'Keine Panik, wenn die Zeit drängt! Mit unserer über 50-jährigen Erfahrung und einer bewährten Schritt-für-Schritt-Anleitung meistern Sie jede Herausforderung und bringen Ihr Projekt erfolgreich ins Ziel.' },
      ],
      academyTitle: 'Entdecken Sie Ihre Weiterbildungsmöglichkeiten mit IT-Testmanagement Kursen auf unserer Academy-Webseite!',
      heroImgAlt: 'Diagramm des 360° Booster Systems mit seinen sechs aufeinander aufbauenden Schritten',
      academyImgAlt: 'Trainerin der WAMOCON Academy vor einer Kurspräsentation',
      academyBlocks: [
        { s: 'Ihre Unterstützung auf dem Weg zur Karriere', p: 'Unsere Academy hilft Ihnen, die Schlüsselmechanismen des Testmanagements zu meistern. Mit unserem umfassenden Ansatz begleiten wir Sie sicher auf Ihrem Karriereweg und unterstützen Sie dabei, Ihre beruflichen Ziele zu erreichen.' },
        { s: 'Für alle, die weiterkommen wollen', p: 'Ob Student, junger Berater oder Quereinsteiger, unsere Trainings geben Ihnen die richtigen Werkzeuge an die Hand, um erfolgreich zu sein. Auch Projektleiter und Manager profitieren von praxisnahen Lösungen und fundierten Strategien, die Projekte auf das nächste Level heben.' },
      ],
      academyCta: 'Starten Sie jetzt Ihre Erfolgsgeschichte, mit uns!',
      academyBtn: 'Jetzt Academy entdecken',
    },
  en: {
      heroEyebrowLead: 'Your path to success as an ',
      heroEyebrowAccent: 'expert in the IT sector',
      heroParas: [
        'WAMOCON has developed a comprehensive approach that covers all aspects of IT testing. This 360-degree system for building a successful career comprises a series of steps and empowers you to master challenges by showing you the path to success in the most effective way.',
        'The WAMOCON team uses this system to improve the work quality of each individual employee, successful testing and the completion of IT projects.',
      ],
      heroTitleLead: 'The ',
      heroTitleAccent: '360° Booster System',
      stepsLead: 'Successful in IT projects: the 360° system',
      stepsRest: ' for all career levels',
      steps: [
        { h: 'The first step to your dream project', p: 'Convince potential clients with targeted content. Our proven blueprint strategy shows you how to pave the way to your dream project.' },
        { h: 'Successful onboarding made easy', p: 'Get off to the best possible start with your project team. Effective communication and clear processes ensure a smooth process, we show you how it works.' },
        { h: 'Efficient planning for your success', p: 'Design your project work stress-free and structured. With targeted control questions, you keep an eye on every detail and secure optimal planning.' },
        { h: 'Get started successfully: your first task', p: 'Learn how to efficiently gather the right project information. With clear methods, you master every task with ease.' },
        { h: 'Execution with precision', p: 'Make sure you understand every test case in detail. Our proven methods help you stand out and master every challenge with confidence.' },
        { h: 'Secure project completion', p: 'No panic when time is short! With over 50 years of combined practical experience within our team and a proven step-by-step guide, you master every challenge and bring your project to a successful conclusion.' },
      ],
      academyTitle: 'Discover your further training opportunities with IT test management courses on our Academy website!',
      heroImgAlt: 'Diagram of the 360° Booster System and its six sequential steps',
      academyImgAlt: 'A WAMOCON Academy trainer in front of a course presentation',
      academyBlocks: [
        { s: 'Your support on the path to a career', p: 'Our Academy helps you to master the key mechanisms of test management. With our comprehensive approach, we accompany you safely on your career path and support you in achieving your professional goals.' },
        { s: 'For all those who want to get ahead', p: 'Whether student, young consultant or career changer, our training courses give you the right tools to succeed. Project managers and managers also benefit from practical solutions and well-founded strategies that take projects to the next level.' },
      ],
      academyCta: 'Start your success story now, with us!',
      academyBtn: 'Discover the Academy now',
    },
  tr: {
      heroEyebrowLead: 'BT alanında uzmanlığa giden ',
      heroEyebrowAccent: 'başarı yolunuz',
      heroParas: [
        'WAMOCON, BT testinin tüm yönlerini kapsayan bütünsel bir yaklaşım geliştirdi. Başarılı bir kariyer inşa etmeye yönelik bu 360 derecelik sistem, birbirini izleyen adımlardan oluşur ve size başarıya giden yolu en etkili biçimde göstererek zorlukların üstesinden gelmenizi sağlar.',
        'WAMOCON ekibi bu sistemi, her bir çalışanın iş kalitesini, testlerin başarısını ve BT projelerinin tamamlanmasını iyileştirmek için kullanır.',
      ],
      heroTitleLead: '',
      heroTitleAccent: '360° Booster Sistemi',
      stepsLead: 'BT projesinde başarı: 360° sistemi',
      stepsRest: ' her kariyer seviyesi için',
      steps: [
        { h: 'Hayalinizdeki projeye ilk adım', p: 'Potansiyel müşterileri hedefe yönelik içerikle ikna edin. Kanıtlanmış blueprint stratejimiz, hayalinizdeki projeye giden yolu nasıl açacağınızı gösterir.' },
        { h: 'Başarılı bir işe başlangıç, artık çok kolay', p: 'Proje ekibinizle en iyi şekilde başlayın. Etkili iletişim ve net süreçler sorunsuz bir akış sağlar; nasıl olduğunu size gösteriyoruz.' },
        { h: 'Başarınız için verimli planlama', p: 'Proje çalışmanızı stressiz ve yapılandırılmış biçimde kurgulayın. Hedefe yönelik kontrol sorularıyla hiçbir ayrıntıyı gözden kaçırmaz ve en iyi planlamayı güvence altına alırsınız.' },
        { h: 'Başarılı bir başlangıç: ilk göreviniz', p: 'Doğru proje bilgilerini nasıl verimli topladığınızı öğrenin. Net yöntemlerle her görevin altından kolayca kalkarsınız.' },
        { h: 'Kusursuz uygulama', p: 'Her test senaryosunu ayrıntısıyla anladığınızdan emin olun. Kanıtlanmış yöntemlerimiz fark yaratmanıza ve her zorluğu güvenle aşmanıza yardımcı olur.' },
        { h: 'Güvenli proje kapanışı', p: 'Zaman daralınca paniğe kapılmayın! 50 yılı aşkın birikmiş deneyimimiz ve kanıtlanmış adım adım kılavuzumuzla her zorluğun üstesinden gelir, projenizi başarıyla tamamlarsınız.' },
      ],
      academyTitle: 'Akademi web sitemizdeki BT test yönetimi kurslarıyla gelişim fırsatlarınızı keşfedin!',
      heroImgAlt: '360° Booster Sisteminin birbirini izleyen altı adımını gösteren şema',
      academyImgAlt: 'Kurs sunumunun önünde duran bir WAMOCON Academy eğitmeni',
      academyBlocks: [
        { s: 'Kariyer yolunuzda desteğiniz', p: 'Akademimiz, test yönetiminin temel mekanizmalarında ustalaşmanıza yardımcı olur. Bütünsel yaklaşımımızla kariyer yolculuğunuzda size güvenle eşlik eder ve mesleki hedeflerinize ulaşmanızı destekleriz.' },
        { s: 'İlerlemek isteyen herkes için', p: 'İster öğrenci, ister genç danışman, ister kariyer değiştiren olun; eğitimlerimiz başarılı olmanız için doğru araçları elinize verir. Proje yöneticileri ve yöneticiler de projeleri bir üst seviyeye taşıyan uygulanabilir çözümlerden ve sağlam stratejilerden yararlanır.' },
      ],
      academyCta: 'Başarı hikâyenizi bizimle hemen başlatın!',
      academyBtn: 'Akademiyi hemen keşfedin',
    },
}[lang];

const aiBadge = {
  de: { label: 'Diese Grafik wurde mit künstlicher Intelligenz erstellt', text: 'KI-generiert' },
  en: { label: 'This graphic was created using artificial intelligence', text: 'AI-generated' },
  tr: { label: 'Bu grafik yapay zekâ ile oluşturulmuştur', text: 'Yapay zekâ üretimi' },
}[lang];

const academyUrl = 'https://test-it-academy.com/';
---

<!-- HERO -->
<section class="sys-hero">
  <div class="container">
    <p class="sys-hero__eyebrow"><span class="t-white">{c.heroEyebrowLead}</span><span class="t-red">{c.heroEyebrowAccent}</span></p>
    <div class="sys-hero__lead">
      {c.heroParas.map((p) => <p>{p}</p>)}
    </div>
    <h1 class="sys-hero__title"><span class="t-white">{c.heroTitleLead}</span><span class="t-red">{c.heroTitleAccent}</span></h1>
    <img class="sys-hero__img" src="/images/system-360.svg" alt={c.heroImgAlt} loading="lazy" />
  </div>
</section>

<!-- STEPS -->
<section class="section section--alt">
  <div class="container">
    <h2 class="sys-h2"><span class="t-white">{c.stepsLead}</span><span class="t-red">{c.stepsRest}</span></h2>
    <ol class="sys-steps">
      {c.steps.map((s, i) => (
        <li class="sys-step" data-reveal="up" data-reveal-delay={(i % 3) * 60}>
          <span class="sys-step__num">{i + 1}</span>
          <div>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ACADEMY -->
<section class="section">
  <div class="container">
    <div class="sys-academy">
      <div class="sys-academy__figure">
        <img class="sys-academy__img" src="/images/academy-person.png" alt={c.academyImgAlt} loading="lazy" />
        <span class="ai-badge" aria-label={aiBadge.label}>{aiBadge.text}</span>
      </div>
      <div class="sys-academy__body">
        <h2><span class="t-white">{c.academyTitle}</span></h2>
        {c.academyBlocks.map((b) => (
          <p><strong>{b.s}</strong> {b.p}</p>
        ))}
        <p class="sys-academy__cta">{c.academyCta}</p>
        <a class="sys-btn" href={academyUrl} target="_blank" rel="noopener">{c.academyBtn}</a>
      </div>
    </div>
  </div>
</section>

<ContactBlock lang={lang} />

<style>
  .t-red { color: var(--color-accent); }
  .t-white { color: var(--color-text); }

  /* The site sets all copy flush left; the hero used to be the one centred block. */
  .sys-hero { padding: clamp(3rem, 8vw, 6rem) 0 clamp(2rem, 5vw, 3.5rem); }
  .sys-hero__eyebrow {
    font-size: clamp(1.4rem, 3.5vw, 2.2rem);
    font-weight: var(--fw-semibold);
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }
  /* Full-width, left-aligned intro copy (fills the screen instead of a narrow column). */
  .sys-hero__lead { max-width: none; margin: 0 0 2rem; }
  .sys-hero__lead p { color: var(--color-text-muted); line-height: 1.65; margin-bottom: 1rem; }
  .sys-hero__title {
    font-size: clamp(2.4rem, 7vw, 5rem);
    font-weight: var(--fw-bold);
    line-height: 1.05;
    margin-bottom: 2.5rem;
  }
  /* The diagram is a graphic, so it is centred and a little larger. */
  .sys-hero__img { max-width: 960px; width: 100%; margin-inline: auto; display: block; }

  .sys-h2 {
    font-size: clamp(1.8rem, 4.5vw, 3rem);
    font-weight: var(--fw-bold);
    line-height: 1.1;
    margin-bottom: clamp(1.8rem, 4vw, 2.8rem);
  }

  .sys-steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.3rem;
    counter-reset: step;
  }
  .sys-step {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.8rem;
    display: flex;
    gap: 1.1rem;
    transition: transform var(--dur-med) var(--ease-out);
  }
  .sys-step:hover { transform: translateY(-6px); }
  .sys-step__num {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-accent-surface);
    color: #fff;
    font-weight: var(--fw-bold);
    font-size: 1.2rem;
  }
  .sys-step h3 { font-size: 1.15rem; margin-bottom: 0.6rem; }
  .sys-step p { color: var(--color-text-muted); line-height: 1.55; }

  .sys-academy {
    display: grid;
    /* minmax(0, 1fr): a bare `1fr` keeps its automatic min-content floor, so a
       long unbreakable heading pushed this column past the card on tablets.
       The image column also shrinks now instead of holding a hard 380px. */
    grid-template-columns: minmax(220px, 380px) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: clamp(1.6rem, 4vw, 3rem);
  }
  .sys-academy__figure { position: relative; }
  .sys-academy__img { width: 100%; border-radius: var(--radius-md); display: block; }
  /* Art. 50(5): perceivable, accessible AI label. High-contrast dark pill. */
  .sys-academy__figure .ai-badge {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: #fff;
    font-size: 0.72rem;
    font-weight: var(--fw-semibold);
    line-height: 1;
    pointer-events: none;
  }
  .sys-academy__body h2 { font-size: clamp(1.5rem, 3.2vw, 2.2rem); line-height: 1.2; margin-bottom: 1.4rem; }
  .sys-academy__body p { color: var(--color-text-muted); line-height: 1.6; margin-bottom: 1.1rem; }
  .sys-academy__body strong { color: var(--color-text); }
  .sys-academy__cta { color: var(--color-accent) !important; font-weight: var(--fw-semibold); }
  .sys-btn {
    display: inline-block;
    padding: 0.9rem 2rem;
    background: var(--color-accent-surface);
    color: #fff;
    font-weight: var(--fw-semibold);
    border-radius: var(--radius-sm);
    transition: background var(--dur-fast) var(--ease-out);
  }
  .sys-btn:hover { background: var(--color-accent-hover); }

  @media (max-width: 900px) {
    .sys-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .sys-steps, .sys-academy { grid-template-columns: minmax(0, 1fr); }
  }
</style>
