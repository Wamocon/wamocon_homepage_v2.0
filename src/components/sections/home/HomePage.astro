---
/**
 * Home page composition. All content comes from src/data/home.ts and
 * src/data/apps.ts so it stays identical across languages — only `lang` differs.
 */
import Button from '../../ui/Button.astro';
import ExternalEmbed from '../../ui/ExternalEmbed.astro';
import ContactBlock from '../ContactBlock.astro';
import { home } from '../../../data/home';
import { nav, ui, legalNav, type Lang } from '../../../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = (k: keyof (typeof ui)['de']) => ui[lang][k];
// Keys now live inside dropdown groups, so search the flattened nav.
const flatNav = nav.flatMap((n) => (n.children ? n.children : [n]));
const hrefForKey = (key: string) => flatNav.find((n) => n.key === key)![lang].href;
const aboutHref = hrefForKey('about');
const reviewsHref = hrefForKey('testimonials');
const referencesHref = hrefForKey('references');
const systemHref = hrefForKey('system');
const privacyHref = legalNav.privacy[lang].href;
// Magazine download switches with the active language. Only a DE and an EN
// edition exist; the Turkish page links to the English one.
const magazinUrl = lang === 'de'
  ? 'https://wamocon-my.sharepoint.com/:b:/p/waleri_moretz/EZUMpxrfjYdPt7g1H7xkQhkBnuG6v-tWKLCPNZIN6Wejlw?e=bQVx7k&download=1'
  : 'https://wamocon-my.sharepoint.com/my?id=%2Fpersonal%2Fwaleri%5Fmoretz%5Fwamocon%5Fcom%2FDocuments%2F01%5FWMC%2F01%20Vertrieb%20und%20Marketing%2F01%2D01%20Marketing%2F01%2D01%2D14%20WMC%20Marketing%2F07%20WMC%20Magazin%2FFinal%20Magazin%20WAMOCON&viewid=6e86f4bd%2D8476%2D4fa5%2Dad74%2D5e1cf1eedc8b';



// Split a heading so the first N words can be highlighted in CI red.
const splitFirst = (s: string, n = 1) => {
  const first = s.split(' ').slice(0, n).join(' ');
  return { first, rest: s.slice(first.length) };
};
// Split a heading so the last word can be highlighted in CI red.
const splitLast = (s: string) => {
  const idx = s.lastIndexOf(' ');
  return { head: s.slice(0, idx), last: s.slice(idx) };
};

const aboutHeading = splitFirst(home.about.heading[lang]);
const benefitsHeading = splitFirst(home.benefits.heading[lang]);
const projectsHeading = splitLast(home.projects.heading[lang]);
const academyHeading = splitFirst(home.academy.heading[lang], 2);
const projectCompanyLabel = {
  de: 'Über das Unternehmen',
  en: 'About the company',
  tr: 'Şirket hakkında',
}[lang];
const projectProjectLabel = {
  de: 'Über das Projekt',
  en: 'About the project',
  tr: 'Proje hakkında',
}[lang];
const ceoCaption = home.goal.signoff[lang];

/** Inline copy that does not live in src/data/home.ts. */
const page = {
  de: {
    boosterTitle: 'Das 360° Booster System',
    boosterText:
      'Unser strukturierter Weg vom ersten Kontakt bis zum erfolgreichen IT-Projekt: sechs aufeinander aufbauende Schritte, die Testerinnen und Tester sicher durch jedes Projekt führen und ihre Karriere gezielt weiterentwickeln.',
    boosterCta: 'Zum 360° Booster System',
    boosterAlt: 'Das 360° Booster System mit sechs Schritten',
    aboutCta: 'Mehr über uns',
    magazine: 'Magazin herunterladen',
    reviewsLink: 'Was unsere Kunden sagen',
    referencesLink: 'Alle Referenzen ansehen',
    ditelHeading: 'Lernen mit DiTeLe',
    ditelText:
      'DiTeLe ist die digitale Lernplattform der WAMOCON Academy: praxisnahe Kurse zum Softwaretesting mit Videos, Szenarien und Übungen, jederzeit und in Ihrem Tempo.',
    ditelCta: 'Ditele entdecken',
    quizLive: 'Live-Demo: DiTeLe Praxisübung',
    quizCount: 'Frage 1 von 300+',
    quizQuestion: 'Was ist der Hauptzweck des Softwaretestens?',
    quizHint:
      'Das ist Übung 1 von 45+ in DiTeLe. Mit DiTeLe lernst du nicht nur über Softwaretesten – du machst es.',
    quizCta: 'Alle Übungen in DiTeLe freischalten',
    contactHint: ' Bitte geben Sie E-Mail oder Telefon an.',
    responsible:
      'Ihre Anfrage wird bearbeitet von Dipl.-Ing. Waleri Moretz, Geschäftsführer der WAMOCON GmbH.',
    thankYou: '/danke/',
  },
  en: {
    boosterTitle: 'The 360° Booster System',
    boosterText:
      'Our structured path from first contact to a successful IT project: six sequential steps that guide testers safely through every project and develop their careers in a targeted way.',
    boosterCta: 'Explore the 360° Booster System',
    boosterAlt: 'The 360° Booster System with six steps',
    aboutCta: 'More about us',
    magazine: 'Download magazine',
    reviewsLink: 'What our clients say',
    referencesLink: 'View all references',
    ditelHeading: 'Learn with DiTeLe',
    ditelText:
      'DiTeLe is the WAMOCON Academy’s digital learning platform: practical software-testing courses with videos, scenarios and exercises, anytime and at your own pace.',
    ditelCta: 'Discover DiTeLe',
    quizLive: 'Live demo: DiTeLe practice exercise',
    quizCount: 'Question 1 of 300+',
    quizQuestion: 'What is the main purpose of software testing?',
    quizHint:
      'This is exercise 1 of 45+ in DiTeLe. With DiTeLe you don’t just learn about software testing – you do it.',
    quizCta: 'Unlock all exercises in DiTeLe',
    contactHint: ' Please provide an email address or phone number.',
    responsible:
      'Your enquiry is handled by Dipl.-Ing. Waleri Moretz, Managing Director of WAMOCON GmbH.',
    thankYou: '/en/thank-you/',
  },
  tr: {
    boosterTitle: '360° Booster Sistemi',
    boosterText:
      'İlk temastan başarılı BT projesine uzanan yapılandırılmış yolumuz: test uzmanlarını her projede güvenle yönlendiren ve kariyerlerini hedefe yönelik geliştiren, birbirini izleyen altı adım.',
    boosterCta: '360° Booster Sistemine git',
    boosterAlt: 'Altı adımdan oluşan 360° Booster Sistemi',
    aboutCta: 'Hakkımızda daha fazlası',
    magazine: 'Dergiyi indir',
    reviewsLink: 'Müşterilerimiz ne diyor',
    referencesLink: 'Tüm referansları görün',
    ditelHeading: 'DiTeLe ile öğrenin',
    ditelText:
      'DiTeLe, WAMOCON Academy’nin dijital öğrenme platformudur: videolar, senaryolar ve alıştırmalarla uygulamaya dönük yazılım testi kursları; dilediğiniz zaman, kendi hızınızda.',
    ditelCta: 'DiTeLe’yi keşfedin',
    quizLive: 'Canlı demo: DiTeLe uygulama alıştırması',
    quizCount: '300+ sorudan 1.’si',
    quizQuestion: 'Yazılım testinin temel amacı nedir?',
    quizHint:
      'Bu, DiTeLe’deki 45+ alıştırmadan birincisi. DiTeLe ile yazılım testini yalnızca öğrenmezsin – bizzat yaparsın.',
    quizCta: 'DiTeLe’deki tüm alıştırmaların kilidini aç',
    contactHint: ' Lütfen e-posta veya telefon bilgisi girin.',
    responsible:
      'Talebiniz, WAMOCON GmbH Genel Müdürü Dipl.-Ing. Waleri Moretz tarafından ele alınmaktadır.',
    thankYou: '/tr/tesekkurler/',
  },
}[lang];

/** DiTeLe demo-quiz answer options. */
const quizOptions = [
  { k: 'A', label: { de: 'Fehler finden', en: 'Find defects', tr: 'Hata bulmak' }, c: false },
  { k: 'B', label: { de: 'Qualität bewerten', en: 'Assess quality', tr: 'Kaliteyi değerlendirmek' }, c: false },
  { k: 'C', label: { de: 'Anforderungen validieren', en: 'Validate requirements', tr: 'Gereksinimleri doğrulamak' }, c: false },
  { k: 'D', label: { de: 'Alle oben genannten', en: 'All of the above', tr: 'Yukarıdakilerin tümü' }, c: true },
];

/** Feedback strings for the quiz, passed into the client script below. */
const quizFeedback = {
  de: {
    correct: 'Richtig! Alle drei Ziele gehören zum Softwaretesten.',
    wrong: 'Nicht ganz – richtig ist D: Alle oben genannten.',
  },
  en: {
    correct: 'Correct! All three goals are part of software testing.',
    wrong: 'Not quite – the answer is D: all of the above.',
  },
  tr: {
    correct: 'Doğru! Her üç amaç da yazılım testinin parçasıdır.',
    wrong: 'Tam değil – doğru yanıt D: Yukarıdakilerin tümü.',
  },
}[lang];

// Lead-capture popup copy (opened from the "Erfahren Sie mehr" CTA).
const modal = {
  de: {
    title: 'Erfahren Sie mehr über die Auswahl von IT-Testern',
    subtitle: 'Senden Sie uns eine unverbindliche Anfrage. Wir melden uns über den von Ihnen angegebenen Kontaktweg.',
    name: 'Ihr Name',
    phone: 'Telefon',
    email: 'E-Mail',
    comment: 'Kommentare/Link zur Datei',
    consentPre: 'Hiermit bestätige ich, dass ich die ',
    consentLink: 'Datenschutzerklärung',
    consentPost: ' gelesen habe.',
    submit: 'Anfrage senden',
    close: 'Schließen',
  },
  en: {
    title: 'Learn more about selecting IT testers',
    subtitle: 'Send us a non-binding inquiry. We will reply using the contact channel you provide.',
    name: 'Your name',
    phone: 'Phone',
    email: 'Email',
    comment: 'Comments/link to file',
    consentPre: 'I hereby confirm that I have read the ',
    consentLink: 'privacy policy',
    consentPost: '.',
    submit: 'Send request',
    close: 'Close',
  },
  tr: {
    title: 'BT test uzmanlarının seçimi hakkında daha fazla bilgi edinin',
    subtitle: 'Bize bağlayıcı olmayan bir talep gönderin. Belirttiğiniz iletişim kanalı üzerinden size dönüş yapacağız.',
    name: 'Adınız',
    phone: 'Telefon',
    email: 'E-posta',
    comment: 'Yorumlar / dosya bağlantısı',
    consentPre: 'İşbu formu göndererek ',
    consentLink: 'gizlilik politikasını',
    consentPost: ' okuduğumu onaylıyorum.',
    submit: 'Talebi gönder',
    close: 'Kapat',
  },
}[lang];

---

<!-- ============ HERO ============ -->
<section class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__visual" data-reveal="zoom" data-reveal-delay="150">
    <img
      src="/images/hero-block-back.png"
      alt=""
      width="900"
      height="900"
      class="hero__img hero__img--back"
      loading="eager"
      aria-hidden="true"
    />
    <img
      src="/images/hero-block-front.png"
      alt=""
      width="900"
      height="900"
      fetchpriority="high"
      class="hero__img hero__img--front"
    />
  </div>
  <div class="hero__inner">
    <div class="hero__content">
      <h1 class="hero__title" data-reveal="up">{home.hero.title}</h1>
      <p class="hero__tagline" data-reveal="up" data-reveal-delay="100">
        {home.hero.tagline[lang]}
      </p>
      <ul class="hero__stats" data-reveal="up" data-reveal-delay="200">
        {
          home.hero.stats.map((s) => (
            <li class="hero__stat">
              <span class="hero__stat-value">{s.value}</span>
              <span class="hero__stat-label">{s.label[lang]}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<!-- ============ GOAL ============ -->
<section class="section goal">
  <div class="container goal__inner">
    <figure class="goal__media" data-reveal="left">
      <img src="/images/goal-ceo.png" alt={ceoCaption} width="560" height="640" loading="lazy" />
      <figcaption>{ceoCaption}</figcaption>
    </figure>
    <div class="goal__text" data-reveal="right">
      <span class="eyebrow">{home.goal.signoff[lang].split(',')[0]}</span>
      <h2>{home.goal.heading[lang]}</h2>
      <p class="goal__lead">{home.goal.text[lang]}</p>
      <h3 class="goal__highlight">{home.goal.highlightTitle[lang]}</h3>
      <p class="text-muted">{home.goal.highlightText[lang]}</p>
      <p class="goal__signoff">{home.goal.signoff[lang]}</p>
      <div class="goal__badges">
        <img src="/images/badge-ki-siegel.png" alt="KI-Siegel WAMOCON" width="120" height="120" loading="lazy" />
        <img class="goal__badge--zukunft" src="/images/badge-zukunft.webp" alt="Unternehmen der Zukunft, nominiert" width="135" height="120" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<!-- ============ SERVICES ============ -->
<section class="section services">
  <div class="services__wave" aria-hidden="true">
    <img src="/images/red-wave-1.svg" alt="" loading="lazy" />
  </div>
  <div class="container">
    <div class="section-head" data-reveal="up">
      <h2>{home.services.heading[lang]}</h2>
      <p class="text-muted">{home.services.intro[lang]}</p>
    </div>
    <div class="services__grid">
      {
        home.services.items.map((item, i) => (
          <article class="service-card" data-reveal="up" data-reveal-delay={(i % 3) * 80}>
            <span class="service-card__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title[lang]}</h3>
            <p class="text-muted">{item.text[lang]}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- ============ QUALITY ASSURANCE ============ -->
<section class="section qa">
  <div class="container qa__inner">
    <div class="qa__text" data-reveal="left">
      <h2>{home.qa.heading[lang]}</h2>
      <p class="text-muted">{home.qa.text[lang]}</p>
      <h3 class="qa__list-title">{home.qa.listTitle[lang]}</h3>
      <ul class="qa__list">
        {home.qa.list[lang].map((li) => <li>{li}</li>)}
      </ul>
      <p class="text-muted">{home.qa.closing[lang]}</p>
      <Button variant="primary" data-modal-open="it-tester">{home.qa.cta[lang]}</Button>
    </div>
    <div class="qa__video" data-reveal="right">
      <div class="video-frame">
        <ExternalEmbed
          service="youtube"
          src={`https://www.youtube-nocookie.com/embed/${home.qa.youtubeId}`}
          title="WAMOCON"
          lang={lang}
          externalUrl={`https://www.youtube.com/watch?v=${home.qa.youtubeId}`}
        />
      </div>
    </div>
  </div>
</section>

<!-- ============ LEAD CAPTURE MODAL ============ -->
<div class="lead-modal" id="it-tester" data-modal aria-hidden="true">
  <div class="lead-modal__overlay" data-modal-close></div>
  <div class="lead-modal__panel" role="dialog" aria-modal="true" aria-labelledby="it-tester-title">
    <button type="button" class="lead-modal__close" data-modal-close aria-label={modal.close}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
    <h2 class="lead-modal__title" id="it-tester-title">{modal.title}</h2>
    <p class="lead-modal__subtitle">{modal.subtitle}</p>
    <form class="lead-modal__form js-lead-form" data-redirect={page.thankYou}>
      <input type="hidden" name="type" value="it-tester" />
      <input type="hidden" name="lang" value={lang} />
      <label class="lead-modal__field">
        <span>{modal.name}</span>
        <input type="text" name="name" autocomplete="name" required />
      </label>
      <label class="lead-modal__field">
        <span>{modal.phone}</span>
        <input type="tel" name="phone" autocomplete="tel" inputmode="tel" />
      </label>
      <label class="lead-modal__field">
        <span>{modal.email}</span>
        <input type="email" name="email" autocomplete="email" />
      </label>
      <label class="lead-modal__field">
        <span>{modal.comment}</span>
        <textarea name="comment" rows="3"></textarea>
      </label>
      <p class="lead-modal__privacy-note">
        {modal.consentPre}<a href={privacyHref}>{modal.consentLink}</a>{modal.consentPost}
        {page.contactHint}
      </p>
      <p class="form-responsible">{page.responsible}</p>
      <button type="submit" class="btn btn--primary lead-modal__submit">{modal.submit}</button>
    </form>
  </div>
</div>


<!-- ============ 360° BOOSTER TEASER ============ -->
<section class="section booster-teaser">
  <div class="container booster-teaser__inner" data-reveal="up">
    <div class="booster-teaser__copy">
      <span class="booster-teaser__badge">360°</span>
      <h2>{page.boosterTitle}</h2>
      <p class="text-muted">{page.boosterText}</p>
      <Button href={systemHref} variant="primary" size="lg">{page.boosterCta}</Button>
    </div>
    <figure class="booster-teaser__media">
      <img src="/images/system-360.svg" alt={page.boosterAlt} loading="lazy" />
    </figure>
  </div>
</section>

<!-- ============ WHY WAMOCON ============ -->
<section class="section why">
  <div class="container">
    <div class="section-head" data-reveal="up">
      <h2>{home.why.heading[lang]}</h2>
      <p class="text-muted">{home.why.intro[lang]}</p>
    </div>
    <div class="why__grid">
      {
        home.why.points.map((p, i) => (
          <article class="why-card" data-reveal="up" data-reveal-delay={(i % 4) * 70}>
            <img class="card-media" src={p.image} alt={p.alt[lang]} width="900" height="600" loading="lazy" decoding="async" />
            <div class="card-body">
              <span class="why-card__num">{p.num}</span>
              <p>{p.text[lang]}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- ============ ABOUT ============ -->
<section class="section about">
  <div class="container about__inner">
    <div class="about__grid" data-reveal="up">
      <div class="about__cols">
        <h2 class="about__heading">
          <span class="about__heading-accent">{aboutHeading.first}</span>{aboutHeading.rest}
        </h2>
        {home.about.paragraphs[lang].map((p) => <p class="text-muted">{p}</p>)}
        <div class="about__actions">
          <Button href={aboutHref} variant="primary">{page.aboutCta}</Button>
          <a class="about__magazin" href={magazinUrl} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 19h16" stroke-linecap="round" stroke-linejoin="round" /></svg>
            {page.magazine}
          </a>
        </div>
      </div>
      <figure class="about__media">
        <img
          src="/images/about-skyline.jpg"
          alt="Frankfurt Skyline"
          width="720"
          height="540"
          loading="lazy"
        />
      </figure>
    </div>
  </div>
</section>

<!-- ============ BENEFITS ============ -->
<section class="section benefits">
  <div class="container">
    <div class="section-head" data-reveal="up">
      <h2><span class="accent">{benefitsHeading.first}</span>{benefitsHeading.rest}</h2>
    </div>
    <div class="benefits__grid">
      {
        home.benefits.items.map((b, i) => (
          <article class="benefit-card" data-reveal="up" data-reveal-delay={(i % 3) * 80}>
            <img class="card-media" src={b.image} alt={b.alt[lang]} width="900" height="600" loading="lazy" decoding="async" />
            <div class="card-body">
              <h3>{b.title[lang]}</h3>
              <p class="text-muted">{b.text[lang]}</p>
            </div>
          </article>
        ))
      }
    </div>
    <div class="benefits__cta" data-reveal="up">
      <Button href={aboutHref} variant="primary" size="lg">{home.benefits.cta[lang]}</Button>
    </div>
  </div>
</section>

<!-- ============ PROJECTS ============ -->
<section class="section projects">
  <div class="container">
    <div class="section-head" data-reveal="up">
      <h2>{projectsHeading.head}<span class="accent"> {projectsHeading.last.trim()}</span></h2>
    </div>
    <div class="projects__grid">
      {
        home.projects.items.map((p, i) => (
          <article class="project-card" data-reveal="up" data-reveal-delay={i * 90}>
            <span class="project-card__index">0{i + 1}</span>
            <h3>{p.title[lang]}</h3>
            <p class="project-card__client">{p.client}</p>
            <button type="button" class="project-card__btn" data-modal-open={`project-${i}`}>
              {home.projects.cta[lang]}
            </button>
          </article>
        ))
      }
    </div>
    <div class="projects__cta" data-reveal="up">
      <a class="projects__link" href={reviewsHref}>
        {page.reviewsLink} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<!-- ============ PROJECT MODALS ============ -->
{
  home.projects.items.map((p, i) => (
    <div class="lead-modal project-modal" id={`project-${i}`} data-modal aria-hidden="true">
      <div class="lead-modal__overlay" data-modal-close />
      <div class="lead-modal__panel project-modal__panel" role="dialog" aria-modal="true" aria-labelledby={`project-${i}-title`}>
        <button type="button" class="lead-modal__close" data-modal-close aria-label={modal.close}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
        <h2 class="project-modal__title" id={`project-${i}-title`}>{p.popupTitle[lang]}</h2>
        <h3 class="project-modal__label">{projectCompanyLabel}</h3>
        <p class="project-modal__text">{p.company[lang]}</p>
        <h3 class="project-modal__label">{projectProjectLabel}</h3>
        <p class="project-modal__text">{p.project[lang]}</p>
      </div>
    </div>
  ))
}

<!-- ============ CLIENTS ============ -->
<section class="section clients">
  <div class="container">
    <div class="section-head" data-reveal="up">
      <h2>{home.clients.heading[lang]}</h2>
    </div>
  </div>
  <!-- Two rows of client names that drift in opposite directions. -->
  <div class="clients__marquee" data-reveal="up" aria-label={home.clients.heading[lang]}>
    <div class="clients__track">
      {[...home.clients.list, ...home.clients.list].map((c) => <span class="clients__chip">{c}</span>)}
    </div>
    <div class="clients__track clients__track--reverse" aria-hidden="true">
      {[...home.clients.list, ...home.clients.list].map((c) => <span class="clients__chip">{c}</span>)}
    </div>
  </div>
  <div class="container">
    <div class="clients__cta" data-reveal="up">
      <a class="projects__link" href={referencesHref}>
        {page.referencesLink} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<!-- ============ EDUCATION CENTER ============ -->
<section class="section education">
  <div class="container education__inner">
    <div class="education__text" data-reveal="left">
      <h2>{home.education.heading[lang]}</h2>
      {home.education.paragraphs[lang].map((p) => <p class="text-muted">{p}</p>)}
    </div>
