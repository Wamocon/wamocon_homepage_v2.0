<script define:vars={{ quizFeedback }}>
  // @ts-nocheck
  document.querySelectorAll('[data-dq]').forEach((quiz) => {
    const options = quiz.querySelectorAll('[data-dq-option]');
    const feedback = quiz.querySelector('[data-dq-feedback]');
    options.forEach((option) => {
      option.addEventListener('click', () => {
        if (quiz.dataset.answered) return;
        quiz.dataset.answered = '1';
        const correct = option.getAttribute('data-correct') === 'true';
        option.classList.add(correct ? 'is-correct' : 'is-wrong');
        options.forEach((o) => {
          if (o.getAttribute('data-correct') === 'true') o.classList.add('is-correct');
          o.disabled = true;
        });
        if (feedback) {
          feedback.hidden = false;
          feedback.textContent = correct ? quizFeedback.correct : quizFeedback.wrong;
          feedback.classList.add(correct ? 'is-correct' : 'is-wrong');
        }
      });
    });
  });
</script>

