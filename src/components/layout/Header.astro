---
/**
 * Site header: logo, primary navigation, language switcher and mobile menu.
 * Fully driven by src/i18n/config.ts — edit nav there, it updates everywhere.
 */
import { nav, ui, type Lang } from '../../i18n/config';
import { getAlternateLangUrl } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const currentPath = Astro.url.pathname;
const homeHref = lang === 'de' ? '/' : '/en/';
const altHref = getAlternateLangUrl(currentPath, lang);

const normalizePath = (p: string) => (p.endsWith('/') ? p : p + '/');
const isActive = (href: string) => normalizePath(currentPath) === normalizePath(href);
// A dropdown parent is active when the current page is one of its children.
const isGroupActive = (item: (typeof nav)[number]) =>
  isActive(item[lang].href) || (item.children?.some((c) => isActive(c[lang].href)) ?? false);

// Language options for the switcher dropdown. The active language links to the
// current page (a no-op); the other links to its translated equivalent.
const languages = [
  { code: 'de', label: 'Deutsch', short: 'DE', href: lang === 'de' ? currentPath : altHref },
  { code: 'en', label: 'English', short: 'EN', href: lang === 'en' ? currentPath : altHref },
] as const;
---

<header class="header" id="site-header">
  <div class="header__inner container">
    <a class="header__logo" href={homeHref} aria-label="WAMOCON">
      <img src="/images/logo-wamocon.png" alt="WAMOCON" width="150" height="150" />
    </a>

    <nav class="header__nav" aria-label="Hauptnavigation" id="primary-nav">
      <ul class="header__list">
        {
          nav.map((item) => (
            <li class:list={['header__item', { 'has-children': item.children?.length }]}>
              <a
                href={item[lang].href}
                class:list={['header__link', { 'is-active': isGroupActive(item) }]}
                aria-current={isActive(item[lang].href) ? 'page' : undefined}
              >
                {item[lang].label}
                {item.children?.length ? <span class="header__caret" aria-hidden="true"></span> : null}
              </a>
              {item.children?.length ? (
                <ul class="header__submenu">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child[lang].href}
                        class:list={['header__sublink', { 'is-active': isActive(child[lang].href) }]}
                        aria-current={isActive(child[lang].href) ? 'page' : undefined}
                      >
                        {child[lang].label}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : null}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <div class="lang-switch" data-lang-switch>
        <button
          type="button"
          class="lang-switch__button"
          id="lang-switch-button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label={ui[lang]['lang.label']}
        >
          <svg class="lang-switch__globe" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3c2.5 2.5 2.5 15 0 18M12 3c-2.5 2.5-2.5 15 0 18" />
          </svg>
          <span class="lang-switch__current">{lang.toUpperCase()}</span>
          <svg class="lang-switch__caret" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <ul class="lang-switch__menu" role="menu" aria-labelledby="lang-switch-button">
          {languages.map((l) => (
            <li role="none">
              <a
                role="menuitem"
                href={l.href}
                hreflang={l.code}
                lang={l.code}
                class:list={['lang-switch__option', { 'is-active': l.code === lang }]}
                aria-current={l.code === lang ? 'true' : undefined}
              >
                <span>{l.label}</span>
                {l.code === lang && (
                  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 8.5l3 3 7-7.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <button
        class="header__burger"
        type="button"
        aria-label={ui[lang]['nav.menu']}
        aria-expanded="false"
        aria-controls="primary-nav"
        id="nav-toggle"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    --header-height: 112px;
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgba(16, 16, 16, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      background var(--dur-med) var(--ease-out),
      border-color var(--dur-med) var(--ease-out);
  }
  .header.is-scrolled {
    background: rgba(16, 16, 16, 0.92);
    border-bottom-color: var(--border-subtle);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 112px;
    max-width: var(--header-max);
  }

  .header__logo img {
    height: 100px;
    width: auto;
    object-fit: contain;
  }

  .header__nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .header__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(0.6rem, 1.1vw, 1.35rem);
  }

  .header__link {
    position: relative;
    font-size: clamp(0.82rem, 0.95vw, 0.95rem);
    font-weight: var(--fw-regular);
    color: var(--color-text);
    padding-block: 0.35rem;
    white-space: nowrap;
  }
  .header__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--color-accent-surface);
    transition: width var(--dur-fast) var(--ease-out);
  }
  .header__link:hover,
  .header__link.is-active {
    color: var(--color-accent);
  }
  .header__link.is-active::after,
  .header__link:hover::after {
    width: 100%;
  }

  /* ---- dropdown groups ---- */
  .header__item { position: relative; }
  .header__link { display: inline-flex; align-items: center; gap: 0.3rem; }
  .header__caret {
    width: 6px; height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-1px);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .header__submenu {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    min-width: 220px;
    padding: 0.4rem;
    list-style: none;
    background: rgba(20, 20, 20, 0.98);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out), visibility var(--dur-fast);
    z-index: 5;
  }
  .header__item:hover > .header__submenu,
  .header__item:focus-within > .header__submenu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .header__item:hover > .header__link .header__caret { transform: rotate(225deg) translateY(-1px); }
  .header__sublink {
    display: block;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: 0.92rem;
    white-space: nowrap;
  }
  .header__sublink:hover,
  .header__sublink.is-active { color: var(--color-accent); background: rgba(255, 255, 255, 0.06); }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  /* ---- language switcher (shows the active language + dropdown) ---- */
  .lang-switch {
    position: relative;
  }
  .lang-switch__button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    font-weight: var(--fw-semibold);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    cursor: pointer;
  }
  .lang-switch__button:hover,
  .lang-switch__button[aria-expanded='true'] {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .lang-switch__globe { flex: 0 0 auto; }
  .lang-switch__caret { transition: transform var(--dur-fast) var(--ease-out); }
  .lang-switch__button[aria-expanded='true'] .lang-switch__caret { transform: rotate(180deg); }
  .lang-switch__menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 168px;
    padding: 0.35rem;
    background: rgba(20, 20, 20, 0.98);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out), visibility var(--dur-fast);
  }
  .lang-switch.is-open .lang-switch__menu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .lang-switch__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  .lang-switch__option:hover { background: rgba(255, 255, 255, 0.06); color: var(--color-text); }
  .lang-switch__option.is-active { color: var(--color-accent); font-weight: var(--fw-semibold); }

  .header__burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
  }
  .header__burger span {
    display: block;
    width: 26px;
    height: 2px;
    background: var(--color-text);
    transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast);
  }

  /* ---- Mobile ---- */
  @media (max-width: 1080px) {
    .header {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .header__burger {
      display: flex;
    }
    .header__nav {
      position: fixed;
      top: var(--header-height);
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(16, 16, 16, 0.98);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border-bottom: none;
      overflow: hidden;
      visibility: hidden;
      transform: translateY(-100%);
      transition:
        transform var(--dur-med) var(--ease-out),
        visibility var(--dur-med);
    }
    .header__nav.is-open {
      visibility: visible;
      transform: translateY(0);
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }
    .header__list {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 0;
      padding: var(--space-sm) var(--container-pad) var(--space-md);
    }
    .header__list li {
      width: 100%;
      border-bottom: 1px solid var(--border-subtle);
    }
    .header__link {
      display: block;
      padding: 1rem 0;
      font-size: 1.1rem;
    }
    /* Submenus expand inline (indented) instead of hovering on mobile. */
    .header__item .header__caret { display: none; }
    .header__submenu {
      position: static;
      min-width: 0;
      padding: 0 0 0.75rem 1rem;
      margin: 0;
      border: 0;
      background: transparent;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .header__submenu li { border-bottom: 0; }
    .header__sublink { padding: 0.6rem 0; font-size: 1rem; }
    body.nav-open {
      overflow: hidden;
    }
    .header__burger[aria-expanded='true'] span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .header__burger[aria-expanded='true'] span:nth-child(2) {
      opacity: 0;
    }
    .header__burger[aria-expanded='true'] span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

<script>
  // Mobile menu toggle + sticky header shadow on scroll.
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const navEl = document.getElementById('primary-nav');

  function updateHeaderHeight() {
    if (header) {
      document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
    }
  }
  updateHeaderHeight();
  window.addEventListener('resize', updateHeaderHeight);

  toggle?.addEventListener('click', () => {
    const open = navEl?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('nav-open', open);
  });

  // Close menu when a link is clicked.
  navEl?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      navEl.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('nav-open');
    });
  });

  const onScroll = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 20);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Language dropdown: toggle on click, close on outside click / Escape.
  const langSwitch = document.querySelector('[data-lang-switch]');
  const langButton = document.getElementById('lang-switch-button');
  const closeLang = () => {
    langSwitch?.classList.remove('is-open');
    langButton?.setAttribute('aria-expanded', 'false');
  };
  langButton?.addEventListener('click', (event) => {
    event.stopPropagation();
    const open = langSwitch?.classList.toggle('is-open');
    langButton.setAttribute('aria-expanded', String(Boolean(open)));
  });
  document.addEventListener('click', (event) => {
    if (langSwitch && !langSwitch.contains(event.target as Node)) closeLang();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeLang();
  });
</script>
