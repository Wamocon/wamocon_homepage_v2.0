---
/**
 * Site footer — mirrors the official wamocon.com footer:
 * logo + copyright on the left, two columns of page links, and a legal column.
 * All links come from src/i18n/config.ts.
 */
import { nav, legalNav, ui, company, type Lang, type NavLink } from '../../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = (k: keyof (typeof ui)['de']) => ui[lang][k];
const year = new Date().getFullYear();

// Flatten nav (dropdown groups + children) so footer keys resolve either way.
const flat: NavLink[] = nav.flatMap((n) => (n.children ? n.children : [n]));
const linkFor = (key: string) => flat.find((n) => n.key === key)![lang];

// Two link columns + a legal column, exactly like the official footer.
const col1 = ['home', 'system', 'apps', 'cooperation', 'testimonials', 'references'].map(linkFor);
const col2 = ['career', 'about', 'employees', 'azubi', 'webdesign'].map(linkFor);
const legal = [legalNav.privacy[lang], legalNav.imprint[lang], legalNav.accessibility[lang]];
const privacySettings = {
  de: 'Cookie-Einstellungen',
  en: 'Cookie settings',
  tr: 'Çerez ayarları',
}[lang];

// Art. 50 EU AI Act transparency notice. Must be shown in the language of the
// page — a German-only notice does not inform a visitor reading another edition.
const aiNotice = {
  de: 'Einzelne grafische Elemente dieser Website (abstrakte Illustrationen und 3D-Renderings) wurden mit Hilfe Künstlicher Intelligenz erstellt. Alle Fotografien von Personen, Räumen und Veranstaltungen sind echte Aufnahmen und nicht KI-generiert. Sämtliche Texte werden redaktionell von einem Menschen geprüft und verantwortet.',
  en: 'Some graphical elements on this website (abstract illustrations and 3D renderings) were created with the help of artificial intelligence. All photographs of people, places and events are genuine and not AI-generated. All texts are editorially reviewed and approved by a human.',
  tr: 'Bu web sitesindeki bazı grafik öğeler (soyut illüstrasyonlar ve 3D görseller) yapay zekâ yardımıyla oluşturulmuştur. Kişilere, mekânlara ve etkinliklere ait tüm fotoğraflar gerçek çekimlerdir ve yapay zekâ ile üretilmemiştir. Tüm metinler bir insan tarafından editoryal olarak kontrol edilir ve sorumluluğu üstlenilir.',
}[lang];
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__brand">
      <img
        src="/images/logo-wamocon.png"
        alt="WAMOCON"
        width="170"
        height="68"
        class="footer__logo"
      />
      <p class="footer__copy">
        Copyright © {year} {company.name}.<br />{t('footer.rights')}
      </p>
      <button class="footer__privacy" type="button" data-open-consent-settings>
        {privacySettings}
      </button>
    </div>

    <nav class="footer__links" aria-label={t('footer.navigation')}>
      <ul>
        {col1.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <ul>
        {col2.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <ul>
        {legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <p class="footer__ai-notice container">{aiNotice}</p>
</footer>

<style>
  .footer {
    background: var(--color-bg);
    border-top: 1px solid var(--border-subtle);
    margin-top: var(--section-gap);
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(3.5rem, 7vw, 6rem);
    align-items: start;
  }
  .footer__logo {
    height: 104px;
    width: auto;
    margin-bottom: 2.5rem;
  }
  .footer__copy {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text);
  }
  .footer__privacy {
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .footer__privacy:hover {
    color: var(--color-accent);
  }
  .footer__links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .footer__links ul {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .footer__links a {
    font-size: clamp(1.05rem, 1.4vw, 1.35rem);
    font-weight: var(--fw-regular);
    color: var(--color-text);
  }
  .footer__links a:hover {
    color: var(--color-accent);
  }
  .footer__ai-notice {
    margin: 0;
    padding-bottom: clamp(2rem, 4vw, 3rem);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    line-height: 1.55;
    max-width: 940px;
  }

  @media (max-width: 860px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
  @media (max-width: 560px) {
    .footer__links {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

